module std.text

// What every program that reads text writes for itself. Nothing here is a
// builtin: it is all written in the language, out of `len`, `find`, `slice`
// and the bytes.

// The number a piece of text spells, or nothing when it spells something else.
// Reads nothing but bytes, so it allocates nothing.
fn number(digits: text) -> i32? no.alloc {
    if len(digits) == 0 {
        return none
    }
    let negative = digits[0] == 45
    let i = 0
    if negative {
        i = 1
    }
    if i == len(digits) {
        return none
    }

    let value = 0
    while i < len(digits) {
        let byte = digits[i]
        if byte < 48 || byte > 57 {
            return none
        }
        value = value * 10 + i32(byte) - 48
        i += 1
    }
    if negative {
        return 0 - value
    }
    return value
}

fn contains(subject: text, needle: text) -> bool no.alloc {
    if let at = find(subject, needle) {
        return true
    }
    return false
}

fn starts(subject: text, prefix: text) -> bool no.alloc {
    if len(prefix) > len(subject) {
        return false
    }
    for i in 0..len(prefix) {
        if subject[i] != prefix[i] {
            return false
        }
    }
    return true
}

fn ends(subject: text, suffix: text) -> bool no.alloc {
    if len(suffix) > len(subject) {
        return false
    }
    let offset = len(subject) - len(suffix)
    for i in 0..len(suffix) {
        if subject[offset + i] != suffix[i] {
            return false
        }
    }
    return true
}

fn isSpace(byte: u8) -> bool no.alloc {
    return byte == 32 || byte == 9 || byte == 10 || byte == 13
}

// Without the spaces at either end. Cuts, so it reaches the heap.
fn trim(subject: text) -> text {
    let from = 0
    while from < len(subject) && isSpace(subject[from]) {
        from += 1
    }
    let to = len(subject)
    while to > from && isSpace(subject[to - 1]) {
        to -= 1
    }
    return slice(subject, from, to - from)
}

// The pieces between each separator. An empty subject has no pieces; a
// subject with no separator in it is one piece.
fn split(subject: text, separator: text) -> [text] {
    let pieces: [text] = array()
    if len(separator) == 0 {
        push(pieces, subject)
        return pieces
    }

    let rest = subject
    while len(rest) > 0 {
        if let at = find(rest, separator) {
            push(pieces, slice(rest, 0, at))
            rest = slice(
                rest,
                at + len(separator),
                len(rest) - at - len(separator)
            )
        } else {
            push(pieces, rest)
            rest = ""
        }
    }
    return pieces
}

// Text is its bytes, so a run of bytes is what it is built from. Gathering
// them costs nothing and `text(bytes)` pays for the copy once, which is what
// a loop that builds a string a piece at a time needs.
fn bytes(subject: text) -> [u8] {
    let out: [u8] = array()
    append(out, subject)
    return out
}

fn append(out: [u8], piece: text) {
    for i in 0..len(piece) {
        push(out, piece[i])
    }
}

// The pieces with the separator between them, which is what `split` undoes.
fn join(pieces: [text], separator: text) -> text {
    let out: [u8] = array()
    for i in 0..len(pieces) {
        if i > 0 {
            append(out, separator)
        }
        append(out, pieces[i])
    }
    return text(out)
}

fn repeat(subject: text, times: i32) -> text {
    let out: [u8] = array()
    for i in 0..times {
        append(out, subject)
    }
    return text(out)
}

// ASCII only, and deliberately: a byte is a byte, and what an upper case `ı`
// is depends on a language rather than on a table this could carry.
fn upper(subject: text) -> text {
    let out = bytes(subject)
    for i in 0..len(out) {
        out[i] = if out[i] >= 97 && out[i] <= 122 -> out[i] - 32 else -> out[i]
    }
    return text(out)
}

fn lower(subject: text) -> text {
    let out = bytes(subject)
    for i in 0..len(out) {
        out[i] = if out[i] >= 65 && out[i] <= 90 -> out[i] + 32 else -> out[i]
    }
    return text(out)
}
