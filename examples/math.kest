module examples.math

// The first program anybody writes, which is where the shapes a language is
// made of are easiest to see: a loop that carries a number, a loop that
// carries two, and a chain of `if` that answers with a piece of text. Nothing
// here is about the library or the boundary — it is what a function, a
// `while` and an `else if` do.

import std.io

fn factorial(n: i32) -> i32 {
    let result = 1
    let i = 2
    while i <= n {
        result *= i
        i += 1
    }
    return result
}

fn gcd(a: i32, b: i32) -> i32 {
    let x = a
    let y = b
    while y != 0 {
        let t = y
        y = x % y
        x = t
    }
    return x
}

fn classify(n: i32) -> text {
    if n < 0 {
        return "negative"
    } else if n == 0 {
        return "zero"
    }
    return "positive"
}

fn main() -> i32 {
    if factorial(5) != 120 {
        return 1
    }
    // Nought of them multiplied together is one, which is the answer the loop
    // gives by not running.
    if factorial(0) != 1 {
        return 2
    }
    if gcd(120, 84) != 12 {
        return 3
    }
    if gcd(17, 5) != 1 {
        return 4
    }
    // A number with itself and a number with nought are the two ends the
    // loop has to get right, and the second is the one that ends it.
    if gcd(9, 9) != 9 || gcd(9, 0) != 9 {
        return 5
    }
    if classify(gcd(factorial(5), 84)) != "positive" {
        return 6
    }
    if classify(0) != "zero" || classify(-3) != "negative" {
        return 7
    }

    let shared = gcd(factorial(5), 84)
    io.print("120 and 84 share {shared}, which is {classify(shared)}")
    return 0
}
