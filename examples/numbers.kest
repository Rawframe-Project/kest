module examples.numbers

import std.io

// What a number does at the end of its range, which is where a simulation
// lives: a count that runs over, a narrowing that keeps what it has room for,
// a divide by nought. Everything here is D018's rule — match C where C has an
// answer, and answer where it has none — and every line of it is a rule the
// reference states, run.

// Worked out where it is written, with the same arithmetic that runs: `120 +
// 10` in an `i8` is -126 before the program starts.
const NARROW: i8 = 120 + 10

fn main() -> i32 {
    // One past the top of each width is the bottom of it.
    let byte: i8 = 127
    let count: u8 = 255
    let short: i16 = 32767
    let big: i32 = 2147483647
    if byte + 1 != -128 || count + 1 != 0 {
        return 1
    }
    if short + 1 != -32768 || big + 1 != -2147483648 {
        return 2
    }
    // And one below the bottom is the top, which is the same rule read the
    // other way.
    let least: i8 = -128
    if least - 1 != 127 {
        return 3
    }
    // Narrowing keeps the bits it has room for, and a constant is worked out
    // where it is written with the same arithmetic: `120 + 10` in an `i8` is
    // -126 before the program runs.
    if i8(300) != 44 || u8(300) != 44 || i16(70000) != 4464 {
        return 4
    }
    if NARROW != -126 {
        return 5
    }
    // A division truncates towards nought and a remainder keeps the sign of
    // what was divided, which is what C says and what a program written
    // against C expects.
    let owed = -7
    if owed / 3 != -2 || owed % 3 != -1 {
        return 6
    }

    // A float going the other way is truncated towards nought and stops at the
    // end of the range rather than wrapping, which is the one place these two
    // rules differ. Nothing that is not a number has an order, so it lands on
    // nought.
    let vast: f64 = 1000000000000000000000.0
    if i32(vast) != 2147483647 || i32(-vast) != -2147483648 {
        return 7
    }
    if u8(300.0) != 255 || u8(-5.0) != 0 {
        return 8
    }
    let nothing: f64 = 0.0
    if i32(nothing / nothing) != 0 {
        return 9
    }
    if i32(1.0 / nothing) != 2147483647 {
        return 10
    }

    // Dividing by nought is two different things. A whole number has no
    // answer, so it is a message with a code; a float has one, and it is the
    // one C has: an infinity with a sign, or not a number when nought is
    // divided by nought.
    if !(1.0 / nothing > 0.0) {
        return 11
    }
    if !(-1.0 / nothing < 0.0) {
        return 12
    }
    // Nothing that is not a number is equal to anything, itself included,
    // which is what makes it worth having.
    let unmeasured = nothing / nothing
    if unmeasured == unmeasured || unmeasured < 0.0 || unmeasured > 0.0 {
        return 13
    }
    // And there is one spelling of it, because which sign a divide left in it
    // says something about the bits and nothing about the value.
    if "{unmeasured}" != "nan" || "{0.0 - unmeasured}" != "nan" {
        return 14
    }
    if "{1.0 / nothing}" != "inf" || "{-1.0 / nothing}" != "-inf" {
        return 15
    }

    io.print("every width wraps at its own end, and {NARROW} is one of them")
    return 0
}
