module tools.frame

import std.io

// One number, and the same number every time: how long a frame step takes per
// entity, in nanoseconds.
//
// `examples/frame.kest` has the same name and a different job: it is a file
// that is checked rather than run, and what it holds is the shapes a frame is
// declared with.
//
// This is not a benchmark suite and there is nowhere it is written down. It
// answers one question — did the thing this language exists for get slower —
// and it is run when somebody wants to know rather than on every change.
// `make check` does not touch it, because a duration is not a pass or a fail.
//
// What it measures is the shape the language is for: an array of value structs
// walked in order and handed one at a time to helpers that take one and give
// one back, inside a promise that nothing reaches the heap. Everything it does not measure — starting up,
// compiling, crossing the boundary, allocating — is deliberate. Those are
// other questions and they would each want their own number.
//
// What it is worth: the first run or two on a cold machine read about a fifth
// high, because the processor has not decided how fast it is running yet. Run
// it twice and believe the second. It will show a change of about a quarter
// and it will not show a change of a tenth, and anyone who wants that number
// wants a different instrument.

extern fn Host.clock() -> i64 no.alloc

const ENTITIES: i32 = 10000
const STEPS: i32 = 100
const ROUNDS: i32 = 7

struct Npc {
    x: f32
    y: f32
    dx: f32
    dy: f32
    health: i32
}

// The work, in two helpers that each take a value struct and give one back.
// That is the shape D006 is about and the shape `examples/physics.kest` and
// `examples/ants.kest` are written to show — a frame in this language is
// helpers called from a hot path, not one body with everything in it — and
// until D550 this measured a body with everything in it. What a helper costs is
// exactly the thing a reader of this number wants to know. See D550.
fn moved(one: Npc, dt: f32) -> Npc no.alloc {
    return Npc(
        one.x + one.dx * dt,
        one.y + one.dy * dt,
        one.dx,
        one.dy,
        one.health
    )
}

fn turned(one: Npc) -> Npc no.alloc {
    let dx = if one.x < 0.0 || one.x > 100.0 -> 0.0 - one.dx else -> one.dx
    let dy = if one.y < 0.0 || one.y > 100.0 -> 0.0 - one.dy else -> one.dy
    let health = if one.health > 0 -> one.health - 1 else -> ENTITIES
    return Npc(one.x, one.y, dx, dy, health)
}

// A frame. It reads every entity, works on it and writes it back, which is
// what a frame does and the reason `[Npc]` is bytes rather than handles.
fn step(world: [Npc], dt: f32) -> i32 no.alloc {
    let alive = 0
    for i in 0..len(world) {
        let one = turned(moved(world[i], dt))
        world[i] = one
        if one.health > 0 {
            alive += 1
        }
    }
    return alive
}

fn world(count: i32) -> [Npc] {
    let made: [Npc] = array()
    for i in 0..count {
        push(made, Npc(f32(i % 100), f32(i % 71), 1.0, 0.0 - 1.0, i % 97 + 1))
    }
    return made
}

fn main() -> i32 {
    let all = world(ENTITIES)

    // A whole round before the clock, so what is measured is the steady
    // state: not the first touch of ten thousand structs, and not a machine
    // that has not decided how fast it is running yet.
    for i in 0..STEPS {
        step(all, 0.016)
    }

    // The best of several rounds rather than the average of them. Anything
    // else sharing the machine only ever adds time, so the smallest is the
    // closest this can get to how long the work itself takes, and it is the
    // only summary that does not move when the machine is busy.
    let seen = 0
    let best: i64 = 0
    let worst: i64 = 0
    for round in 0..ROUNDS {
        let before = Host.clock()
        for i in 0..STEPS {
            seen += step(all, 0.016)
        }
        let took = Host.clock() - before
        if round == 0 || took < best {
            best = took
        }
        if took > worst {
            worst = took
        }
    }

    // The host's clock counts microseconds, and what is wanted is nanoseconds
    // for one entity in one step.
    let each = best * 1000 / i64(ENTITIES) / i64(STEPS)
    // And how far the slowest round was from it. The best is the number; this
    // is whether to believe it. A machine that is busy or that changes its
    // mind about how fast it runs says so here, and two numbers measured
    // minutes apart can be told apart from two that differ.
    let spread = (worst - best) * 100 / best
    io.print("{each} ns per entity per step, best of {ROUNDS} over {ENTITIES}, spread {spread}%")
    // And what the work adds up to, which is a number and not a duration:
    // every entity is alive in every step of every round, so this is exactly
    // `ROUNDS * STEPS * ENTITIES` and nothing else. It is here because an
    // instrument that stops doing its work still prints a number, and a
    // smaller number reads like a faster machine. See D549.
    if seen != ROUNDS * STEPS * ENTITIES {
        return 1
    }
    return 0
}
