module game.colony

import std.bytes
import std.random
import game.map
import game.path

// A colony: ground, the people on it, what the player has asked for, and what
// has been gathered. The host drives it a frame at a time, hands it the
// player's orders, and reads back what to draw into memory of its own.

// What the player has asked for on a cell.
const NOTHING: u8 = 0
const CHOP: u8 = 1
const BUILD: u8 = 2
const SOW: u8 = 3
const REAP: u8 = 4

// What is lying on a cell.
const WOOD: u8 = 1
const FOOD: u8 = 2

// How long things take, in seconds, and how fast people walk, in cells a
// second.
const PACE: f32 = 4.0
const CHOPPING: f32 = 2.0
const BUILDING: f32 = 3.0
const SOWING: f32 = 1.0
const REAPING: f32 = 1.0
const EATING: f32 = 1.5
const SLEEPING: f32 = 8.0
const RIPENING: f32 = 40.0
const RESTLESS: f32 = 1.0

// Hunger and tiredness go up by one a second. Past these a colonist drops
// what it is doing to eat or sleep, and at STARVED it dies.
const PECKISH: i32 = 60
const WEARY: i32 = 90
const STARVED: i32 = 160

enum Job {
    Idle
    // Walking to stand beside a cell, and then working on it for a while.
    Chop(i32)
    Build(i32)
    Sow(i32)
    Reap(i32)
    // Walking onto something lying on the ground, and then carrying it to
    // the stockpile.
    Fetch(i32)
    Carry
    Eat
    Sleep
}

struct Colonist {
    id: i32
    // Where it is, in cells, as a float so that walking is smooth; the cell
    // it is on is where this rounds to.
    x: f32
    y: f32
    job: Job
    // Next step last. Its own, and made once.
    route: [i32]
    // How long it has been working at what it is standing beside.
    worked: f32
    carrying: u8
    hunger: f32
    tired: f32
}

// What a colony keeps counts of. One run of numbers, because the world is
// handed round by value and a count has to outlive the copy it was made in.
const TICK: i32 = 0
const STORED_WOOD: i32 = 1
const STORED_FOOD: i32 = 2
const BORN: i32 = 3
const DIED: i32 = 4
const CLOCK: i32 = 5
const MADE: i32 = 6
// How many cells are marked for each order, and how many have each thing
// lying on them, at these plus the order or the thing. A search for what
// there is none of is a search of the whole map for nothing.
const MARKED: i32 = 7
const LYING: i32 = 12
// And how many of each of those somebody has set out for, at this plus the
// count's own place. What is free is the one less the other, and a search is
// only made for something there is some of free: with every tree near the
// camp claimed, a search for one walks the whole map to find nothing, and a
// colony of five hundred idle people did that every second.
const CLAIMS: i32 = 15
// And a search that found none of something is not made again until
// something has changed that could make it find one: what is on a cell, what
// is marked or lying there, or somebody letting a cell go. A marked tree in
// the middle of a wood cannot be stood beside until the ones round it are
// down, and five hundred people each walking the whole map every second to
// find that out again was most of a frame. `CHANGED` counts the changes, and
// at `FRUITLESS` plus a count's place is the change a search for it last
// found nothing at, one more than it so that nought is never.
const FRUITLESS: i32 = 30
const CHANGED: i32 = 45
const COUNTS: i32 = 46

// The ground and what is on it, cell by cell, all in step with `ground.tiles`:
// what the player marked, what is lying there, how ripe a field is, and
// whether somebody has already set out for it.
struct World {
    ground: map.Ground
    marks: [u8]
    items: [u8]
    ripe: [f32]
    claimed: [u8]
    people: store<Colonist>
    search: path.Search
    counts: [i32]
    seconds: [f32]
}

fn begin(seed: i64, wide: i32, high: i32, many: i32) -> World {
    let ground = map.made(u64(seed), wide, high)
    let cells = wide * high
    let w = World(
        ground,
        array(cells, NOTHING),
        array(cells, NOTHING),
        array(cells, 0.0),
        array(cells, NOTHING),
        store(many * 2),
        path.over(ground),
        array(COUNTS, 0),
        array(2, 0.0)
    )
    for i in 0..many {
        arrive(w, f32(wide / 2 - 2 + i % 5), f32(high / 2 - 2 + i / 5 % 5))
    }
    // Something to start on: a little of each in the stockpile.
    w.counts[STORED_FOOD] = many * 2
    w.counts[STORED_WOOD] = 4
    return w
}

fn arrive(w: World, x: f32, y: f32) -> ref<Colonist> {
    w.counts[MADE] += 1
    w.counts[BORN] += 1
    return add(
        w.people,
        Colonist(
            w.counts[MADE],
            x,
            y,
            Job.Idle,
            array(),
            0.0,
            NOTHING,
            0.0,
            0.0
        )
    )
}

fn at(w: World, one: Colonist) -> i32 no.alloc no.host deterministic {
    return map.cell(w.ground, i32(one.x + 0.5), i32(one.y + 0.5))
}

// Every change to what is marked or lying on a cell goes through these two,
// so that the counts above are the cells rather than a guess at them.
fn mark(w: World, c: i32, what: u8) no.alloc no.host deterministic {
    let was = w.marks[c]
    if was != NOTHING {
        w.counts[MARKED + i32(was)] -= 1
    }
    if what != NOTHING {
        w.counts[MARKED + i32(what)] += 1
    }
    w.marks[c] = what
    w.counts[CHANGED] += 1
}

fn lay(w: World, c: i32, what: u8) no.alloc no.host deterministic {
    let was = w.items[c]
    if was != NOTHING {
        w.counts[LYING + i32(was)] -= 1
    }
    if what != NOTHING {
        w.counts[LYING + i32(what)] += 1
    }
    w.items[c] = what
    w.counts[CHANGED] += 1
}

fn build(w: World, c: i32, tile: u8) no.alloc no.host deterministic {
    w.ground.tiles[c] = tile
    w.counts[CHANGED] += 1
}

// The cell a job is about, which is what is claimed while it is being done.
fn about(job: Job) -> i32 no.alloc no.host deterministic {
    return match job {
        Chop(c) -> c
        Build(c) -> c
        Sow(c) -> c
        Reap(c) -> c
        Fetch(c) -> c
        else -> -1
    }
}

// Set out for a cell, counted against what it was found as. The cell keeps
// which count that was, so letting it go takes it off the right one.
fn claim(w: World, c: i32, counted: i32) no.alloc no.host deterministic {
    w.claimed[c] = u8(counted)
    w.counts[CLAIMS + counted] += 1
}

// Let go of whatever the job had claimed, so that somebody else can have it.
fn release(w: World, job: Job) no.alloc no.host deterministic {
    let c = about(job)
    if c >= 0 && w.claimed[c] != 0 {
        w.counts[CLAIMS + i32(w.claimed[c])] -= 1
        w.claimed[c] = 0
        w.counts[CHANGED] += 1
    }
}

// Whether a search for a count is worth making: some of it is free, and the
// last search for it did not find nothing on a map that has not changed since.
fn worth(w: World, counted: i32) -> bool no.alloc no.host deterministic {
    return w.counts[counted] - w.counts[CLAIMS + counted] > 0 &&
        w.counts[FRUITLESS + counted] != w.counts[CHANGED] + 1
}

fn fruitless(w: World, counted: i32) no.alloc no.host deterministic {
    w.counts[FRUITLESS + counted] = w.counts[CHANGED] + 1
}

// What an idle colonist looks for, in the order it looks: its own needs, then
// what is lying about, then what the player asked for.
fn choose(w: World, one: Colonist) -> Colonist {
    let here = at(w, one)
    let chosen = one
    chosen.worked = 0.0
    let g = w.ground
    if one.hunger > f32(PECKISH) && w.counts[STORED_FOOD] > 0 {
        let found = path.nearest(
            g,
            w.search,
            here,
            g.tiles,
            map.STOCK,
            w.claimed,
            false
        )
        if found.target >= 0 {
            path.route(w.search, found.stand, chosen.route)
            chosen.job = Job.Eat
            return chosen
        }
    }
    if one.tired > f32(WEARY) {
        chosen.job = Job.Sleep
        return chosen
    }
    if one.carrying != NOTHING {
        let found = path.nearest(
            g,
            w.search,
            here,
            g.tiles,
            map.STOCK,
            w.claimed,
            false
        )
        if found.target >= 0 {
            path.route(w.search, found.stand, chosen.route)
            chosen.job = Job.Carry
            return chosen
        }
    }
    let lying = path.NOWHERE
    for kind in 1..3 {
        let thing = u8(kind)
        if lying.target >= 0 || !worth(w, LYING + kind) {
            continue
        }
        lying = path.nearest(
            g,
            w.search,
            here,
            w.items,
            thing,
            w.claimed,
            false
        )
        if lying.target < 0 {
            fruitless(w, LYING + kind)
        }
    }
    if lying.target >= 0 {
        path.route(w.search, lying.stand, chosen.route)
        claim(w, lying.target, LYING + i32(w.items[lying.target]))
        chosen.job = Job.Fetch(lying.target)
        return chosen
    }
    let orders = [REAP, BUILD, SOW, CHOP]
    for o in 0..4 {
        let order = orders[o]
        if !worth(w, MARKED + i32(order)) {
            continue
        }
        if order == BUILD && w.counts[STORED_WOOD] <= 0 {
            continue
        }
        let beside = order == BUILD || order == CHOP
        let found = path.nearest(
            g,
            w.search,
            here,
            w.marks,
            order,
            w.claimed,
            beside
        )
        if found.target < 0 {
            fruitless(w, MARKED + i32(order))
            continue
        }
        path.route(w.search, found.stand, chosen.route)
        claim(w, found.target, MARKED + i32(order))
        chosen.job = if order == REAP -> Job.Reap(found.target)
            else -> if order == BUILD -> Job.Build(found.target)
            else -> if order == SOW -> Job.Sow(found.target)
            else -> Job.Chop(found.target)
        return chosen
    }
    // Nothing to do. `worked` is how long it waits before looking again: a
    // search that finds nothing has walked every cell it can reach, and a
    // colony of idle people doing that every frame is a colony spending its
    // frame on nothing.
    chosen.job = Job.Idle
    chosen.worked = RESTLESS
    return chosen
}

// One step along the route, as far as `dt` lets it go. A step onto a cell
// that has stopped being walkable -- somebody built a wall there -- gives the
// job up, and one is looked for again next frame.
fn walk(w: World, one: Colonist, dt: f32) -> Colonist no.alloc no.host deterministic {
    let moved = one
    let left = PACE * dt
    while len(moved.route) > 0 && left > 0.0 {
        let next = moved.route[len(moved.route) - 1]
        if !map.open(w.ground.tiles[next]) {
            release(w, moved.job)
            clear(moved.route)
            moved.job = Job.Idle
            return moved
        }
        let tx = f32(next % w.ground.wide)
        let ty = f32(next / w.ground.wide)
        let dx = tx - moved.x
        let dy = ty - moved.y
        let far = if dx < 0.0 -> 0.0 - dx else -> dx
        far += if dy < 0.0 -> 0.0 - dy else -> dy
        if far <= left {
            moved.x = tx
            moved.y = ty
            left -= far
            pop(moved.route)
        } else {
            moved.x += dx / far * left
            moved.y += dy / far * left
            left = 0.0
        }
    }
    return moved
}

// Work on the cell a job is about, once the colonist is standing where it
// should. Answers the colonist, idle again when the work is done.
fn work(w: World, one: Colonist, dt: f32) -> Colonist {
    let busy = one
    busy.worked += dt
    let done = Colonist(
        busy.id,
        busy.x,
        busy.y,
        Job.Idle,
        busy.route,
        0.0,
        busy.carrying,
        busy.hunger,
        busy.tired
    )
    match busy.job {
        Idle {
            return busy
        }
        Chop(c) {
            if w.ground.tiles[c] != map.TREE {
                release(w, busy.job)
                mark(w, c, NOTHING)
                return done
            }
            if busy.worked < CHOPPING {
                return busy
            }
            build(w, c, map.GRASS)
            mark(w, c, NOTHING)
            lay(w, c, WOOD)
            release(w, busy.job)
            return done
        }
        Build(c) {
            if busy.worked < BUILDING {
                return busy
            }
            release(w, busy.job)
            mark(w, c, NOTHING)
            if w.counts[STORED_WOOD] > 0 &&
                    w.ground.tiles[c] == map.GRASS &&
                    w.items[c] == NOTHING &&
                    !standing(w, c) {
                w.counts[STORED_WOOD] -= 1
                build(w, c, map.WALL)
            } else {
                mark(w, c, BUILD)
            }
            return done
        }
        Sow(c) {
            if busy.worked < SOWING {
                return busy
            }
            release(w, busy.job)
            mark(w, c, NOTHING)
            if w.ground.tiles[c] == map.GRASS {
                build(w, c, map.FIELD)
                w.ripe[c] = 0.0
            }
            return done
        }
        Reap(c) {
            if busy.worked < REAPING {
                return busy
            }
            release(w, busy.job)
            mark(w, c, NOTHING)
            if w.ground.tiles[c] == map.FIELD && w.items[c] == NOTHING {
                lay(w, c, FOOD)
                w.ripe[c] = 0.0
            }
            return done
        }
        Fetch(c) {
            release(w, busy.job)
            if w.items[c] != NOTHING {
                done.carrying = w.items[c]
                lay(w, c, NOTHING)
            }
            return done
        }
        Carry {
            if busy.carrying == WOOD {
                w.counts[STORED_WOOD] += 1
            }
            if busy.carrying == FOOD {
                w.counts[STORED_FOOD] += 1
            }
            done.carrying = NOTHING
            return done
        }
        Eat {
            if busy.worked < EATING {
                return busy
            }
            if w.counts[STORED_FOOD] > 0 {
                w.counts[STORED_FOOD] -= 1
                done.hunger = 0.0
            }
            return done
        }
        Sleep {
            if busy.worked < SLEEPING {
                return busy
            }
            done.tired = 0.0
            return done
        }
    }
}

// Whether anybody is standing on a cell, which a wall is not built on top of.
fn standing(w: World, c: i32) -> bool no.alloc no.host deterministic {
    for r in w.people {
        if let one = get(w.people, r) {
            if at(w, one) == c {
                return true
            }
        }
    }
    return false
}

// Fields ripen on their own, and a ripe one asks to be reaped.
fn grow(w: World, dt: f32) no.alloc no.host deterministic {
    let cells = len(w.ground.tiles)
    for c in 0..cells {
        if w.ground.tiles[c] != map.FIELD {
            continue
        }
        if w.ripe[c] < RIPENING {
            w.ripe[c] += dt
            continue
        }
        if w.marks[c] == NOTHING && w.items[c] == NOTHING {
            mark(w, c, REAP)
        }
    }
}

// One frame of the colony. Answers how many are alive.
fn step(w: World, dt: f32) -> i32 {
    w.counts[TICK] += 1
    w.seconds[0] += dt
    // Fields are walked once a second rather than once a frame: ripening is
    // slow and the walk is every cell there is.
    w.seconds[1] += dt
    if w.seconds[1] >= 1.0 {
        grow(w, w.seconds[1])
        w.seconds[1] = 0.0
    }
    let alive = 0
    let dead: [ref<Colonist>] = array()
    for r in w.people {
        if let one = get(w.people, r) {
            let now = one
            now.hunger += dt
            now.tired += dt
            if now.hunger > f32(STARVED) {
                release(w, now.job)
                push(dead, r)
                continue
            }
            match now.job {
                Idle {
                    if now.worked > 0.0 {
                        now.worked -= dt
                    } else {
                        now = choose(w, now)
                    }
                }
                Sleep {
                    now = work(w, now, dt)
                }
                else {
                    now = walk(w, now, dt)
                    if now.job != Job.Idle && len(now.route) == 0 {
                        now = work(w, now, dt)
                    }
                }
            }
            set(w.people, r, now)
            alive += 1
        }
    }
    for r in dead {
        remove(w.people, r)
        w.counts[DIED] += 1
    }
    // A newcomer every so often, while there is food to spare.
    if w.seconds[0] > 30.0 {
        w.seconds[0] = 0.0
        if w.counts[STORED_FOOD] > alive * 2 {
            arrive(w, f32(w.ground.wide / 2), f32(w.ground.high / 2))
            alive += 1
        }
    }
    return alive
}

// What the player asked for over a rectangle of cells. Answers how many cells
// took the order: a chop only where there is a tree, the rest only on grass.
fn order(w: World, what: i32, x0: i32, y0: i32, x1: i32, y1: i32) -> i32 no.alloc no.host deterministic {
    let asked = u8(what)
    let took = 0
    let lx = if x0 < x1 -> x0 else -> x1
    let hx = if x0 < x1 -> x1 else -> x0
    let ly = if y0 < y1 -> y0 else -> y1
    let hy = if y0 < y1 -> y1 else -> y0
    for y in ly..hy + 1 {
        for x in lx..hx + 1 {
            if !map.inside(w.ground, x, y) {
                continue
            }
            let c = map.cell(w.ground, x, y)
            let tile = w.ground.tiles[c]
            if asked == NOTHING {
                if w.claimed[c] == 0 {
                    mark(w, c, NOTHING)
                }
                continue
            }
            let fits = if asked == CHOP -> tile == map.TREE
                else -> tile == map.GRASS
            if fits && w.claimed[c] == 0 {
                mark(w, c, asked)
                took += 1
            }
        }
    }
    return took
}

// The ground as the host draws it, written into memory the host lent: what is
// on each cell, what was asked for there, and what is lying on it.
fn paint(w: World, tiles: [u8], marks: [u8], items: [u8]) -> i32 no.alloc no.host {
    let cells = len(w.ground.tiles)
    if len(tiles) < cells || len(marks) < cells || len(items) < cells {
        return 0
    }
    for c in 0..cells {
        tiles[c] = w.ground.tiles[c]
        marks[c] = w.marks[c]
        items[c] = w.items[c]
    }
    return cells
}

// The people as the host draws them: where each is, and a number for what
// it is doing. Answers how many were written.
fn people(w: World, xs: [f32], ys: [f32], doing: [i32]) -> i32 no.alloc no.host {
    let at = 0
    for r in w.people {
        if at >= len(xs) || at >= len(ys) || at >= len(doing) {
            break
        }
        if let one = get(w.people, r) {
            xs[at] = one.x
            ys[at] = one.y
            doing[at] = match one.job {
                Idle -> 0
                Chop(c) -> 1
                Build(c) -> 2
                Sow(c) -> 3
                Reap(c) -> 4
                Fetch(c) -> 5
                Carry -> 6
                Eat -> 7
                Sleep -> 8
            }
            at += 1
        }
    }
    return at
}

// The counts, copied into the host's memory in the order the constants above
// number them.
fn tally(w: World, into: [i32]) -> i32 no.alloc no.host {
    let many = if len(into) < COUNTS -> len(into) else -> COUNTS
    for i in 0..many {
        into[i] = w.counts[i]
    }
    return many
}

// A save, as bytes: what `kest_held_reload` carries from the running program
// to the new one, and what a save file would be. Written by `std.bytes`, so a
// float is its bits and comes back as itself. What anybody was doing is not
// saved -- a job is a claim on a cell and a route through a map, and the new
// program may mean something else by both -- so everybody wakes up idle and
// looks again.
fn save(w: World) -> [u8] no.host deterministic {
    let out: [u8] = array()
    bytes.putI32(out, w.ground.wide)
    bytes.putI32(out, w.ground.high)
    bytes.putI32s(out, w.counts)
    // A column at a time, which is a call a column rather than four a cell.
    bytes.putBytes(out, w.ground.tiles)
    bytes.putBytes(out, w.marks)
    bytes.putBytes(out, w.items)
    bytes.putF32s(out, w.ripe)
    for r in w.people {
        if let one = get(w.people, r) {
            bytes.putU8(out, one.carrying)
            bytes.putF32(out, one.x)
            bytes.putF32(out, one.y)
            bytes.putF32(out, one.hunger)
            bytes.putF32(out, one.tired)
        }
    }
    return out
}

// And a world made again from those bytes, in a machine that has never seen
// the one they came from. The counts of what is marked and lying are counted
// again from the cells rather than trusted, and nothing is claimed.
fn restore(saved: [u8]) -> World no.host deterministic {
    let r = bytes.reader(saved)
    let wide = bytes.readI32(r)
    let high = bytes.readI32(r)
    let old = bytes.readI32s(r)
    let written = len(old)
    let tiles = bytes.readBytes(r)
    let marks = bytes.readBytes(r)
    let items = bytes.readBytes(r)
    let ripe = bytes.readF32s(r)
    let cells = wide * high
    // The ground and what grows on it are the columns as they were read; what
    // is marked and what is lying are put down a cell at a time, so that
    // their counts are counted again rather than trusted.
    let whole = len(tiles) == cells &&
        len(marks) == cells &&
        len(items) == cells &&
        len(ripe) == cells
    let ground = map.Ground(
        wide,
        high,
        if whole -> tiles else -> array(cells, map.GRASS)
    )
    let w = World(
        ground,
        array(cells, NOTHING),
        array(cells, NOTHING),
        if whole -> ripe else -> array(cells, 0.0),
        array(cells, NOTHING),
        store(),
        path.over(ground),
        array(COUNTS, 0),
        array(2, 0.0)
    )
    if !whole {
        return w
    }
    for c in 0..cells {
        if marks[c] != NOTHING {
            mark(w, c, marks[c])
        }
        if items[c] != NOTHING {
            lay(w, c, items[c])
        }
    }
    let kept = [TICK, STORED_WOOD, STORED_FOOD, BORN, DIED, MADE]
    for k in 0..len(kept) {
        if kept[k] < written {
            w.counts[kept[k]] = old[kept[k]]
        }
    }
    let id = 0
    while bytes.left(r) >= 17 {
        id += 1
        let carrying = bytes.readU8(r)
        let x = bytes.readF32(r)
        let y = bytes.readF32(r)
        let hunger = bytes.readF32(r)
        let tired = bytes.readF32(r)
        add(
            w.people,
            Colonist(id, x, y, Job.Idle, array(), 0.0, carrying, hunger, tired)
        )
    }
    return w
}
