module examples.numbers

import std.io
import std.math
import std.sort

// What a number does at the end of its range, which is where a simulation
// lives: a count that runs over, a narrowing that keeps what it has room for,
// a divide by nought. Everything here is D018's rule — match C where C has an
// answer, and answer where it has none — and every line of it is a rule the
// reference states, run.

// Worked out where it is written, with the same arithmetic that runs: `120 +
// 10` in an `i8` is -126 before the program starts.
const NARROW: i8 = 120 + 10

// The same arithmetic in the two places this compiler does it: a constant is
// worked out where it is written, by the folder, and an expression the folder
// cannot see through is worked out while running, by the machine. Two
// implementations of one promise — D667 fixed one of them and nothing held
// them to each other. See D668.
const HIGHEST: i64 = 9223372036854775807
const SMALLEST: i64 = -9223372036854775807 - 1
const OVER: i64 = HIGHEST * 3
const PAST: i64 = HIGHEST + 1
const FLIPPED: i64 = -SMALLEST
const SHIFTED: i64 = HIGHEST << 3
const NARROWED: i8 = NARROW * 3
// And the conversions, which the folder does now for the same reason it does
// the arithmetic: a narrowing is what a program writes when it means one, and
// it meant the same thing everywhere except where it was worked out. See D669.
const CUT: i32 = i32(HIGHEST)
const BYTE: u8 = u8(HIGHEST)
const ROUNDED: f32 = f32(1.0 / 3.0)
const TRUNCATED: i16 = i16(3.9)
const STOPPED: i8 = i8(1000.0)

// What the folder cannot see through, which is a call: it works out numbers,
// truths, text and arithmetic on those, and stops where a program starts.
fn asRun(n: i64) -> i64 no.alloc {
    return n
}

fn realAsRun(x: f64) -> f64 no.alloc {
    return x
}

fn asRunNarrow(n: i8) -> i8 no.alloc {
    return n
}

fn main() -> i32 {
    // One past the top of each width is the bottom of it.
    let byte: i8 = 127
    let count: u8 = 255
    let short: i16 = 32767
    let big: i32 = 2147483647
    if byte + 1 != -128 || count + 1 != 0 {
        return 1
    }
    if short + 1 != -32768 || big + 1 != -2147483648 {
        return 2
    }
    // And one below the bottom is the top, which is the same rule read the
    // other way.
    let least: i8 = -128
    if least - 1 != 127 {
        return 3
    }
    // Narrowing keeps the bits it has room for, and a constant is worked out
    // where it is written with the same arithmetic: `120 + 10` in an `i8` is
    // -126 before the program runs.
    if i8(300) != 44 || u8(300) != 44 || i16(70000) != 4464 {
        return 4
    }
    if NARROW != -126 {
        return 5
    }
    // The one division that has no answer to give: the least number over minus
    // one is one past the top of the width, so it wraps to itself like every
    // other arithmetic that runs off the end, and what is left over is nought.
    let least32: i32 = i32(0 - 2147483647) - 1
    let minus: i32 = 0 - 1
    if least32 / minus != least32 || least32 % minus != 0 {
        return 31
    }
    let least8: i8 = i8(0 - 127) - 1
    if least8 / i8(0 - 1) != least8 || least8 % i8(0 - 1) != 0 {
        return 32
    }

    // A shift past the width is everything shifted out, at every width and not
    // only at the one the slot is: the value is worked out wide and comes back
    // to what it was declared as, so a `u8` shifted nine leaves nothing and a
    // signed one keeps its sign.
    let wide8: u8 = 200
    if wide8 << 9 != 0 || wide8 >> 9 != 0 {
        return 33
    }
    let signed8: i8 = 0 - 8
    if signed8 >> 9 != 0 - 1 || signed8 >> 2 != 0 - 2 {
        return 34
    }
    let one: i32 = 1
    if one << 32 != 0 || one << 31 != i32(0 - 2147483647) - 1 {
        return 35
    }

    // A division truncates towards nought and a remainder keeps the sign of
    // what was divided, which is what C says and what a program written
    // against C expects.
    let owed = -7
    if owed / 3 != -2 || owed % 3 != -1 {
        return 6
    }

    // A float going the other way is truncated towards nought and stops at the
    // end of the range rather than wrapping, which is the one place these two
    // rules differ. Nothing that is not a number has an order, so it lands on
    // nought.
    let vast: f64 = 1000000000000000000000.0
    if i32(vast) != 2147483647 || i32(-vast) != -2147483648 {
        return 7
    }
    if u8(300.0) != 255 || u8(-5.0) != 0 {
        return 8
    }
    let nothing: f64 = 0.0
    if i32(nothing / nothing) != 0 {
        return 9
    }
    if i32(1.0 / nothing) != 2147483647 {
        return 10
    }

    // Dividing by nought is two different things. A whole number has no
    // answer, so it is a message with a code; a float has one, and it is the
    // one C has: an infinity with a sign, or not a number when nought is
    // divided by nought.
    if !(1.0 / nothing > 0.0) {
        return 11
    }
    if !(-1.0 / nothing < 0.0) {
        return 12
    }
    // Nothing that is not a number is equal to anything, itself included,
    // which is what makes it worth having.
    let unmeasured = nothing / nothing
    if unmeasured == unmeasured || unmeasured < 0.0 || unmeasured > 0.0 {
        return 13
    }
    // And there is one spelling of it, because which sign a divide left in it
    // says something about the bits and nothing about the value.
    if "{unmeasured}" != "nan" || "{0.0 - unmeasured}" != "nan" {
        return 14
    }
    if "{1.0 / nothing}" != "inf" || "{-1.0 / nothing}" != "-inf" {
        return 15
    }

    // The usual order, over each width in turn. `sort.ascending` is one body
    // that takes a type, so this is one copy per width — and the comparison in
    // each is the one that width does, which is the whole point of writing it
    // once.
    let bytes: [u8] = array()
    push(bytes, u8(255))
    push(bytes, u8(1))
    sort.by(bytes, sort.ascending)
    if bytes[0] != 1 || bytes[1] != 255 {
        return 16
    }

    let signed: [i8] = array()
    push(signed, i8(0 - 128))
    push(signed, i8(127))
    sort.by(signed, sort.descending)
    if signed[0] != 127 {
        return 17
    }

    let wide: [i64] = array()
    push(wide, i64(9223372036854775807))
    push(wide, i64(0 - 1))
    sort.by(wide, sort.ascending)
    if wide[0] != 0 - 1 {
        return 18
    }

    let counts: [u64] = array()
    push(counts, u64(18446744073709551615))
    push(counts, u64(2))
    sort.by(counts, sort.ascending)
    if counts[0] != 2 {
        return 19
    }

    let reals: [f64] = array()
    push(reals, 2.5)
    push(reals, 0.0 - 1.5)
    sort.by(reals, sort.ascending)
    if reals[0] != 0.0 - 1.5 {
        return 20
    }

    // The library is written twice for the widths a frame uses and the widths
    // a number is written in, and until this ran only one of each pair had
    // ever been asked anything. A copy of a body is a copy of a mistake.
    let low: i64 = 0 - 9223372036854775807
    let two: i64 = 2
    if math.min(low, two) != low || math.max(low, two) != two {
        return 21
    }
    if math.abs(0 - 5) != 5 || math.clamp(9, 0, 4) != 4 {
        return 22
    }
    let root: f64 = 2.0
    if math.abs(math.sqrt(root) * math.sqrt(root) - root) > 0.0000001 {
        return 23
    }
    // A square root of a negative is not a number, which is what a float says
    // instead of stopping the program, and the only way to find out is to ask:
    // it is not equal to itself, so nothing compares its way to the answer.
    let broken = math.sqrt(0.0 - root)
    if math.isNumber(broken) || broken == broken {
        return 36
    }
    if !math.isNumber(root) || !math.isNumber(0.0) {
        return 37
    }
    // And what a number too big to hold comes back as, which is equal to
    // itself and is not a number to go on with either.
    let most: f32 = 340282350000000000000000000000000000000.0
    if math.isNumber(most * 10.0) {
        return 38
    }
    if !math.isNumber(most) {
        return 39
    }
    // Both halves of a pair, asked the same thing. This module is written
    // twice over — once for the width a frame works in and once for the width
    // a number is written in — and four of those halves were not there at all:
    // a program counting in `i64` could take the smaller of two and not the
    // distance from nought, and a frame working in `f32` had to widen by hand
    // to ask for an angle, which is the module not doing its half.
    let far: i64 = 0 - 5000000000
    if math.abs(far) != 5000000000 || math.sign(far) != 0 - 1 {
        return 40
    }
    // The bounds are written in the width they are held against: a literal
    // takes its width from what is beside it, and beside an argument there is
    // nothing until the call is settled.
    let under: i64 = 0 - 1
    let over: i64 = 1
    if math.clamp(far, under, over) != under || math.sign(0 - far) != 1 {
        return 41
    }
    if math.sign(far - far) != 0 {
        return 42
    }
    // The same angle asked for in both widths, which is the answer narrowed
    // and the answer to the narrowed question.
    let narrow: f32 = 0.5
    if let angle = math.asin(narrow) {
        if math.abs(angle - 0.5235988) > 0.0001 {
            return 43
        }
    } else {
        return 44
    }
    if let angle = math.acos(narrow) {
        if math.abs(angle - 1.0471976) > 0.0001 {
            return 45
        }
    } else {
        return 46
    }
    // And what has no angle has none in either width.
    let past: f32 = 2.0
    if math.asin(past) != none {
        return 47
    }
    if math.acos(past) != none {
        return 48
    }
    if math.pow(root, 10.0) != 1024.0 {
        return 24
    }
    let half: f64 = 2.5
    if math.round(half) != 3.0 || math.ceil(2.1) != 3.0 {
        return 25
    }
    let nine: f64 = 9.0
    if math.clamp(nine, 0.0, 4.0) != 4.0 {
        return 26
    }
    let nought: f64 = 0.0
    if math.cos(nought) != 1.0 {
        return 27
    }
    // A tangent is a sine over a cosine, and an angle of nought has neither
    // of the two problems that has.
    if math.tan(nought) != 0.0 {
        return 28
    }
    // Straight up is a quarter turn, and a quarter of the way from nought to
    // ten is two and a half.
    let up: f64 = 1.0
    if math.abs(math.atan2(up, nought) - 1.5707963267948966) > 0.0000001 {
        return 29
    }
    let ten: f64 = 10.0
    if math.lerp(nought, ten, 0.25) != 2.5 {
        return 30
    }

    // Unsigned arithmetic asked for by itself. Every unsigned number in this
    // file so far has been sorted, pushed, or compared — none has been
    // divided, counted with, or written into text — so the instructions that
    // do the unsigned half of those three things had never run. Division is
    // the one that would give a different answer signed: the top bit of a
    // `u32` is a large number, not a negative one.
    let top: u32 = 4294967295
    let three: u32 = 3
    if top / three != 1431655765 || top % three != 0 {
        return 52
    }
    let huge: u64 = 18446744073709551615
    if huge / 3 != 6148914691236517205 {
        return 53
    }
    // Written into text the same way: the digits of the number it is, not of
    // the signed number those bits would be.
    if "{top}" != "4294967295" || "{huge}" != "18446744073709551615" {
        return 54
    }
    let ready: bool = top > 0
    if "{ready}" != "true" || "{huge > 0}" != "true" {
        return 55
    }
    // And counted with. A range over an unsigned bound is stepped by the
    // instruction that compares unsigned, which nothing had reached.
    let steps: u32 = 4
    let walked: u32 = 0
    for i in 0..steps {
        walked = walked + 1
    }
    if walked != steps {
        return 56
    }

    // A comparison kept rather than asked. Nearly every comparison in this
    // tree is the condition of an `if` or a `while`, and the compiler folds
    // those into the jump — so the ten instructions that answer `true` or
    // `false` and leave the answer on the stack had never been run by
    // anything anybody wrote. See D430.
    let below: bool = ten <= 0.0
    let above: bool = ten >= 0.0
    let apart: bool = ten != 0.0
    let many: i64 = 5
    let fewer: bool = many <= 4
    let more: bool = many >= 4
    let differs: bool = many != 4
    let sorted: bool = "a" <= "b"
    let later: bool = "b" > "a"
    let atLeast: bool = "b" >= "a"
    if below || !above || !apart || fewer || !more || !differs {
        return 49
    }
    if !sorted || !later || !atLeast {
        return 50
    }
    // Which way round a comparison is asked. In `a || b` the first one jumps
    // when it is true, because true is the answer; in `a && b` and on its own
    // it jumps when it is false. So the same range check written the two ways
    // round compiles to two different instructions, and three of those had
    // never been written either way in this tree.
    let floor: i64 = 0
    let ceiling: i64 = 10
    let held: i64 = 5
    if held <= floor || held > ceiling {
        return 57
    }
    if held > ceiling || held <= floor {
        return 58
    }
    let part: f64 = 0.25
    if part <= 0.0 || part > 1.0 {
        return 59
    }

    // The eleventh: `!` in a condition is folded into the jump too, so the
    // instruction that turns a `bool` over is only reached by keeping it.
    let neither: bool = !above
    if neither {
        return 51
    }

    // And the ends of the widest one, which is where wrapping is a thing the
    // machine has to do on purpose: adding past the top, multiplying past it,
    // and negating the smallest number there is, which is itself. A machine
    // doing these the way C does them signed is a machine whose answer is
    // undefined, and a build told to look says so. See D667.
    let highest: i64 = 9223372036854775807
    if highest + 1 != -9223372036854775807 - 1 {
        return 60
    }
    if highest * 3 != highest - 2 {
        return 61
    }
    let smallest: i64 = -9223372036854775807 - 1
    if -smallest != smallest {
        return 62
    }
    let ones: u64 = 18446744073709551615
    if ones * ones != 1 {
        return 63
    }

    // And the two of them against each other, which is the pair D668 is
    // about: the same expression folded and run has to be the same number.
    if asRun(HIGHEST) * 3 != OVER {
        return 64
    }
    if asRun(HIGHEST) + 1 != PAST {
        return 65
    }
    if -asRun(SMALLEST) != FLIPPED {
        return 66
    }
    if asRun(HIGHEST) << 3 != SHIFTED {
        return 67
    }
    if asRunNarrow(NARROW) * 3 != NARROWED {
        return 68
    }
    if i32(asRun(HIGHEST)) != CUT || u8(asRun(HIGHEST)) != BYTE {
        return 69
    }
    if f32(realAsRun(1.0 / 3.0)) != ROUNDED {
        return 70
    }
    if i16(realAsRun(3.9)) != TRUNCATED || i8(realAsRun(1000.0)) != STOPPED {
        return 71
    }

    io.print("every width wraps at its own end, and {NARROW} is one of them")
    return 0
}
