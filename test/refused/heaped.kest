// Refused with K0502. Guards against a body holding more than 65535 slots at once, in its names or in the values it works on, wrapping the compiler's two-byte count and being refused as the compiler's own mistake.

module test.refused.heaped

const A: [bool; 32] = [
    true,
    true,
