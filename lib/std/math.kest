module std.math

// Two functions may share a name when they take different things, so there is
// one `min` rather than a `minInt` and a `minFloat`. Which is meant is settled
// by what is passed, and nothing converts on its own, so `min(1, 2.0)` is not
// a question with a quiet answer.
//
// What cannot be written in Kest is declared instead. A host that a program
// using this module runs against has to provide these, and a program that
// never reaches one never asks for it.

extern fn Math.sqrt(value: f64) -> f64 no.alloc
extern fn Math.floor(value: f64) -> f64 no.alloc
extern fn Math.ceil(value: f64) -> f64 no.alloc
extern fn Math.sin(value: f64) -> f64 no.alloc
extern fn Math.cos(value: f64) -> f64 no.alloc
extern fn Math.pow(base: f64, exponent: f64) -> f64 no.alloc

// Where two numbers point, in radians from the positive `x` axis and between
// -pi and pi. It is the one thing here that cannot be built out of the others:
// a program turning towards something has a difference and wants an angle, and
// working that out from `sin` and `cos` is working backwards.
extern fn Math.atan2(y: f64, x: f64) -> f64 no.alloc

fn min(a: i32, b: i32) -> i32 no.alloc {
    return if a < b -> a else -> b
}

fn min(a: i64, b: i64) -> i64 no.alloc {
    return if a < b -> a else -> b
}

fn min(a: f32, b: f32) -> f32 no.alloc {
    return if a < b -> a else -> b
}

fn min(a: f64, b: f64) -> f64 no.alloc {
    return if a < b -> a else -> b
}

fn max(a: i32, b: i32) -> i32 no.alloc {
    return if a > b -> a else -> b
}

fn max(a: i64, b: i64) -> i64 no.alloc {
    return if a > b -> a else -> b
}

fn max(a: f32, b: f32) -> f32 no.alloc {
    return if a > b -> a else -> b
}

fn max(a: f64, b: f64) -> f64 no.alloc {
    return if a > b -> a else -> b
}

fn abs(value: i32) -> i32 no.alloc {
    return if value < 0 -> 0 - value else -> value
}

fn abs(value: f32) -> f32 no.alloc {
    return if value < 0.0 -> 0.0 - value else -> value
}

fn abs(value: f64) -> f64 no.alloc {
    return if value < 0.0 -> 0.0 - value else -> value
}

fn clamp(value: i32, low: i32, high: i32) -> i32 no.alloc {
    return min(max(value, low), high)
}

fn clamp(value: f32, low: f32, high: f32) -> f32 no.alloc {
    return min(max(value, low), high)
}

fn clamp(value: f64, low: f64, high: f64) -> f64 no.alloc {
    return min(max(value, low), high)
}

// A `f32` goes through the `f64` one and comes back, because a frame works in
// `f32` and widening one by hand at every call is the module not doing its
// half. Widening is exact and narrowing rounds, so there is one rounding here
// and one in the host.
//
// What that comes to depends on the function. `sqrt` is rounded exactly by
// every machine that has one, and `f64` carries more than twice the digits of
// `f32`, so the answer rounded twice is the answer rounded once: the nearest
// `f32` to the true one. `floor` and `ceil` are exact and `round` is built out
// of `floor`. `sin`, `cos` and `pow` are not promised to be rounded exactly by
// anybody, so what comes back is the nearest `f32` to the host's own answer,
// which is within a hair of the true one and is the same hair a program would
// get by asking in `f64` itself.
fn sqrt(value: f64) -> f64 no.alloc {
    return Math.sqrt(value)
}

fn sqrt(value: f32) -> f32 no.alloc {
    return f32(Math.sqrt(f64(value)))
}

fn floor(value: f64) -> f64 no.alloc {
    return Math.floor(value)
}

fn floor(value: f32) -> f32 no.alloc {
    return f32(Math.floor(f64(value)))
}

fn ceil(value: f64) -> f64 no.alloc {
    return Math.ceil(value)
}

fn ceil(value: f32) -> f32 no.alloc {
    return f32(Math.ceil(f64(value)))
}

fn sin(value: f64) -> f64 no.alloc {
    return Math.sin(value)
}

fn sin(value: f32) -> f32 no.alloc {
    return f32(Math.sin(f64(value)))
}

fn cos(value: f64) -> f64 no.alloc {
    return Math.cos(value)
}

fn cos(value: f32) -> f32 no.alloc {
    return f32(Math.cos(f64(value)))
}

fn pow(base: f64, exponent: f64) -> f64 no.alloc {
    return Math.pow(base, exponent)
}

fn pow(base: f32, exponent: f32) -> f32 no.alloc {
    return f32(Math.pow(f64(base), f64(exponent)))
}

fn atan2(y: f64, x: f64) -> f64 no.alloc {
    return Math.atan2(y, x)
}

fn atan2(y: f32, x: f32) -> f32 no.alloc {
    return f32(Math.atan2(f64(y), f64(x)))
}

// Written here rather than declared, because they are what `atan2` and the
// curves already asked for come to. A tangent is a sine over a cosine, and an
// angle whose sine is `value` is where `value` and the other side point.
fn tan(value: f64) -> f64 no.alloc {
    return Math.sin(value) / Math.cos(value)
}

fn tan(value: f32) -> f32 no.alloc {
    return f32(Math.sin(f64(value)) / Math.cos(f64(value)))
}

// Nothing outside -1 to 1 has an angle, and asking for one is a question with
// no answer rather than a number to make up (D013).
fn asin(value: f64) -> f64? no.alloc {
    if value < 0.0 - 1.0 || value > 1.0 {
        return none
    }
    return Math.atan2(value, Math.sqrt(1.0 - value * value))
}

fn acos(value: f64) -> f64? no.alloc {
    if value < 0.0 - 1.0 || value > 1.0 {
        return none
    }
    return Math.atan2(Math.sqrt(1.0 - value * value), value)
}

// The nearest whole number, with a half going up: `round(2.5)` is 3 and
// `round(-2.5)` is -2, which is what `floor(value + 0.5)` says and what a
// program that wanted anything else would write for itself.
//
// Written here rather than declared. Every `extern` in this module is a
// function every host of every program that imports it has to provide, so one
// more is a thing every host has to be changed for; what can be built out of
// what is already declared is built.
fn round(value: f64) -> f64 no.alloc {
    return floor(value + 0.5)
}

fn round(value: f32) -> f32 no.alloc {
    return f32(floor(f64(value) + 0.5))
}

// Written here rather than declared, because they are what the host already
// gives with an operator in front.
fn sign(value: i32) -> i32 no.alloc {
    return if value > 0 -> 1 else if value < 0 -> 0 - 1 else -> 0
}

fn lerp(from: f32, to: f32, amount: f32) -> f32 no.alloc {
    return from + (to - from) * amount
}

fn lerp(from: f64, to: f64, amount: f64) -> f64 no.alloc {
    return from + (to - from) * amount
}
