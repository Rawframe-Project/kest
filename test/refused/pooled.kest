fn pick(i: i32) -> i32 {
    if XC[i][0][0] && YC[i][1][2] {
        return 11
    }
    if XC[i][3][4] {
        return 7
    }
    return 5
}

fn main() -> i32 {
    return pick(1) - 7
}
