module examples.pieces

import std.io
import std.text

// Text is its bytes, and there is no `+` on text, so a string built a piece at
// a time is built as bytes and paid for once. `text(bytes)` is the only way to
// make text out of a value that is not a string with a hole in it, and it is
// what `std.text` is written out of.

struct Row {
    name: text
    score: i32
}

// One line per row, with the columns padded so they line up. Everything goes
// on one array of bytes and becomes text at the end, which is one allocation
// rather than one for every column of every row.
fn table(rows: [Row], width: i32) -> text {
    let out: [u8] = array()
    for r in 0..len(rows) {
        if r > 0 {
            text.append(out, "\n")
        }
        let name = rows[r].name
        text.append(out, name)
        for pad in len(name)..width {
            push(out, ' ')
        }
        text.append(out, "{rows[r].score}")
    }
    return text(out)
}

// Reading a byte at a time and writing one costs nothing until the end, so a
// caller that wants no allocation can hand the bytes in and keep them.
fn vowels(subject: text) -> i32 no.alloc {
    let count = 0
    for i in 0..len(subject) {
        let byte = subject[i]
        if byte == 'a' ||
                byte == 'e' ||
                byte == 'i' ||
                byte == 'o' ||
                byte == 'u' {
            count += 1
        }
    }
    return count
}

fn main() -> i32 {
    let rows: [Row] = array()
    push(rows, Row("ada", 12))
    push(rows, Row("bo", 7))

    if table(rows, 5) != "ada  12\nbo   7" {
        return 1
    }

    let words = text.split("the quick brown fox", " ")
    if len(words) != 4 {
        return 2
    }
    if text.join(words, "-") != "the-quick-brown-fox" {
        return 3
    }
    if text.upper(text.join(words, " ")) != "THE QUICK BROWN FOX" {
        return 4
    }
    if text.repeat("-", 8) != "--------" {
        return 5
    }
    if vowels(text.join(words, "")) != 5 {
        return 6
    }

    // The two halves of one thing. A cut gives one more piece than there are
    // separators, always, which is what says what the ends are: nothing is one
    // empty piece, and a subject ending with a separator has an empty piece
    // after it. Held by joining the pieces back rather than by counting them,
    // because a count is a second thing to keep in step and this is the rule
    // itself. See D892.
    let ends: [text] = ["", ",", "a,b,", ",a,b", "a,,b", "a", ",,,"]
    for one in ends {
        if text.join(text.split(one, ","), ",") != one {
            return 7
        }
    }
    if text.join(text.split("one::two::", "::"), "::") != "one::two::" {
        return 8
    }
    if len(text.split("", ",")) != 1 || len(text.split("a,b,", ",")) != 3 {
        return 9
    }

    io.print(table(rows, 5))
    return 0
}
