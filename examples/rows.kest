module examples.rows

import std.io

// A struct holding a run of structs, which is the shape a host lends when it
// has an array inside a struct: `struct Row { Cell cells[3]; int32_t tag; }`.
// The bytes are the ones a C compiler gives that, and `kest check` says so.

struct Cell {
    at: i32
    weight: f32
}

struct Row {
    cells: [Cell; 3]
    tag: i32
}

// And one with nothing in it, which is a slot all the same: a struct is at
// least one slot wide so that a value of one is a value, and a width believed
// in some places and not others is a value that changes shape on the way. It
// was believed by the frame a program is called with, by what a constant of
// one has to fill, and not by the thing that builds one. See D807.
struct Nothing {
}

// What that is worth holding is a call where it is not the only argument: the
// numbers after it are where a slot that was never pushed shows up.
const NOWT: Nothing = Nothing()

fn after(e: Nothing, n: i32, m: i32) -> i32 no.alloc {
    return n * 100 + m
}

fn heaviest(r: Row) -> i32 no.alloc {
    let best = 0
    let seen = 0.0
    for c in r.cells {
        if c.weight > seen {
            seen = c.weight
            best = c.at
        }
    }
    return best
}

fn made(tag: i32) -> Row {
    return Row([Cell(1, 0.5), Cell(2, 1.5), Cell(3, 1.0)], tag)
}

fn main() -> i32 {
    let r = made(7)
    if heaviest(r) != 2 {
        return 1
    }
    if r.cells[0].at != 1 || r.cells[2].weight != 1.0 {
        return 2
    }

    // Written into where it stands, not through a handle: the row is a value
    // and the cells are inside it.
    r.cells[1].weight = 0.25
    if heaviest(r) != 3 {
        return 3
    }

    // One that came back from a call, indexed where it stands.
    if made(1).cells[1].at != 2 {
        return 4
    }

    let rows: [Row; 2] = [made(1), made(2)]
    if rows[1].tag != 2 || rows[1].cells[2].at != 3 {
        return 5
    }

    // The same row reached through a handle rather than where it stands. A
    // run that can grow is memory the program holds an address into, so a
    // cell inside a row inside it is one address worked out and one load —
    // and with both indexes worked out while it runs there is no slot to name
    // and no constant to read from. That is the only way to reach the
    // instruction that steps an address (D430).
    let many: [Row] = array()
    push(many, made(1))
    push(many, made(2))
    let which = 1
    let cell = 2
    if many[which].cells[cell].at != 3 || many[which].tag != 2 {
        return 6
    }
    if many[which].cells[cell].weight != 1.0 {
        return 7
    }

    // A struct with nothing in it, built where it stands and read from a
    // constant, with numbers after it either way. Pushed as no slots at all,
    // both of these answered whatever the stack was holding. See D807.
    if after(Nothing(), 3, 4) != 304 || after(NOWT, 5, 6) != 506 {
        return 8
    }

    // And what two of these are worth comparing by, which is everything in
    // them: a `Cell` is two numbers, a `[Cell; 3]` is three of them in a row,
    // and a `Row` is that run and a tag. None of it is a handle, so there is
    // one answer to whether two of them are the same and this is it. A struct
    // that held a `[Cell]` instead would be refused, because comparing two
    // handles answers a different question. See D874.
    if made(1) != made(1) || made(1) == made(2) {
        return 9
    }
    if made(1).cells != made(2).cells || made(1).cells[0] != Cell(1, 0.5) {
        return 10
    }
    // And what compares has a number standing for it, which is the same rule
    // read the other way: two that are equal hash the same and two that are
    // not are free to.
    if hash(made(1)) != hash(made(1)) || hash(made(1)) == hash(made(2)) {
        return 11
    }

    io.print("a row is three cells and a tag, heaviest {heaviest(r)}")
    return 0
}
