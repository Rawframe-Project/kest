module examples.host

// `extern` declares what the host provides. Nothing about it is inferred: what
// it takes, what it returns and whether it allocates are all written down,
// because its body is not here to be read. The command line binds these three;
// an engine embedding Kest binds its own.

extern fn Host.sqrt(value: f64) -> f64 no.alloc
extern fn Host.write(value: text)
extern fn Host.clock() -> i64 no.alloc

fn hypotenuse(a: f64, b: f64) -> f64 no.alloc {
    return Host.sqrt(a * a + b * b)
}

fn main() -> i32 {
    let d: f64 = hypotenuse(3.0, 4.0)
    if d != 5.0 {
        return 1
    }

    Host.write("crossed the boundary and came back with ")
    print("{d}")

    let before = Host.clock()
    let i = 0
    let total: f64 = 0.0
    while i < 1000 {
        total = total + hypotenuse(1.0, 1.0)
        i += 1
    }
    if Host.clock() < before {
        return 2
    }
    if total < 1414.0 {
        return 3
    }

    let borrow = borrowed()
    if borrow != 0 {
        return borrow
    }
    return 0
}

// One crossing carries a view of memory the host owns. Nothing is copied at
// the boundary: reading `samples[i]` reads the host's `float`, because a Kest
// `f32` is the same four bytes. D007 measured this shape at 1.05x across five
// languages and the per-value shape at 9.63x, which is why it is the one the
// language makes easy.
extern fn Host.samples() -> [f32] no.alloc
extern fn Host.sample(index: i32) -> f32 no.alloc

fn totalOf(samples: [f32]) -> f32 no.alloc {
    let total: f32 = 0.0
    for s in samples {
        total += s
    }
    return total
}

fn borrowed() -> i32 {
    let samples = Host.samples()
    if len(samples) != 1024 {
        return 10
    }
    if samples[2] != 1.0 {
        return 11
    }
    if totalOf(samples) != 261888.0 {
        return 12
    }

    // Writing through the view writes the host's memory, because there is
    // only one copy of it.
    samples[0] = 99.5
    if Host.sample(0) != 99.5 {
        return 13
    }
    return 0
}
