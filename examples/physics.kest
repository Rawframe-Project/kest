module examples.physics

import std.io

import std.math

import std.vec

// The frame step the predecessor research used to measure what an object
// graph costs: helpers that take and return vectors, called from a hot path.
// D006 is the decision that lets this keep its shape, and the bytecode shows
// what it costs: a field is an offset, and building a vector is the values
// already being on the stack.
//
// The vector itself comes from `std.vec` rather than being declared here.
// Four examples used to each write their own, which is what a library is for.

struct Body {
    position: vec.Vec3
    velocity: vec.Vec3
}

const GRAVITY: f32 = -9.81

fn accelerate(b: Body, dt: f32) -> Body no.alloc {
    let pull = vec.Vec3(0.0, GRAVITY * dt, 0.0)
    return Body(b.position, vec.add(b.velocity, pull))
}

fn integrate(b: Body, dt: f32) -> Body no.alloc {
    return Body(vec.add(b.position, vec.scale(b.velocity, dt)), b.velocity)
}

fn step(b: Body, dt: f32) -> Body no.alloc {
    return integrate(accelerate(b, dt), dt)
}

// Damping that does not depend on the frame rate. Multiplying by a fraction
// every frame halves a speed twice as fast at sixty frames as at thirty, which
// is a simulation that changes when the machine does; a fraction raised to the
// step keeps the second the same whatever the step is. In `f32`, because that
// is what a frame is in.
fn damp(b: Body, keep: f32, dt: f32) -> Body no.alloc {
    return Body(b.position, vec.scale(b.velocity, math.pow(keep, dt)))
}

// The normal of a face, which is what a cross product is for: two edges of a
// triangle, and the direction standing off both of them. Three points in a
// line have no face and no normal, which `direction` answers by giving
// nothing rather than by handing back a zero (D013).
fn normal(a: vec.Vec3, b: vec.Vec3, c: vec.Vec3) -> vec.Vec3? no.alloc {
    return vec.direction(vec.cross(vec.sub(b, a), vec.sub(c, a)))
}

// Moving into a face or away from it, which is the one thing a bounce has to
// know before it is a bounce.
fn into(b: Body, face: vec.Vec3) -> bool no.alloc {
    return vec.dot(b.velocity, face) < 0.0
}

// Whether two vectors point the same way, which is the property a direction
// has that a length does not: it does not depend on how long the vector was.
// A position kept in `f64` and bounced between two walls, which is what a
// simulation that cannot carry `f32`'s drift writes. The walls are weighed both
// ways round, and what a step came to against the speed, because each is an
// instruction of its own (D1165), and the step and what it came to are sums of
// two locals (D1166).
fn bounced(at: f64, speed: f64, steps: i32) -> f64 no.alloc {
    let x = at
    let v = speed
    let wall: f64 = 10.0
    let near: f64 = 0.0
    for i in 0..steps {
        let was = x
        x += v
        if x <= 0.0 || x >= wall {
            v = 0.0 - v
        }
        if x >= 10.0 || x <= 0.5 {
            near += 1.0
        }
        let moved = x - was
        if moved <= v {
            near += 0.25
        }
    }
    return near * 100.0 + x
}

fn sameDirection(a: vec.Vec2, b: vec.Vec2) -> bool no.alloc {
    if let one = vec.direction(a) {
        if let two = vec.direction(b) {
            return one.x == two.x && one.y == two.y
        }
    }
    return false
}

fn main() -> i32 {
    let body = Body(vec.Vec3(0.0, 100.0, 0.0), vec.Vec3(1.0, 0.0, 0.0))
    let dt = 0.01

    let current = body
    for i in 0..100 {
        current = step(current, dt)
    }

    if current.position.x < 0.99 {
        return 1
    }
    if current.position.y > 100.0 {
        return 2
    }
    if vec.lengthSquared(current.velocity) < 1.0 {
        return 3
    }
    // The three-dimensional halves of the same two, which nothing had run:
    // how far apart two points are, and the point a quarter of the way from
    // one to the other.
    if math.abs(vec.distance(vec.Vec3(0.0, 0.0, 0.0), vec.Vec3(0.0, 3.0, 4.0)) -
        5.0) > 0.0001 {
        return 12
    }
    let quarter = vec.lerp(
        vec.Vec3(0.0, 0.0, 0.0),
        vec.Vec3(4.0, 8.0, 0.0),
        0.25
    )
    if quarter.x != 1.0 || quarter.y != 2.0 {
        return 13
    }
    if math.abs(vec.length(vec.Vec3(3.0, 4.0, 0.0)) - 5.0) > 0.0001 {
        return 4
    }

    // The cheap form of how far apart two things are, which is the question a
    // frame asks: which of two is nearer, and is it inside a radius. Both of
    // those order the same way without the square root.
    let here = vec.Vec2(1.0, 1.0)
    let near = vec.Vec2(2.0, 1.0)
    let away = vec.Vec2(1.0, 5.0)
    if vec.distanceSquared(here, near) != 1.0 {
        return 20
    }
    if vec.distanceSquared(here, away) != 16.0 {
        return 21
    }
    let origin = vec.Vec3(0.0, 0.0, 0.0)
    if vec.distanceSquared(origin, vec.Vec3(0.0, 3.0, 4.0)) != 25.0 {
        return 22
    }

    // Which side of one vector another is on, which is the whole of a cross in
    // two dimensions: nought when they lie along each other, and otherwise the
    // `z` the three-dimensional one would have given back.
    if vec.cross(vec.Vec2(1.0, 0.0), vec.Vec2(0.0, 1.0)) != 1.0 {
        return 23
    }
    if vec.cross(vec.Vec2(1.0, 0.0), vec.Vec2(0.0 - 1.0, 0.0)) != 0.0 {
        return 24
    }
    let spun = vec.cross(vec.Vec3(1.0, 2.0, 0.0), vec.Vec3(3.0, 4.0, 0.0))
    if spun.z != vec.cross(vec.Vec2(1.0, 2.0), vec.Vec2(3.0, 4.0)) {
        return 25
    }

    // And a length the width holds is a length this answers with: the square
    // of a vector of 1e20s is infinity, where the vector's own length is
    // 1.41e20 and an `f32` holds that without trouble.
    let vast = vec.Vec2(100000000000000000000.0, 100000000000000000000.0)
    let across = vec.length(vast) / 100000000000000000000.0
    if !math.isNumber(vec.length(vast)) {
        return 31
    }
    if math.abs(across - 1.4142135) > 0.0001 {
        return 32
    }
    if math.isNumber(vec.lengthSquared(vast)) {
        return 33
    }

    // A direction is the same direction whatever size the vector is, which is
    // what squaring it lost: a vector of 1e20s came back as (0, 0), which is
    // not a direction and did not say so, and a vector of 1e-21s came back a
    // thousandth short of a length of one.
    let same = vec.Vec2(1.0, 1.0)
    if !sameDirection(
        same,
        vec.Vec2(100000000000000000000.0, 100000000000000000000.0)
    ) {
        return 26
    }
    if !sameDirection(
        same,
        vec.Vec2(0.000000000000000000001, 0.000000000000000000001)
    ) {
        return 27
    }
    // And a component no `f32` holds is not a direction at all.
    let most: f32 = 340282350000000000000000000000000000000.0
    if vec.direction(vec.Vec2(most * 10.0, 1.0)) != none {
        return 28
    }
    if let pointing = vec.direction(vec.Vec3(
        100000000000000000000.0,
        0.0,
        100000000000000000000.0
    )) {
        if math.abs(vec.length(pointing) - 1.0) > 0.0001 {
            return 29
        }
    } else {
        return 30
    }

    // The `f32` shapes of what a body is made of: an angle is an `f32` here
    // and everywhere else in a frame, so asking for its sine should not mean
    // widening it by hand.
    let angle: f32 = 1.5
    if math.abs(math.sin(angle) * math.sin(angle) +
        math.cos(angle) * math.cos(angle) -
        1.0) > 0.0001 {
        return 5
    }
    // A tangent is a sine over a cosine, and an angle whose sine is that is
    // the angle back: the two the library writes out of what it declares,
    // checked against the two it declares.
    if math.abs(math.tan(angle) - math.sin(angle) / math.cos(angle)) > 0.0001 {
        return 6
    }
    if let back = math.asin(math.sin(f64(0.5))) {
        if math.abs(back - 0.5) > 0.0001 {
            return 7
        }
    } else {
        return 8
    }
    // And the other two ways an angle comes back: where a cosine points, and
    // where a slope does, in both widths. A turn of a quarter is `atan(1.0)`
    // times two, which is the same number `acos(0.0)` is.
    if let square = math.acos(f64(0.0)) {
        if math.abs(square - math.atan(f64(1.0)) * 2.0) > 0.0000001 {
            return 7
        }
    } else {
        return 8
    }
    let slope: f32 = 1.0
    if math.abs(math.atan(slope) * 4.0 - 3.1415927) > 0.0001 {
        return 7
    }
    // Nothing outside -1 to 1 has an angle, which is a question with no
    // answer rather than a number made up to fill the gap.
    if math.asin(2.0) != none {
        return 9
    }
    if math.round(current.position.x) != math.floor(current.position.x + 0.5) {
        return 10
    }
    // A number in a line of text is written the shortest way that reads back
    // as the same one, so a log says what is there rather than how wide it is
    // stored: nine digits for an `f32` that needs nine and eight for one that
    // needs eight.
    if "{1.0 / 3.0}" != "0.33333334" {
        return 7
    }
    if "{1.0 / 4.0}" != "0.25" {
        return 8
    }
    if "{current.position.x * 0.0}" != "0.0" {
        return 9
    }

    // A triangle on the floor, walked the way it is wound: the normal stands
    // off it, and its length is one because a direction is a direction.
    let corner = vec.Vec3(0.0, 0.0, 0.0)
    if let up = normal(
        corner,
        vec.Vec3(0.0, 0.0, 1.0),
        vec.Vec3(1.0, 0.0, 0.0)
    ) {
        if up.x != 0.0 || up.y != 1.0 || up.z != 0.0 {
            return 10
        }
    } else {
        return 11
    }

    // Wound the other way, the same triangle faces the other way.
    if let down = normal(
        corner,
        vec.Vec3(1.0, 0.0, 0.0),
        vec.Vec3(0.0, 0.0, 1.0)
    ) {
        if down.y != -1.0 {
            return 12
        }
    } else {
        return 13
    }

    // Three points in a line are not a face.
    if normal(corner, vec.Vec3(1.0, 0.0, 0.0), vec.Vec3(2.0, 0.0, 0.0)) !=
            none {
        return 14
    }

    let falling = Body(vec.Vec3(0.0, 1.0, 0.0), vec.Vec3(0.0, -1.0, 0.0))
    if !into(falling, vec.Vec3(0.0, 1.0, 0.0)) {
        return 15
    }
    if into(falling, vec.Vec3(0.0, -1.0, 0.0)) {
        return 16
    }

    // Half the speed a second, asked for as one second and as two halves of
    // one, which is the whole reason the step is an exponent.
    let moving = Body(vec.Vec3(0.0, 0.0, 0.0), vec.Vec3(1.0, 0.0, 0.0))
    if math.abs(damp(moving, 0.5, 1.0).velocity.x - 0.5) > 0.0001 {
        return 17
    }
    let twice = damp(damp(moving, 0.5, 0.5), 0.5, 0.5)
    if math.abs(twice.velocity.x - 0.5) > 0.0001 {
        return 18
    }
    if damp(moving, 1.0, 0.5).velocity.x != 1.0 {
        return 19
    }

    if bounced(1.0, 3.0, 10) != 432.0 {
        return 20
    }

    io.print("one second of falling, and the vectors kept their shape")
    return 0
}
