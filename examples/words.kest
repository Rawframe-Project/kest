module examples.words

import std.io
import std.sort
import std.text

// Text is its bytes. `len` counts them, `t[i]` reads one as a `u8`, and two
// pieces compare by them. There is no character type and nothing here pretends
// to decode one: `hız` is four bytes and the program that wants three
// characters has to say what it means by a character.

fn isVowel(byte: u8) -> bool no.alloc {
    if byte == 'a' || byte == 'e' || byte == 'i' {
        return true
    }
    return byte == 'o' || byte == 'u'
}

fn vowels(word: text) -> i32 no.alloc {
    let count = 0
    for i in 0..len(word) {
        if isVowel(word[i]) {
            count += 1
        }
    }
    return count
}

fn first(words: [text]) -> text? no.alloc {
    if len(words) == 0 {
        return none
    }
    let best = words[0]
    for word in words {
        if word < best {
            best = word
        }
    }
    return best
}

// A comparison of its own, which is the whole point of being told rather
// than deciding: this one is `no.alloc` and so the sort stays one too.
fn byVowels(a: text, b: text) -> bool no.alloc {
    return vowels(a) < vowels(b)
}

fn main() -> i32 {
    let words = ["smith", "guard", "cook", "herald"]

    if vowels("guard") != 2 {
        return 1
    }
    if len("hız") != 4 {
        return 2
    }

    if let earliest = first(words) {
        if earliest != "cook" {
            return 3
        }
    } else {
        return 4
    }

    // What comes first is a function value, so the sort does not have to
    // know and the caller does not have to write one.
    sort.sort(words, sort.ascending)
    if words[0] != "cook" {
        return 5
    }
    if words[3] != "smith" {
        return 6
    }

    sort.sort(words, sort.descending)
    if words[0] != "smith" {
        return 7
    }

    // Insertion keeps what was already in order, so the three words with two
    // vowels stay in the order the last sort left them.
    sort.sort(words, byVowels)
    if words[0] != "smith" {
        return 8
    }
    if words[3] != "cook" {
        return 9
    }

    io.print("by vowels: {text.join(words, " ")}")
    return 0
}
