module examples.game.npc

// A `const` crosses out of the file it is in, so this is what `game.kest`
// counts a full guard's health with rather than writing 30 of its own. See
// D665.
const FULL: i32 = 30

// And one a count reads. A `[T; N]` is resolved before the constants are
// symbols, so a count naming one from another module is answered by finding
// the file this module is — which is what makes `[Npc; npc.PARTY]` in the file
// beside this one a thing a program may write. See D681.
const PARTY: i32 = 3

struct Npc {
    name: text
    health: i32
}

fn hurt(npc: Npc, amount: i32) -> Npc no.alloc {
    return Npc(npc.name, npc.health - amount)
}

fn alive(npc: Npc) -> bool no.alloc {
    return npc.health > 0
}

// And an enum, which is the one kind of declaration that crossed out of a file
// halfway. A program could take one of these and `match` it and could not make
// one: the name in front of the case was read as a value where it stands for a
// type, so `npc.Mood.Calm` was `npc` having nothing called `Mood`. A world
// written in more than one file puts its states in the module the thing is in,
// so this was every such program. See D1062.
enum Mood {
    Calm
    Wary
    Fleeing(i32)
}

fn mood(npc: Npc) -> Mood no.alloc {
    if npc.health <= 0 {
        return Mood.Fleeing(0)
    }
    if npc.health < FULL / 2 {
        return Mood.Wary
    }
    return Mood.Calm
}
