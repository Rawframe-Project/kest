]

fn named() -> bool {
    let a = C
    let b = C
    return a[31][31][31] && b[0][0][0]
}

fn worked() -> i32 {
    let both = [C, C]
    return len(both)
}

fn main() -> i32 {
    return if named() -> worked() - 2 else -> 1
}
