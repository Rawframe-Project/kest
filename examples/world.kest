module examples.world

import std.math

// What a struct is and what an array is, in one program. A struct is a value,
// so copying `World` copies its fields. An array is a handle, so the copy and
// the original name the same elements. Writing through a path that crosses an
// array is visible; writing to a copy is not, and the compiler says so.

struct Vec2 {
    x: f32
    y: f32
}

struct Enemy {
    position: Vec2
    health: i32
}

struct World {
    enemies: [Enemy]
    tick: i32
}

// The position is asked for, because writing back needs it: the loop's `e` is
// a copy and `w.enemies[i]` is the element.
// `math.max` and `math.min` are one name each. Which is meant is settled by
// what is passed, so an `i32` here and an `f32` below reach different bodies
// without either being spelled differently.
fn damageAll(w: World, amount: i32) {
    for i, e in w.enemies {
        w.enemies[i].health = math.max(e.health - amount, 0)
    }
}

fn living(w: World) -> i32 {
    let count = 0
    for e in w.enemies {
        if e.health > 0 {
            count += 1
        }
    }
    return count
}

// Counting is an integer and averaging is not, and nothing crosses between
// them on its own: naming a type makes one, the same way naming a struct does.
fn averageHeight(w: World) -> f32 no.alloc {
    let total: f32 = 0.0
    for e in w.enemies {
        total += e.position.y
    }
    if len(w.enemies) == 0 {
        return 0.0
    }
    return total / f32(len(w.enemies))
}

fn main() -> i32 {
    let near = Enemy(Vec2(0.0, 0.0), 30)
    let middle = Enemy(Vec2(1.0, 1.0), 40)
    let far = Enemy(Vec2(2.0, 2.0), 5)
    let w = World([near, middle, far], 0)

    w.enemies[1].position.y += 2.5
    if w.enemies[1].position.y != 3.5 {
        return 1
    }

    damageAll(w, 10)
    if living(w) != 2 {
        return 2
    }

    // `w` went in by value, so the array handle was copied and the elements
    // it names were not.
    if w.enemies[2].health != 0 {
        return 3
    }

    // Three enemies at 0.0, 3.5 and 2.0: an average with no exact spelling,
    // which is what a range is for.
    if math.abs(averageHeight(w) - 1.8333333) > 0.001 {
        return 4
    }
    if math.min(averageHeight(w), 1.0) != 1.0 {
        return 5
    }
    print("{len(w.enemies)} enemies, {living(w)} standing, average height {averageHeight(w)}")
    return 0
}
