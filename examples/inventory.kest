module examples.inventory

import std.io
import std.table
import std.text
import std.sort
import std.math

// A container written in Kest rather than built into the language. `[T]`,
// `store<T>` and `ref<T>` were the only shapes that took a type; a program can
// write its own now, and a copy is compiled per set it is used with (D040).
//
// `std.table` is a hash table, and the one thing it needs from the language is
// `hash`, which applies exactly where `==` does (D042). A key that does not
// compare is refused where the copy is made rather than everywhere.

enum Kind {
    Weapon
    Tool
    Potion(i32)
}

struct Item {
    name: text
    price: i32
}

// A place on a map, and the shape of a key this table could not hold until
// D874: a value laid out flat compares and hashes, so a struct is a key like
// any other. A struct holding a `[T]` still is not, because what would be
// compared then is the handle.
struct At {
    x: i32
    y: i32
}

// What a lookup is worth where the value is used rather than checked: a name
// that is not in stock adds nothing, which is what `if let` says and what a
// fallback could not — `table.get` took an `Item("", 0)` beside the key until
// D879, and a missing name then added that one's price. See D879.
fn total(stock: table.Table<text, Item>, names: [text]) -> i32 no.alloc {
    let sum = 0
    for i in 0..len(names) {
        if let one = table.get(stock, names[i]) {
            sum += one.price
        }
    }
    return sum
}

fn main() -> i32 {
    let stock: table.Table<text, Item> = table.empty()
    table.set(stock, "sword", Item("sword", 1200))
    table.set(stock, "rope", Item("rope", 40))
    table.set(stock, "lamp", Item("lamp", 90))

    if table.count(stock) != 3 {
        return 1
    }
    if table.orElse(stock, "rope", Item("", 0)).price != 40 {
        return 2
    }
    if table.has(stock, "boat") {
        return 3
    }

    // A key appears once, so setting it again writes over it.
    table.set(stock, "rope", Item("rope", 35))
    if table.count(stock) != 3 ||
            table.orElse(stock, "rope", Item("", 0)).price != 35 {
        return 4
    }

    // The keys in an order of this program's own. What is inside a table is
    // the table's, and is now the table's to reach: sorting `t.keys` would
    // move a key away from its value and leave the table answering with
    // somebody else's, so nothing outside `std.table` can name it. A copy is
    // what a program sorts. See D693 and D1041.
    let names = table.keysOf(stock)
    sort.by(names, sort.ascending)
    if len(names) != 3 || names[0] != "lamp" || names[2] != "sword" {
        return 18
    }
    if table.orElse(stock, "sword", Item("", 0)).price != 1200 {
        return 19
    }

    let carried: [text] = array()
    push(carried, "sword")
    push(carried, "rope")
    if total(stock, carried) != 1235 {
        return 5
    }

    if !table.remove(stock, "lamp") {
        return 6
    }
    if table.count(stock) != 2 || table.has(stock, "lamp") {
        return 7
    }

    // And one taken out from under the last one, which is the way through
    // `remove` that moves a pair: what was at the end goes into the hole, and
    // the slot pointing at it has to be found while it is still where it was.
    // Taking the last one out never goes that way, so a table that is only
    // ever shortened from the end leaves the widest thing this library does
    // unrun — which is what `KEST_DEEP` counts. See D812.
    let spare: table.Table<text, Item> = table.empty()
    table.set(spare, "shield", Item("shield", 300))
    table.set(spare, "torch", Item("torch", 5))
    if !table.remove(spare, "shield") {
        return 20
    }
    if table.count(spare) != 1 ||
            table.has(spare, "shield") ||
            table.orElse(spare, "torch", Item("", 0)).price != 5 {
        return 21
    }

    // The same table over other types, which is another copy of the same
    // bodies and nothing else.
    let counts: table.Table<i32, i32> = table.empty()
    table.set(counts, 7, 1)
    table.set(counts, 7, 2)
    if table.count(counts) != 1 || table.orElse(counts, 7, 0) != 2 {
        return 8
    }

    // Enough to make it grow more than once, and every key still found.
    for i in 0..200 {
        table.set(counts, i, i * 2)
    }
    if table.count(counts) != 200 {
        return 9
    }
    for i in 0..200 {
        if table.orElse(counts, i, 0) != i * 2 {
            return 10
        }
    }

    // Putting things in and taking them out again, over and over. What a hash
    // table gets wrong is the taking out: a slot that is emptied has to be
    // stepped past by a probe that was going further, so it is left marked,
    // and a table that is all marks holds nothing and reads slowly. Every key
    // is still found after a thousand of them, and the two that stayed are
    // still there.
    for round in 0..1000 {
        table.set(counts, 1000 + round, round)
        if !table.remove(counts, 1000 + round) {
            return 15
        }
    }
    if table.count(counts) != 200 {
        return 16
    }
    // One out from under the last one here as well. This is another copy of
    // the same body, compiled against other types, and a copy is only as run
    // as the program that calls it. See D812.
    if !table.remove(counts, 0) ||
            table.has(counts, 0) ||
            table.count(counts) != 199 {
        return 22
    }
    table.set(counts, 0, 0)
    for i in 0..200 {
        if table.orElse(counts, i, 0) != i * 2 {
            return 17
        }
    }
    if table.has(counts, 1999) {
        return 18
    }

    // The pairs are walked by their places, which are nought up to the count.
    // What order they are in is what putting them in and taking them out left,
    // which is an order and not one to lean on.
    let counted = 0
    for i in 0..table.count(counts) {
        if table.orElse(counts, table.keyAt(counts, i), 0) !=
                table.valueAt(counts, i) {
            return 19
        }
        counted += 1
    }
    if counted != table.count(counts) {
        return 20
    }

    // And over a key that is a number with a fractional part, which hashes
    // over its bits the way every other key hashes over its parts. It is the
    // one key whose equality has a value that is not equal to itself, so the
    // hash of nought is written to be the hash of nought however it was
    // signed — otherwise two keys that compare equal would sit in two places.
    let weights: table.Table<f64, i32> = table.empty()
    let half: f64 = 0.5
    let nothing: f64 = 0.0
    table.set(weights, half, 1)
    table.set(weights, nothing, 2)
    table.set(weights, 0.0 - nothing, 3)
    if table.count(weights) != 2 || table.orElse(weights, nothing, 0) != 3 {
        return 21
    }
    if table.orElse(weights, half, 0) != 1 {
        return 22
    }

    // An enum is a key like any other: it compares and it hashes, over the
    // same parts, which is what makes the two agree (D043).
    let byKind: table.Table<Kind, i32> = table.empty()
    table.set(byKind, Kind.Weapon, 1)
    table.set(byKind, Kind.Potion(3), 2)
    table.set(byKind, Kind.Potion(9), 5)
    if table.count(byKind) != 3 {
        return 11
    }
    if table.orElse(byKind, Kind.Potion(9), 0) != 5 {
        return 12
    }
    if table.has(byKind, Kind.Potion(1)) {
        return 13
    }
    // A key that is not there, asked the way the language asks it rather
    // than by handing in a number chosen not to collide with a real one.
    if table.get(byKind, Kind.Tool) != none {
        return 14
    }

    // What a person reads: a name to the left of its column and a price to the
    // right of its own, so a list of them lines up on the point rather than
    // wandering with the length of the name.
    let lines: [text] = array()
    for name in carried {
        if let one = table.get(stock, name) {
            push(
                lines,
                "{text.left(one.name, 8)}{text.right(text.fixed(f32(one.price) / 100.0, 2), 8)}"
            )
        }
    }
    if lines[0] != "sword      12.00" {
        return 15
    }
    if lines[1] != "rope        0.35" {
        return 16
    }
    if len(lines[0]) != len(lines[1]) {
        return 17
    }
    for one in lines {
        io.print(one)
    }

    // And a table whose keys are a struct, which is what a world keyed by a
    // place is: `At(1, 2)` is the key rather than a handle to one, so two of
    // them holding the same numbers are one key and the second `set` writes
    // over the first. What a table wants of a key is `hash` and `==`, and a
    // value laid out flat has both. See D874.
    let ground: table.Table<At, text> = table.empty()
    table.set(ground, At(1, 2), "hill")
    table.set(ground, At(3, 4), "lake")
    if table.get(ground, At(9, 9)) != none {
        return 23
    }
    if let there = table.get(ground, At(1, 2)) {
        if there != "hill" {
            return 24
        }
    } else {
        return 24
    }
    table.set(ground, At(1, 2), "ridge")
    if table.count(ground) != 2 {
        return 25
    }
    if let there = table.get(ground, At(1, 2)) {
        if there != "ridge" {
            return 26
        }
    } else {
        return 26
    }
    if !table.has(ground, At(3, 4)) || table.has(ground, At(4, 3)) {
        return 25
    }

    // What a table counts is what it can find. A key is one key because
    // `hash` and `==` say so, and a value that is not equal to itself is a
    // different key every time it is handed over — so a table given one would
    // count a pair nothing could find and never be able to take it out. It is
    // not put in. See D893.
    let places: table.Table<f32, text> = table.empty()
    table.set(places, 1.5, "half past one")
    table.set(places, math.sqrt(0.0 - 1.0), "nowhere")
    if table.count(places) != 1 {
        return 27
    }
    for at in 0..table.count(places) {
        if !table.has(places, table.keyAt(places, at)) {
            return 28
        }
    }

    // And the pairs in step, which is what makes walking them instead of
    // asking worth anything: the value at a place is that place's key's.
    for at in 0..table.count(stock) {
        if table.valueAt(stock, at).name != table.keyAt(stock, at) {
            return 29
        }
    }

    // A world that spiked and came back down. A table keeps room for what it
    // has held, because a table that shrank on every removal would make a
    // frame's cost depend on what that frame took out -- so giving the room
    // back is a thing a program asks for, on a cold path, and what it gets is
    // a new table rather than a smaller one.
    let spike: table.Table<i32, i32> = table.empty()
    for i in 0..2000 {
        table.set(spike, i, i * 2)
    }
    for i in 20..2000 {
        table.remove(spike, i)
    }
    if table.count(spike) != 20 {
        return 30
    }
    spike = table.compact(spike)
    if table.count(spike) != 20 {
        return 31
    }
    for at in 0..table.count(spike) {
        if table.orElse(spike, table.keyAt(spike, at), 0 - 1) !=
                table.valueAt(spike, at) {
            return 32
        }
    }

    io.print("{table.count(stock)} kinds carried, worth {total(stock, carried)}")
    return 0
}
