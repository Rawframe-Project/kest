module examples.grow

import std.io

// An array whose size nobody wrote down. `array(n, v)` makes one of `n` of
// `v`, and `push` puts one more on the end. Both reach the heap, so a frame
// step can read an array and cannot build one, which the compiler proves.

struct Sample {
    at: i32
    value: f32
}

fn collect(count: i32) -> [Sample] {
    let samples: [Sample] = array()
    // Room for what is coming, said to an array that already exists. A loop
    // that pushes without asking ends with room for the next power of two,
    // and one that asks first takes one block and fills it. What it does not
    // change is what is in it or how many there are — `len` is nought here
    // before and after. See D912.
    room(samples, count)
    for i in 0..count {
        push(samples, Sample(i, f32(i) * 0.5))
    }
    return samples
}

fn total(samples: [Sample]) -> f32 no.alloc {
    let sum: f32 = 0.0
    for s in samples {
        sum += s.value
    }
    return sum
}

fn highest(samples: [Sample]) -> Sample? no.alloc {
    if len(samples) == 0 {
        return none
    }
    let best = samples[0]
    for s in samples {
        if s.value > best.value {
            best = s
        }
    }
    return best
}

fn main() -> i32 {
    let samples = collect(9)
    if len(samples) != 9 {
        return 1
    }
    if total(samples) != 18.0 {
        return 2
    }
    if let peak = highest(samples) {
        if peak.at != 8 {
            return 3
        }
    } else {
        return 4
    }
    if len(collect(0)) != 0 {
        return 5
    }

    io.print("grew {len(samples)} samples adding up to {total(samples)}")
    return 0
}
