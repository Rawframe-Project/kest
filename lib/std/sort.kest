module std.sort

// Sorting needs to be told what comes first, and being told is a function
// value: `fn(T, T) -> bool no.alloc`. The promise is part of the type, so a
// sort that promises `no.alloc` can call one and the compiler can still prove
// it (D039).
//
// One body, one copy per type it is called with (D040). Insertion, which is
// what a frame budget wants for the short, nearly sorted lists a game has: no
// allocation, and a pass over a sorted list is one comparison per element.

// `sort.by(items, sort.ascending)`: what it is sorted by is the second thing,
// which is what the name says. It was `sort.sort`, because a module and its
// one function had a name between them, and a call read as a stammer.
fn by<T>(items: [T], before: fn(T, T) -> bool no.alloc) no.alloc {
    for i in 1..len(items) {
        let j = i
        while j > 0 && before(items[j], items[j - 1]) {
            let held = items[j]
            items[j] = items[j - 1]
            items[j - 1] = held
            j -= 1
        }
    }
}

fn ascending(a: i32, b: i32) -> bool no.alloc {
    return a < b
}

fn ascending(a: f32, b: f32) -> bool no.alloc {
    return a < b
}

fn ascending(a: text, b: text) -> bool no.alloc {
    return a < b
}

fn descending(a: i32, b: i32) -> bool no.alloc {
    return a > b
}

fn descending(a: f32, b: f32) -> bool no.alloc {
    return a > b
}

fn descending(a: text, b: text) -> bool no.alloc {
    return a > b
}
