module examples.parse

import std.io

// Reading a line of fields, out of the standard library rather than out of
// this file. `std.text` is written in Kest, not built in: `number` and `split`
// are what this example used to carry itself, and every program that read text
// would have carried again.

import std.math
import std.text

struct Field {
    name: text
    value: i32
}

fn field(entry: text) -> Field? {
    if let at = find(entry, "=") {
        if let value = text.number(slice(entry, at + 1, len(entry) - at - 1)) {
            return Field(text.trim(slice(entry, 0, at)), value)
        }
    }
    return none
}

fn fields(line: text) -> [Field] {
    let found: [Field] = array()
    for entry in text.split(line, ",") {
        if let one = field(entry) {
            push(found, one)
        }
    }
    return found
}

// The same line with a point in the numbers, which is what a position or a
// weight looks like when it comes back from a file. `real` is `number` for
// those: the same reading, the same nothing when it is not one.
fn placed(line: text) -> f32 {
    let total: f32 = 0.0
    for entry in text.split(line, ",") {
        if let at = find(entry, "=") {
            if let one = text.real(text.trim(slice(
                entry,
                at + 1,
                len(entry) - at - 1
            ))) {
                total += one
            }
        }
    }
    return total
}

// The other direction: a line written to be read back. Two places is what a
// file wants and the shortest spelling is what a log wants, which are two
// different lines for the same number.
fn line(x: f32, y: f32) -> text {
    return "x={text.fixed(x, 2)}, y={text.fixed(y, 2)}"
}

fn main() -> i32 {
    let parsed = fields("health=30, armour=12, speed=7")
    if len(parsed) != 3 {
        return 1
    }
    if parsed[0].name != "health" {
        return 2
    }
    if parsed[2].value != 7 {
        return 3
    }

    let total = 0
    for f in parsed {
        total += f.value
    }
    if total != 49 {
        return 4
    }

    if len(fields("nothing here")) != 0 {
        return 5
    }
    if len(fields("bad=x,good=1")) != 1 {
        return 6
    }

    // A point in the number is a different reading and the same shape.
    if math.abs(placed("x=1.5, y=-0.25, z=0.75") - 2.0) > 0.0001 {
        return 7
    }
    // `number` and `real` disagree about what a number is, which is the point
    // of there being two of them: one of these reads and the other does not.
    if let whole = text.number("1.5") {
        return 8
    }
    if let point = text.real("1.5") {
        if point != 1.5 {
            return 9
        }
    } else {
        return 10
    }
    // Nothing in it that is a number at all, so nothing is added.
    if placed("x=up, y=down") != 0.0 {
        return 11
    }

    // Written and read back, which is what a file is for.
    let written = line(1.5, 0.0 - 0.25)
    if written != "x=1.50, y=-0.25" {
        return 12
    }
    if math.abs(placed(written) - 1.25) > 0.0001 {
        return 13
    }

    io.print("read {len(parsed)} fields adding up to {total}, and wrote {written}")
    return 0
}
