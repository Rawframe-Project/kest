module game.path

import game.map

// A search over the ground, breadth first, from where somebody stands to the
// nearest cell that is what they want. Everything it works in is made once
// and kept: a frame that looks for a path does not reach the heap, which is
// the difference between a colony of forty and one of four thousand.
//
// `seen` holds the turn a cell was last reached on rather than whether it was,
// so a new search is a new turn and nothing has to be cleared. `came` is where
// each cell was reached from, which is the path read backwards. The four
// handles are one thing and are kept in step by this module alone.
struct Search {
    own seen: [i32]
    own came: [i32]
    own queue: [i32]
    // One number, behind a handle because a search is handed round by value
    // and the turn has to outlive the copy it was counted in.
    own turn: [i32]
}

fn over(g: map.Ground) -> Search {
    let cells = g.wide * g.high
    return Search(
        array(cells, 0),
        array(cells, -1),
        array(cells, 0),
        array(1, 0)
    )
}

// Where the search ended: the cell that was wanted, and the cell to stand on
// to reach it -- the same one for something walked onto, and a neighbour for a
// tree or a wall, which is worked from beside rather than from on top.
struct Found {
    target: i32
    stand: i32
}

const NOWHERE: Found = Found(-1, -1)

// The nearest cell whose `goals` byte is `want` and which nobody has claimed.
// `beside` says whether the cell is worked from a neighbour. Ties go to the
// order the neighbours are tried in, which is the same on every machine.
fn nearest(g: map.Ground, s: Search, from: i32, goals: [u8], want: u8, claimed: [u8], beside: bool) -> Found no.alloc no.host deterministic {
    s.turn[0] += 1
    let turn = s.turn[0]
    let head = 0
    let tail = 1
    s.queue[0] = from
    s.seen[from] = turn
    s.came[from] = -1
    if !beside && goals[from] == want && claimed[from] == 0 {
        return Found(from, from)
    }
    let wide = g.wide
    let last = g.wide * g.high
    while head < tail {
        let here = s.queue[head]
        head += 1
        let x = here % wide
        // The four neighbours as cells, worked out here rather than asked of
        // `map` a coordinate at a time: this loop is most of what a colony
        // costs, and a call a neighbour was most of what this loop cost.
        for way in 0..4 {
            let next = if way == 0 -> here + 1
                else -> if way == 1 -> here - 1
                else -> if way == 2 -> here + wide else -> here - wide
            if way == 0 && x == wide - 1 ||
                    way == 1 && x == 0 ||
                    next < 0 ||
                    next >= last {
                continue
            }
            if s.seen[next] == turn {
                continue
            }
            s.seen[next] = turn
            let wanted = goals[next] == want && claimed[next] == 0
            if wanted && beside {
                return Found(next, here)
            }
            if !map.open(g.tiles[next]) {
                continue
            }
            s.came[next] = here
            if wanted {
                return Found(next, next)
            }
            s.queue[tail] = next
            tail += 1
        }
    }
    return NOWHERE
}

// The way to `stand`, written into `route` last step first, so that the next
// step is what `pop` gives. Only good straight after the search that found it.
fn route(s: Search, stand: i32, into: [i32]) {
    clear(into)
    let at = stand
    while s.came[at] >= 0 {
        push(into, at)
        at = s.came[at]
    }
}
