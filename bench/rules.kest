module bench.rules

import std.io
import std.os
import std.text

// The third reference program, and the one that is mostly branches. Where
// `bench/frame.kest` is arithmetic over a run of numbers and `bench/agents.kest`
// is a world that is kept, this is application state: what somebody is
// carrying, what they have been asked to do, what they may do again yet, and
// the rules that read all three and decide.
//
// It is here because a simulation is not a kernel. The work is a lookup, a
// flag test, a match over what something is, an optional that may be nothing,
// a timer that has not run down, and a piece of text that names a thing —
// and a language that is quick at multiplying and slow at any of those is
// quick at the wrong half.
//
// `kest run bench/rules.kest -- 4000 200` is four thousand actors for two
// hundred rounds. It answers with which of its own checks failed and prints
// the checksum that says two runs did the same work.

const ACTORS: i32 = 4000
const ROUNDS: i32 = 200
const KINDS: i32 = 8

// What a thing is, which decides what carrying it means. Written as an enum
// rather than as a number so that the rules below are a `match` and the
// compiler knows the list is complete.
enum Kind {
    Food(i32)
    Tool(i32)
    Coin
    Note(i32)
}

// What an actor may be doing about a quest, and the one that carries a number
// is the one that has to be read out rather than tested for.
enum Task {
    Nothing
    Fetch(i32)
    Deliver(i32)
    Wait(i32)
}

// State as bits, which is what a `u8` of flags is for: eight questions in one
// byte and one test each.
flags State: u8 {
    Hungry
    Tired
    Hurt
    Rich
}

struct Item {
    name: text
    kind: Kind
    many: i32
}

struct Actor {
    name: text
    state: State
    hp: i32
    coins: i32
    // Cooldowns, one a kind, which is the collection every rule reads and the
    // one a round writes into rather than replaces.
    cools: [i32]
    bag: [Item]
    task: Task
    done: i32
}

struct Rules {
    who: [Actor]
    names: [text]
    sum: i64
}

fn nameOf(names: [text], at: i32) -> text {
    return names[at % len(names)]
}

fn kindOf(seed: i32) -> Kind {
    let which = seed % 4
    if which == 0 {
        return Kind.Food(1 + seed % 5)
    }
    if which == 1 {
        return Kind.Tool(1 + seed % 3)
    }
    if which == 2 {
        return Kind.Coin
    }
    return Kind.Note(seed % 11)
}

// What carrying one is worth, which is the `match` every rule runs through.
fn worthOf(item: Item) -> i32 no.alloc no.host deterministic {
    return match item.kind {
        Food(fills) -> fills * item.many
        Tool(power) -> power * 3
        Coin -> item.many
        Note(which) -> if which == 0 -> 0 else -> 1
    }
}

// What an actor is doing, said as a number: below nought is nothing, nought
// and up is fetching that kind, a hundred and up is delivering it, a thousand
// and up is waiting that many rounds.
fn taskNumber(what: Task) -> i32 no.alloc no.host deterministic {
    return match what {
        Nothing -> 0 - 1
        Fetch(which) -> which
        Deliver(which) -> 100 + which
        Wait(left) -> 1000 + left
    }
}

fn taskOf(said: i32) -> Task no.alloc no.host deterministic {
    if said < 0 {
        return Task.Nothing
    }
    if said >= 1000 {
        return Task.Wait(said - 1000)
    }
    if said >= 100 {
        return Task.Deliver(said - 100)
    }
    return Task.Fetch(said)
}

fn start(many: i32) -> Rules {
    let names: [text] = array()
    push(names, "bread")
    push(names, "hammer")
    push(names, "coin")
    push(names, "letter")
    push(names, "rope")
    push(names, "lamp")
    let who: [Actor] = array()
    for i in 0..many {
        let cools: [i32] = array(KINDS, 0)
        let bag: [Item] = array()
        for j in 0..1 + i % 4 {
            push(bag, Item(nameOf(names, i + j), kindOf(i + j), 1 + j))
        }
        let state = State.Hungry
        if i % 3 == 0 {
            state = state | State.Tired
        }
        if i % 7 == 0 {
            state = state | State.Hurt
        }
        push(
            who,
            Actor(
                nameOf(names, i),
                state,
                10 + i % 9,
                i % 13,
                cools,
                bag,
                Task.Nothing,
                0
            )
        )
    }
    return Rules(who, names, 0)
}

// One actor, one round. It is the shape a rules system has: read what is
// carried, test a flag, run a timer down, decide what to do next.
//
// It answers with the actor rather than writing into the one it was given,
// because an `Actor` is a value: the two runs it holds are handles and are
// shared, and `one.hp += 1` here would count into a copy that goes away when
// this returns. Writing it back is what the caller does, and a whole struct
// read out of an array, changed, and written back is the commonest shape there
// is in this kind of program -- which is why it is what this measures.
fn decide(one: Actor, round: i32, names: [text]) -> Actor {
    let worth = 0
    for item in one.bag {
        worth += worthOf(item)
    }

    // The timers, which are read every round and written in place.
    let ready = 0
    for at in 0..len(one.cools) {
        if one.cools[at] > 0 {
            one.cools[at] = one.cools[at] - 1
        } else {
            ready += 1
        }
    }

    // The flags, which are the cheapest questions here and the commonest.
    if one.state & State.Hungry == State.Hungry {
        if worth > 6 {
            one.state = one.state & ~State.Hungry
            one.hp += 1
        } else {
            one.hp -= 1
        }
    }
    if one.state & State.Hurt == State.Hurt && ready > 4 {
        one.hp += 2
        one.state = one.state & ~State.Hurt
    }
    if one.hp > 20 {
        one.hp = 20
    }

    // And the task, which is where the work with a shape rather than a number
    // is. The arms of a `match` are expressions, so what it reads out is a
    // number and the rules below are written on that -- which is the second
    // reference program to be written this way.
    let doing = taskNumber(one.task)
    let next = 0 - 1
    let did = 0
    if doing < 0 {
        next = if worth < 4 -> round % KINDS else -> 100 + round % KINDS
    } else if doing >= 1000 {
        let left = doing - 1000
        next = if left <= 1 -> 0 - 1 else -> 1000 + left - 1
    } else if doing >= 100 {
        let which = doing - 100
        if len(one.bag) > 0 {
            let last = remove(one.bag, len(one.bag) - 1)
            one.coins += worthOf(last)
            did = 1
        }
        next = if one.coins > 40 -> 1002 else -> which
    } else {
        let which = doing
        if one.cools[which % KINDS] == 0 {
            push(
                one.bag,
                Item(nameOf(names, round + which), kindOf(round + which), 1)
            )
            one.cools[which % KINDS] = 3 + which % 4
            next = 100 + which
            did = 1
        } else {
            next = 1000 + 1 + which % 3
        }
    }
    one.task = taskOf(next)
    one.done += did
    if one.coins > 60 {
        one.state = one.state | State.Rich
    }
    one.hp += worth % 3
    return one
}

fn round(all: Rules, at: i32) -> i64 {
    let sum: i64 = 0
    for i in 0..len(all.who) {
        let one = decide(all.who[i], at, all.names)
        sum += i64(one.hp) + i64(one.done) + i64(one.coins)
        all.who[i] = one
    }
    return sum
}

// What the whole of it is worth, walked the same way every time.
fn worth(all: Rules) -> i64 {
    let sum: i64 = 0
    for one in all.who {
        sum += i64(one.hp) * 3 + i64(one.coins)
        sum += i64(len(one.bag)) * 2 + i64(one.done)
        sum += i64(len(one.name))
        for item in one.bag {
            sum += i64(worthOf(item)) + i64(len(item.name))
        }
        for cool in one.cools {
            sum += i64(cool)
        }
        sum += match one.task {
            Nothing -> 0
            Fetch(which) -> i64(which) + 1
            Deliver(which) -> i64(which) + 100
            Wait(left) -> i64(left) + 1000
        }
    }
    return sum
}

fn actors() -> i32 {
    if let written = os.arg(0) {
        if let asked = text.number(written) {
            if asked > 0 {
                return asked
            }
        }
    }
    return ACTORS
}

fn rounds() -> i32 {
    if let written = os.arg(1) {
        if let asked = text.number(written) {
            if asked > 0 {
                return asked
            }
        }
    }
    return ROUNDS
}

fn main() -> i32 {
    let many = actors()
    let turns = rounds()
    let all = start(many)
    if len(all.who) != many {
        return 1
    }
    let before = worth(all)
    if before <= 0 {
        return 2
    }

    let sum: i64 = 0
    for at in 0..turns {
        sum += round(all, at)
    }
    if sum <= 0 {
        return 3
    }

    let after = worth(all)
    if after == before {
        return 4
    }

    // Everybody still holds a timer for every kind, which is the collection
    // the rules write into rather than replace: one that had been replaced
    // would be a different length.
    for one in all.who {
        if len(one.cools) != KINDS {
            return 5
        }
    }

    io.print("rules {sum} worth {after} of {many} over {turns}")
    return 0
}
