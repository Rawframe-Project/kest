module examples.state

import std.io

// A thing that is one of several, which a struct with a number in it is not:
// every case carries what that case carries, and a `match` that leaves one out
// is refused rather than falling through.
//
// What a case carries is written by position, the same way what a struct is
// built with is. The names are given where they are used, in the arm that
// answered that case.

enum Door {
    Shut
    Locked(i32)
    Open(f32)
}

enum Turn {
    Push
    Unlock(i32)
    Pull
}

fn next(door: Door, move: Turn) -> Door no.alloc {
    match door {
        Shut {
            match move {
                Push {
                    return Door.Open(1.0)
                }
                else {
                    return door
                }
            }
        }
        Locked(key) {
            match move {
                Unlock(offered) {
                    return if offered == key -> Door.Shut else -> door
                }
                else {
                    return door
                }
            }
        }
        Open(width) {
            match move {
                Pull {
                    return Door.Shut
                }
                else {
                    return Door.Open(width)
                }
            }
        }
    }
}

// Prose, which is not what `"{door}"` gives. A value's own text is the source
// that builds it, so `Door.Locked(7)` is what the value is; this is what a
// person is told. The two are different questions and both are asked.
//
// Every arm gives a value, so the match is one, and it is what the function
// returns rather than three places that each return.
fn describe(door: Door) -> text {
    return match door {
        Shut -> "shut"
        Locked(key) -> "locked with {key}"
        Open(width) -> "open {width} wide"
    }
}

fn main() -> i32 {
    let door = Door.Locked(7)
    if describe(door) != "locked with 7" {
        return 1
    }

    door = next(door, Turn.Unlock(3))
    if describe(door) != "locked with 7" {
        return 2
    }

    door = next(door, Turn.Unlock(7))
    if describe(door) != "shut" {
        return 3
    }

    door = next(door, Turn.Push)
    if describe(door) != "open 1.0 wide" {
        return 4
    }

    door = next(door, Turn.Pull)
    if describe(door) != "shut" {
        return 5
    }

    // The value's own text, which needs no function at all.
    if "{Door.Locked(7)}" != "Door.Locked(7)" {
        return 6
    }
    if "{Door.Open(1.0)}" != "Door.Open(1.0)" {
        return 7
    }
    if "{door}" != "Door.Shut" {
        return 8
    }

    io.print("{door} is {describe(door)}")
    return 0
}
