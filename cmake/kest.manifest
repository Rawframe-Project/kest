<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The command line's code page on Windows, which is UTF-8 rather than the
  system's. Every narrow call then reads and writes UTF-8: the arguments, the
  C library's fopen in the library, and the platform's own A calls. Without
  it a path holding a character outside the system's code page names another
  file or none. Read by Windows 10 version 1903 and later.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
