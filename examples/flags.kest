module examples.flags

import std.io

// Bits, which is what a `u8` of state actually is. A struct with eight `bool`
// fields is eight slots and eight compares; this is one of each, and it is
// what a host hands across the boundary anyway (D016: the layout is C's).
//
// A `flags` declaration names the set and names each bit. Which bit a name
// stands for is where it was written, so there are no powers of two to get
// wrong, and a `State` is not a `u8` and not another set: mixing two of them
// is refused rather than silently meaning something.
//
// `&` binds tighter than `==`, so `state & flag == flag` reads as one thing
// and means it. That is the one place C is known to be wrong, and D032 says
// why Kest does not repeat it.

flags State: u8 {
    Moving
    Airborne
    Hurt
    Armed
}

// The width is written rather than counted off the names, because it is what
// a host sees. Every set in this tree was over a `u8` until this one, so the
// arithmetic, the walk, the two conversions and the text of a set were held at
// one width only — and a width is the one thing about a set that a host reads.
// See D503.
flags Wide: u32 {
    First
    Second
    Third
}

// And the two widths between and above them, which a program may declare and
// nothing here had. What says they are worth having written down is that a set
// is a kind of its own to a host since D897, one kind per width — so a width
// nothing declares is a kind nothing has ever laid out.
flags Middle: u16 {
    Low
    High
}

flags Widest: u64 {
    Near
    Far
}

// Each of the four is read where it is handed over, which is what makes a
// width a kind: a set crossing a frame is laid out, and a width nothing hands
// over is a layout nothing has ever written. See D897.
fn middling(m: Middle) -> i32 no.alloc {
    return i32(u16(m))
}

fn farthest(w: Widest) -> i32 no.alloc {
    return i32(u64(w))
}

fn has(state: State, flag: State) -> bool no.alloc {
    return state & flag == flag
}

fn set(state: State, flag: State) -> State no.alloc {
    return state | flag
}

fn cleared(state: State, flag: State) -> State no.alloc {
    return state & ~flag
}

fn toggled(state: State, flag: State) -> State no.alloc {
    return state ^ flag
}

// A walk gives the flags that are there, in the order they were declared, one
// value of the set at a time. There is nothing to ask about what came out.
fn count(state: State) -> i32 no.alloc {
    let total = 0
    for flag in state {
        total += 1
    }
    return total
}

fn firstOf(state: State) -> State no.alloc {
    for flag in state {
        return flag
    }
    return State()
}

// A reference is a generation and an index packed into one number, which is
// how the runtime's own `ref<T>` is built (D014). The language can say it.
fn pack(generation: i32, index: i32) -> i64 no.alloc {
    return i64(generation) << 32 | i64(index)
}

fn generationOf(handle: i64) -> i32 no.alloc {
    return i32(handle >> 32)
}

fn indexOf(handle: i64) -> i32 no.alloc {
    return i32(handle & 4294967295)
}

fn main() -> i32 {
    let state = set(set(State(), State.Moving), State.Armed)
    if !has(state, State.Moving) {
        return 1
    }
    if has(state, State.Hurt) {
        return 2
    }
    if count(state) != 2 {
        return 3
    }

    state = set(state, State.Hurt)
    if count(state) != 3 {
        return 4
    }
    state = cleared(state, State.Moving)
    if has(state, State.Moving) || !has(state, State.Armed) {
        return 5
    }
    state = toggled(state, State.Airborne)
    if !has(state, State.Airborne) {
        return 6
    }
    if toggled(state, State.Airborne) != cleared(state, State.Airborne) {
        return 7
    }

    // Every bit of a `u8` is eight of them, not the slot's sixty-four, so
    // the complement of the empty set is every flag the width can hold.
    if u8(~State()) != 255 {
        return 8
    }
    if State(u8(9)) != State.Moving | State.Armed {
        return 13
    }
    // A left shift wraps at the declared width the way every other
    // arithmetic does (D018).
    if u8(1) << 8 != 0 {
        return 9
    }
    // A signed shift right keeps the sign; an unsigned one does not.
    let below: i8 = 0 - 16
    if below >> 2 != 0 - 4 {
        return 10
    }
    if u8(240) >> 4 != 15 {
        return 11
    }
    // A count at or past the width is where C stops having an answer and this
    // language has one: everything is shifted out, and what is left is what
    // the sign says. Nought going up, and all of the sign coming down.
    let one: i64 = 1
    if one << 64 != 0 || one << 100 != 0 {
        return 15
    }
    let under: i64 = 0 - 8
    if under >> 64 != 0 - 1 || under >> 100 != 0 - 1 {
        return 16
    }
    if one >> 64 != 0 {
        return 17
    }

    if firstOf(state) != State.Airborne {
        return 14
    }
    if firstOf(State()) != State() {
        return 15
    }
    // What was walked is what was there.
    let rebuilt = State()
    for flag in state {
        rebuilt = rebuilt | flag
    }
    if rebuilt != state {
        return 16
    }

    let handle = pack(3, 41)
    if generationOf(handle) != 3 || indexOf(handle) != 41 {
        return 12
    }

    // The text of a set is the source that builds it, which is what the
    // text of every other value already is.
    if "{State.Moving | State.Hurt}" != "State.Moving | State.Hurt" {
        return 17
    }
    if "{State()}" != "State()" {
        return 18
    }

    // The same set of rules over a wider one. A bit past the eighth is where
    // a set kept in a `u8` underneath would say the wrong thing, and the two
    // conversions are the ones a host uses to read and write the bits.
    let wide = Wide.First | Wide.Third
    if wide & Wide.Second != Wide() {
        return 19
    }
    if wide & Wide.Third != Wide.Third {
        return 20
    }
    if u32(wide) != 5 {
        return 21
    }
    if Wide(u32(wide)) != wide {
        return 22
    }
    let walked = Wide()
    let seen = 0
    for bit in wide {
        walked = walked | bit
        seen += 1
    }
    if seen != 2 || walked != wide {
        return 23
    }
    if "{wide}" != "Wide.First | Wide.Third" {
        return 24
    }

    // The two widths between and above, each held to the same three rules: the
    // bits it was given, the number underneath, and the way back.
    let middle = Middle.Low | Middle.High
    if u16(middle) != 3 || Middle(u16(middle)) != middle {
        return 25
    }
    if middle & Middle.High != Middle.High || middling(middle) != 3 {
        return 26
    }
    let widest = Widest.Far
    if u64(widest) != 2 || Widest(u64(widest)) != widest {
        return 27
    }
    if widest & Widest.Near != Widest() || farthest(widest) != 2 {
        return 28
    }
    // A set kept in an array is a field in memory at the width it was
    // declared over, and read back is what was written: the bytes after it
    // belong to the next field, which a set read as a whole slot took for
    // its own. Flat, and beside a tag, which moves by other steps.
    let kept: [Kept] = array()
    push(kept, Kept(State.Hurt, Middle.High, Wide.Third, 123456, Fate.Held(7)))
    let back = kept[0]
    if back.state != State.Hurt ||
            back.middle != Middle.High ||
            back.wide != Wide.Third ||
            back.after != 123456 {
        return 29
    }
    back.state = State.Armed
    back.after = 99
    kept[0] = back
    if kept[0].state != State.Armed || kept[0].after != 99 {
        return 30
    }
    let flat: [Flat] = array()
    push(flat, Flat(State.Moving, 654321))
    if flat[0].state != State.Moving || flat[0].after != 654321 {
        return 31
    }

    io.print("{state} is {count(state)} flags, and a handle is {handle}")
    return 0
}

enum Fate {
    Free
    Held(i32)
}

struct Kept {
    state: State
    middle: Middle
    wide: Wide
    after: i32
    fate: Fate
}

struct Flat {
    state: State
    after: i32
}
