module examples.game

import std.io

// `import examples.game.npc` reads `game/world.kest` beside this file. Its names live
// under `npc`, which is the last part of what it calls itself, so where a
// name came from is written at every use of it.

import examples.game.npc

fn main() -> i32 {
    let guard: npc.Npc = npc.Npc("guard", 30)
    let hit = npc.hurt(guard, 12)

    if hit.health != 18 {
        return 1
    }
    if !npc.alive(hit) {
        return 2
    }
    if npc.alive(npc.hurt(hit, 18)) {
        return 3
    }

    io.print("{hit.name} is at {hit.health}, and the module said so")
    return 0
}
