module examples.host

import std.io

// `extern` declares what the host provides. Nothing about it is inferred: what
// it takes, what it returns and whether it allocates are all written down,
// because its body is not here to be read. The command line binds these three;
// an engine embedding Kest binds its own.

extern fn Host.sqrt(value: f64) -> f64 no.alloc
extern fn Host.write(value: text)
extern fn Host.clock() -> i64 no.alloc

fn hypotenuse(a: f64, b: f64) -> f64 no.alloc {
    return Host.sqrt(a * a + b * b)
}

// What `defer` is for. A function that takes something from the host has to
// give it back on every way out, and the ways out multiply: three checks here
// and three places to remember. Written once, next to what it undoes, it
// cannot be forgotten by a `return` added later.
//
// The order is the reverse of the order it was written, which is the order
// that undoes things in: what was taken last is given back first.
fn measured(a: f64, b: f64) -> i32 {
    Host.write("[")
    defer Host.write("]")

    let side = hypotenuse(a, b)
    if side <= 0.0 {
        return 1
    }
    Host.write("ok")
    if side > 1000.0 {
        return 2
    }
    return 0
}

fn main() -> i32 {
    let d: f64 = hypotenuse(3.0, 4.0)
    if d != 5.0 {
        return 1
    }

    Host.write("crossed the boundary and came back with ")
    io.print("{d}")

    let before = Host.clock()
    let total: f64 = 0.0
    for i in 0..1000 {
        total = total + hypotenuse(1.0, 1.0)
    }
    if Host.clock() < before {
        return 2
    }
    if total < 1414.0 {
        return 3
    }

    // Three ways out of `measured`, and the bracket closes on all of them.
    if measured(3.0, 4.0) != 0 {
        return 4
    }
    if measured(0.0, 0.0) != 1 {
        return 5
    }
    if measured(900.0, 900.0) != 2 {
        return 6
    }
    io.print("")

    let few: [f32] = array()
    push(few, 1.0)
    push(few, 2.0)
    push(few, 9.0)
    // Two turns fall off the end and the third leaves through a `return`,
    // which closes the turn and then the function.
    if scanned(few, 5.0) != 2 {
        return 7
    }
    io.print("")

    let borrow = borrowed()
    if borrow != 0 {
        return borrow
    }
    return 0
}

// The ways out multiply once there are loops. Each turn of a loop is a block,
// so what it defers runs at the end of that turn — including when the turn
// ends early — and a `return` from inside runs everything still outstanding,
// innermost first.
fn scanned(samples: [f32], limit: f32) -> i32 {
    Host.write("<")
    defer Host.write(">")

    let seen = 0
    for i in 0..len(samples) {
        Host.write(".")
        defer Host.write(",")
        if samples[i] > limit {
            return seen
        }
        if i == 3 {
            break
        }
        seen += 1
    }
    return seen
}

// One crossing carries a view of memory the host owns. Nothing is copied at
// the boundary: reading `samples[i]` reads the host's `float`, because a Kest
// `f32` is the same four bytes. D007 measured this shape at 1.05x across five
// languages and the per-value shape at 9.63x, which is why it is the one the
// language makes easy.
// Lending is not free of the heap even though nothing is copied: what crosses
// is a handle, and a handle is made out of the program's own memory. So this
// one promises nothing, and `Host.sample` beside it — which hands back a
// number — promises what it can keep.
extern fn Host.samples() -> [f32]
extern fn Host.sample(index: i32) -> f32 no.alloc

fn totalOf(samples: [f32]) -> f32 no.alloc {
    let total: f32 = 0.0
    for s in samples {
        total += s
    }
    return total
}

fn borrowed() -> i32 {
    let samples = Host.samples()
    if len(samples) != 1024 {
        return 10
    }
    if samples[2] != 1.0 {
        return 11
    }
    if totalOf(samples) != 261888.0 {
        return 12
    }

    // Writing through the view writes the host's memory, because there is
    // only one copy of it.
    samples[0] = 99.5
    if Host.sample(0) != 99.5 {
        return 13
    }
    return 0
}
