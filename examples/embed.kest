module examples.embed

import std.io

// A world the host keeps between frames. Nothing here writes to a global,
// because there are none: the store is made once, handed back, and handed in
// again every frame. What holds it is the host.

struct Npc {
    name: text
    health: i32
}

// What the host sends in. The byte layout of an enum is what a C tagged union
// is — a four byte tag at nought and the payload after it at its own
// alignment (D026) — so the host lends an array of them and nothing is copied
// at the boundary (D016). `embed.c` beside this declares the same shape in C.
enum Event {
    Idle
    Moved(f32, f32)
    Hit(i32)
    Named(text)
}

// A struct with a run inside it, which is what a host lends when its own type
// has an array in it. `[f32; 3]` is three where it stands (D064), so this is
// twelve bytes and the host's `struct { float at[3]; }` is the same twelve.
// A run on its own cannot be lent: a lend names a type and only a declared
// one has a name, which is what this struct is for.
struct Point {
    at: [f32; 3]
}

fn spread(points: [Point]) -> f32 no.alloc {
    let least = points[0].at[0]
    let most = points[0].at[0]
    for i in 0..len(points) {
        for one in points[i].at {
            if one < least {
                least = one
            }
            if one > most {
                most = one
            }
        }
    }
    return most - least
}

// Reading the host's memory as what it is. Nothing here allocates, so a whole
// batch crosses once and is walked in place.
fn onEvents(events: [Event]) -> i32 no.alloc {
    let damage = 0
    for e in events {
        damage += match e {
            Idle -> 0
            Moved(x, y) -> i32(x + y)
            Hit(amount) -> amount
            Named(what) -> len(what)
        }
    }
    return damage
}

// Writing through the view writes the host's memory, because there is only
// one copy of it. A tag written here is a tag the host reads.
fn silence(events: [Event], at: i32) -> bool no.alloc {
    if at < 0 || at >= len(events) {
        return false
    }
    events[at] = Event.Idle
    return true
}

fn create() -> store<Npc> {
    return store()
}

fn spawn(world: store<Npc>, health: i32) -> i32 {
    add(world, Npc("npc", health))
    return len(world)
}

// A frame: everything alive loses a point and everything at nothing is gone.
// It walks, reads, writes and removes, and allocates nothing.
// The host decides what a step costs, and its answer may come back through
// this program: `embed.c` binds this and calls `rule` from inside it, which
// is a host calling in from inside a call it was called from (D072). The
// promise is the host's to keep, because an extern is judged by what it
// declares.
extern fn Engine.decide(health: i32) -> i32 no.alloc

fn rule(health: i32) -> i32 no.alloc {
    return if health > 3 -> 2 else -> 1
}

fn step(world: store<Npc>) -> i32 no.alloc {
    let alive = 0
    for r in world {
        if let npc = get(world, r) {
            let hit = Engine.decide(npc.health)
            if npc.health <= hit {
                remove(world, r)
            } else {
                set(world, r, Npc(npc.name, npc.health - hit))
                alive += 1
            }
        }
    }
    return alive
}

// Running this file on its own does one frame of what the host beside it does
// ten of.
fn main() -> i32 {
    let world = create()
    spawn(world, 3)

    // The same shapes without a host, so this file says what it does on its
    // own as well as under `embed.c`.
    let points: [Point] = array()
    push(points, Point([1.0, 2.0, 3.0]))
    push(points, Point([0.0, 9.0, 4.0]))
    if spread(points) != 9.0 {
        return 4
    }

    let events: [Event] = array()
    push(events, Event.Hit(4))
    push(events, Event.Moved(1.5, 2.5))
    push(events, Event.Idle)
    push(events, Event.Named("trap"))
    if onEvents(events) != 12 {
        return 1
    }
    if !silence(events, 0) || events[0] != Event.Idle {
        return 2
    }
    if onEvents(events) != 8 {
        return 3
    }

    io.print("one frame, {step(world)} left standing")
    return 0
}
