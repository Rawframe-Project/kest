module examples.chance

import std.io
import std.random

// Placing things with numbers that look random, and being able to do it again.
// The source is a value the program holds, so two runs from one seed lay the
// world out the same way — which is what a simulation needs to be worth
// running twice.

struct Spot {
    x: i32
    y: i32
}

// A field of spots, from a seed. Nothing here is global: the source goes in
// and the one that comes out is where the next call starts.
fn scatter(seed: u64, count: i32, side: i32) -> [Spot] {
    let spots: [Spot] = array()
    let source = random.from(seed)
    for i in 0..count {
        source = random.next(source)
        let x = random.below(source, side)
        source = random.next(source)
        let y = random.below(source, side)
        push(spots, Spot(x, y))
    }
    return spots
}

// Spots inside a band rather than from nought: what a placer does when the
// edges belong to somebody else. The first is included and the second is not,
// which is how a count is written everywhere else in this language.
fn band(seed: u64, count: i32, low: i32, high: i32) -> [i32] {
    let out: [i32] = array()
    let source = random.from(seed)
    for i in 0..count {
        source = random.next(source)
        push(out, random.between(source, low, high))
    }
    return out
}

// A row of the field said in pieces. Nothing is built to hold the line: each
// cell is written as it is worked out and the end of the line is said at the
// end, which is what `io.write` is for and `io.print` is not.
fn draw(spots: [Spot], row: i32, side: i32) {
    for x in 0..side {
        let here = false
        for s in spots {
            if s.x == x && s.y == row {
                here = true
            }
        }
        io.write(if here -> "#" else -> ".")
    }
    io.print("")
}

fn same(a: [Spot], b: [Spot]) -> bool no.alloc {
    if len(a) != len(b) {
        return false
    }
    for i in 0..len(a) {
        if a[i].x != b[i].x || a[i].y != b[i].y {
            return false
        }
    }
    return true
}

fn main() -> i32 {
    let once = scatter(7, 50, 32)
    let again = scatter(7, 50, 32)
    if !same(once, again) {
        return 1
    }

    let elsewhere = scatter(8, 50, 32)
    if same(once, elsewhere) {
        return 2
    }

    for s in once {
        if s.x < 0 || s.x >= 32 || s.y < 0 || s.y >= 32 {
            return 3
        }
    }

    // A quarter of a thousand, give or take: what a chance is worth is only
    // worth checking loosely, and a check that is tight is a check that fails
    // on a different machine.
    let source = random.from(3)
    let hits = 0
    for i in 0..1000 {
        source = random.next(source)
        if random.chance(source, 25) {
            hits += 1
        }
    }
    if hits < 200 || hits > 300 {
        return 4
    }

    let least = 1.0
    let most = 0.0
    for i in 0..1000 {
        source = random.next(source)
        let one = random.fraction(source)
        if one < least {
            least = one
        }
        if one > most {
            most = one
        }
    }
    if least < 0.0 || most >= 1.0 {
        return 5
    }

    // Shuffling is the other thing a simulation asks for, and it has to be a
    // rearrangement: every spot still there, once.
    let order: [i32] = array()
    for i in 0..len(once) {
        push(order, i)
    }
    source = random.shuffle(source, order)
    let seen = array(len(once), 0)
    for i in order {
        seen[i] = seen[i] + 1
    }
    for c in seen {
        if c != 1 {
            return 6
        }
    }
    // One of them, held against what is in the run rather than against the
    // range the run happens to cover. `order` holds every index once, so a
    // pick that came back nought passed a test for being an index — which is
    // how `random.one` answered nought for every array in the language for as
    // long as it did. See D809.
    let marks: [i32] = array()
    push(marks, 11)
    push(marks, 22)
    push(marks, 33)
    for round in 0..12 {
        if let picked = random.one(source, marks) {
            if picked != 11 && picked != 22 && picked != 33 {
                return 7
            }
        } else {
            return 8
        }
        source = random.next(source)
    }

    // A band is a band: nothing outside it, and the same seed lays out the
    // same one.
    let placed = band(4, 40, 10, 20)
    for one in placed {
        if one < 10 || one >= 20 {
            return 9
        }
    }
    if len(placed) != 40 {
        return 10
    }
    // A band with nowhere in it is where it starts, because there is no
    // number below one of those to give.
    if band(4, 1, 7, 7)[0] != 7 {
        return 11
    }

    // Everything else here is cut from one number, and this is that number.
    let held = random.next(random.from(5))
    if random.below(held, 100) != i32(random.number(held) % 100) {
        return 12
    }
    if random.number(held) != random.number(random.next(random.from(5))) {
        return 13
    }

    draw(once, 0, 32)
    io.print("50 spots twice from one seed, {hits} of a thousand at a quarter")
    return 0
}
