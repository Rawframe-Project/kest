module examples.events

import std.io

// The host calling in. D007 says the two directions are separate
// specifications, and W11 measured this one as the wider: one crossing per
// event spread five implementations over 19.28 times, the widest figure in the
// workload, and the ordering of two of them reversed against the inward path.
//
// So the shape to write is `onEvents`, which is called once and walks a batch
// the host lent it. `onEvent` is here because it has to stay expressible, not
// because it is the one to reach for.

fn onEvents(events: [i32]) -> i32 no.alloc no.host deterministic {
    let total = 0
    for e in events {
        if e % 3 == 0 {
            total += e
        }
    }
    return total
}

fn onEvent(event: i32) -> i32 no.alloc no.host deterministic {
    if event % 3 == 0 {
        return event
    }
    return 0
}

fn main() -> i32 {
    if onEvents([0, 1, 2, 3]) != 3 {
        return 1
    }
    if onEvent(9) != 9 {
        return 2
    }

    // The two shapes over one list, which is the thing that makes a batch the
    // default rather than a second feature: it answers what one at a time
    // answers. This file said they agree and asked two different questions
    // with two different inputs. See D556.
    let some = [0, 1, 2, 3, 9, 10, 12]
    let atOnce = onEvents(some)
    let oneAtATime = 0
    for e in some {
        oneAtATime += onEvent(e)
    }
    if atOnce != oneAtATime {
        return 3
    }
    if atOnce != 24 {
        return 4
    }

    io.print("both shapes agree; run `kest tick` to have the host drive them")
    return 0
}
