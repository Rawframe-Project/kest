module examples.held

import std.bytes

// The program a held machine runs, which is what a host keeping a world across
// frames and reloads looks like from this side: a world made once, a step the
// host calls with it, and the two functions a reload is made of -- `save`,
// which writes the world as bytes, and `restore`, which makes a world out of
// nothing but those bytes in a machine that never saw the first. See D1151.

// Two handles, held in step: the turns count what was done to the cells, and
// a save writes both or neither.
struct World {
    cells: [u8]
    turns: [i32]
}

fn begin(many: i32) -> World no.host deterministic {
    let cells: [u8] = array(many, u8(0))
    for i in 0..many {
        cells[i] = u8(i)
    }
    return World(cells, array(1, 0))
}

// One turn: every cell goes up by one, and the turn is counted.
fn step(w: World) -> i32 no.alloc no.host deterministic {
    for i in 0..len(w.cells) {
        w.cells[i] = w.cells[i] + u8(1)
    }
    w.turns[0] += 1
    return w.turns[0]
}

// The turn first, as `std.bytes` writes a number, and then the cells.
fn save(w: World) -> [u8] no.host deterministic {
    let out: [u8] = array()
    bytes.putI32(out, w.turns[0])
    for i in 0..len(w.cells) {
        bytes.putU8(out, w.cells[i])
    }
    return out
}

fn restore(saved: [u8]) -> World no.host deterministic {
    let r = bytes.reader(saved)
    let turn = bytes.readI32(r)
    let cells: [u8] = array()
    while bytes.left(r) > 0 {
        push(cells, bytes.readU8(r))
    }
    return World(cells, array(1, turn))
}

fn main() -> i32 no.host deterministic {
    let w = begin(4)
    step(w)
    let back = restore(save(w))
    if back.turns[0] != 1 || len(back.cells) != 4 || back.cells[3] != u8(4) {
        return 1
    }
    return 0
}
