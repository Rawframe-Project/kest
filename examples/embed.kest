module examples.embed

import std.io
import std.text
import examples.twins.twin

// A world the host keeps between frames. Nothing here writes to a global,
// because there are none: the store is made once, handed back, and handed in
// again every frame. What holds it is the host.

struct Npc {
    name: text
    health: i32
}

// What the host sends in. The byte layout of an enum is what a C tagged union
// is — a four byte tag at nought and the payload after it at its own
// alignment (D026) — so the host lends an array of them and nothing is copied
// at the boundary (D016). `embed.c` beside this declares the same shape in C.
// The case that used to carry a name carries which name instead. A lend is
// the host's memory, and a pointer in it is one the machine did not put there
// and cannot take back when the lend ends — so a shape holding text, a handle
// or a reference is refused at the lend rather than read out of one and kept.
// The name itself crosses over a frame, where `kest_text` makes it the
// machine's. See D434.
enum Event {
    Idle
    Moved(f32, f32)
    Hit(i32)
    Named(i32)
}

// A struct with a run inside it, which is what a host lends when its own type
// has an array in it. `[f32; 3]` is three where it stands (D064), so this is
// twelve bytes and the host's `struct { float at[3]; }` is the same twelve.
// A run on its own cannot be lent: a lend names a type and only a declared
// one has a name, which is what this struct is for.
struct Point {
    at: [f32; 3]
}

// A run of structs inside a struct, which is the other half of the same
// shape: `struct Cell { int32_t at; float weight; }` and three of them inside
// a row. What that comes to in bytes is what D120 got wrong, and what a host
// lending one would have read as the wrong thing.
struct Cell {
    at: i32
    weight: f32
}

struct Row {
    cells: [Cell; 3]
    tag: i32
}

// The widths a C header is full of, and the padding between them. A layout is
// what a host is told about a shape — where each field sits and what is there
// — and until this was written nothing in this tree laid out an `i16`, a
// `u16` or a `u32` at all, so three of the twelve kinds a layout can carry had
// never been held to what a C compiler does (D431). Two bytes, two bytes,
// four, one, and three of nothing after it is twelve; a host that gets that
// wrong reads the next tile's fields.
// The shape D016 works out by hand: a `u16` and a `bool` is four bytes aligned
// to two. Every other shape this host lends is made of numbers, and a `bool` is
// the one field whose width a reader has to be told rather than count — one
// byte here and `_Bool` there, with the padding after it decided by the `u16`
// in front. It was the one shape in the decision that nothing crossed with.
// See D552.
struct Flagged {
    kind: u16
    on: bool
}

// What the host lends a run of, read where it sits: the `bool` decides whether
// the `u16` beside it counts, so both fields are read and a wrong offset for
// either is a wrong answer rather than a wrong size.
fn howManyOn(rows: [Flagged]) -> i32 no.alloc {
    let seen = 0
    for one in rows {
        if one.on {
            seen += i32(one.kind)
        }
    }
    return seen
}

struct Tile {
    kind: u16
    height: i16
    flags: u32
    wear: i8
}

// The worst wear in a run of tiles and what it was on, with the tiles the
// host's own bytes and every field read where it sits. The widths are the
// point: a `u16` read as an `i16` is a different number above thirty-two
// thousand, and a `i8` read as a `u8` is a different one below nought.
fn worn(tiles: [Tile]) -> i32 no.alloc {
    let worst = 0
    let seen = 0
    let lit = 0
    for i in 0..len(tiles) {
        let wear = i32(tiles[i].wear)
        if wear < seen {
            seen = wear
            worst = i32(tiles[i].kind)
        }
        if tiles[i].flags & u32(1) != u32(0) {
            lit = lit + i32(tiles[i].height)
        }
    }
    return worst * 1000 + seen * 10 + lit
}

// The heaviest cell in any row, and which row it was in. Nothing is copied:
// the rows are the host's bytes and the cells are inside them.
fn heaviest(rows: [Row]) -> i32 no.alloc {
    let best = 0
    let seen = 0.0
    for i in 0..len(rows) {
        for c in rows[i].cells {
            if c.weight > seen {
                seen = c.weight
                best = rows[i].tag * 10 + c.at
            }
        }
    }
    return best
}

// The same walk, giving the cell back rather than a number worked out of it.
// Two slots that are not the same member — an `i32` in one and an `f32` in the
// next — which is the result a host cannot read by remembering how it read the
// last one. See D560.
fn heaviestCell(rows: [Row], which: i32) -> Cell no.alloc {
    let best = rows[which].cells[0]
    for c in rows[which].cells {
        if c.weight > best.weight {
            best = c
        }
    }
    return best
}

// A value crossing rather than a borrowed one: the host writes the three
// floats into the frame and the program gets a `Point`. In a frame a value is
// one slot a scalar and a float is a double, whatever it is in memory, which
// is the other half of D016's two layouts.
fn lengthOf(p: Point) -> f32 no.alloc {
    let sum = 0.0
    for one in p.at {
        sum += one * one
    }
    return sum
}

// A run of a written length is laid out where it stands (D064), so building
// one inside a promise to touch no heap is allowed: these three floats are the
// struct's own twelve bytes, and the compiler emits no instruction that could
// allocate them. The kind that can grow is the kind that reaches the heap.
fn moved(p: Point, by: f32) -> Point no.alloc {
    return Point([p.at[0] + by, p.at[1] + by, p.at[2] + by])
}

// The same name for a second thing, which the language allows when they take
// different things. A host asking for `lengthOf` is told it is more than one
// function; it walks them and asks each what it takes.
fn lengthOf(x: f32, y: f32) -> f32 no.alloc {
    return x * x + y * y
}

// Two of them by value, which is where a host has to know that the second one
// starts after the first one's scalars. It asks rather than counts.
fn between(a: Point, b: Point) -> f32 no.alloc {
    let sum = 0.0
    for i in 0..3 {
        let apart = a.at[i] - b.at[i]
        sum += apart * apart
    }
    return sum
}

// A function that takes a type, which is the one kind of name a host cannot
// hand over plainly: there is no `pick` to call, only a copy of it per set of
// types anything asked for. A host walks the copies with `kest_entry_of` and
// asks each what it takes, the same way it tells two functions of one name
// apart — the difference is that these two were written once. See D435.
fn pick<T>(a: T, b: T, first: bool) -> T no.alloc {
    if first {
        return a
    }
    return b
}

fn spread(points: [Point]) -> f32 no.alloc {
    let least = points[0].at[0]
    let most = points[0].at[0]
    for i in 0..len(points) {
        for one in points[i].at {
            if one < least {
                least = one
            }
            if one > most {
                most = one
            }
        }
    }
    return most - least
}

// The same question `spread` answers, asked one value at a time: the widest or
// the narrowest of one point's coordinates, with the host keeping the running
// answer between crossings itself. D007 measured what the two ways in cost —
// a batch crosses once and is walked in place, a value crosses per value —
// and what it does not say is that they answer the same, which is the thing a
// host writer is choosing between. `examples/embed.c` asks both of the same
// four points and holds the answers to each other.
fn reach(p: Point, most: bool) -> f32 no.alloc {
    let answer = p.at[0]
    for one in p.at {
        if most && one > answer || !most && one < answer {
            answer = one
        }
    }
    return answer
}

// Reading the host's memory as what it is. Nothing here allocates, so a whole
// batch crosses once and is walked in place.
fn onEvents(events: [Event]) -> i32 no.alloc no.host deterministic {
    let damage = 0
    for e in events {
        damage += match e {
            Idle -> 0
            Moved(x, y) -> i32(x + y)
            Hit(amount) -> amount
            Named(which) -> which
        }
    }
    return damage
}

// Writing through the view writes the host's memory, because there is only
// one copy of it. A tag written here is a tag the host reads.
fn silence(events: [Event], at: i32) -> bool no.alloc {
    if at < 0 || at >= len(events) {
        return false
    }
    events[at] = Event.Idle
    return true
}

// An enum crossing a frame rather than a lend, which is the other way a host
// hands one over: a lend shares the bytes and this copies the value into slots,
// the tag into the first and what the case carries into the ones after it.
// Which member of a slot each of those is depends on the tag, so a host writing
// one asks `kest_case_of` what the case carries rather than remembering. The
// array above is the same shape crossing the other way. See D702.
fn damageOf(e: Event) -> i32 no.alloc {
    return match e {
        Idle -> 0
        Moved(x, y) -> i32(x + y)
        Hit(amount) -> amount
        Named(which) -> which
    }
}

// And a value with a tag in it going the other way: back. The answer lands in
// the slots the arguments were in — the tag in the first and what the case
// carries after it — so a host reading one reads the tag before it reads
// anything else, because which member of a slot the rest are is the tag's to
// say. Nothing in this tree gave one back until this did. See D705.
fn worst(events: [Event]) -> Event no.alloc {
    let worst = Event.Idle
    let most = 0
    for e in events {
        let cost = damageOf(e)
        if cost > most {
            most = cost
            worst = e
        }
    }
    return worst
}

// A host with a frame budget is a host that can be told the program has spent
// it, and nothing else here comes near the megabyte `embed.c` allows. This is
// the one that does: what stops it is the machine rather than the loop, and
// what the host gets is the message and a heap it can throw away.
fn hoard() -> i32 {
    let crowd: store<Npc> = store()
    let i = 0
    while i < 1000000 {
        add(crowd, Npc("one of many", 1))
        i += 1
    }
    return i
}

// The same ceiling reached the other way. An array grows by taking a bigger
// block and copying itself into it, and a store grows by taking four; they are
// different code and the same message, and until this was written only one of
// the two had ever been run into.
fn pile() -> i32 {
    let many: [Npc] = array()
    let i = 0
    while i < 1000000 {
        push(many, Npc("one of many", 1))
        i += 1
    }
    return i
}

// Room for that many and nothing in it, which is what `array(n, v)` and
// `clear` say together: `clear` empties an array and keeps what it took, so a
// fill and a clear are the reservation the language has no third spelling for.
fn ready(rounds: i32) -> i32 {
    let xs: [i32] = array(rounds, 0)
    clear(xs)
    let i = 0
    while i < rounds {
        push(xs, i)
        i += 1
    }
    return len(xs)
}

// The same thing without asking, which pays for every doubling on the way:
// eight, sixteen, thirty-two, and each one copies what came before it.
fn filling(rounds: i32) -> i32 {
    let xs: [i32] = array()
    let i = 0
    while i < rounds {
        push(xs, i)
        i += 1
    }
    return len(xs)
}

// Text a piece at a time, written the way that copies everything each time:
// `"{t}x"` asks for the length of both and makes a new one out of them, so a
// loop that does it is a copy of everything gathered so far, every time round.
fn glued(rounds: i32) -> i32 {
    let t = ""
    let i = 0
    while i < rounds {
        t = "{t}x"
        i += 1
    }
    return len(t)
}

// And the way the reference says to write it: gather the bytes, which grow
// where they stand, and pay for the text once at the end.
fn joined(rounds: i32) -> i32 {
    let out: [u8] = array()
    let i = 0
    while i < rounds {
        push(out, u8(120))
        i += 1
    }
    return len(text(out))
}

// The library written the same way, which nothing has ever measured. `repeat`
// and `join` gather bytes and pay once; written out of `slice` they would pass
// every check in this tree and be quadratic, and the only way to tell from
// outside is to ask what two sizes cost.
fn repeated(times: i32) -> i32 {
    return len(text.repeat("xyz", times))
}

fn joinedPieces(count: i32) -> i32 {
    let pieces: [text] = array()
    for i in 0..count {
        push(pieces, "xyz")
    }
    return len(text.join(pieces, ","))
}

// A run of the host's own bytes, made into a piece of text without the host
// having said what its bytes mean. Text is UTF-8 and a run of bytes is
// whatever it holds, so this is where the two meet: what comes back is text if
// what the host lent is UTF-8 throughout, and a refusal if it is not. A nought
// is a character and goes through. See D971.
fn readable(raw: [u8]) -> i32 {
    return len(text(raw))
}

// The same bytes kept rather than counted. What a program makes out of a lend
// is the program's own — the bytes are copied onto the heap where everything
// else it holds lives — so it outlives the lend and says the same thing after
// the host has taken its block back and written something else into it.
fn copied(raw: [u8]) -> text {
    return text(raw)
}

// A batch taken apart by the program rather than by the host. Bytes are what
// arrives from a socket or a file, and the other side of that sentence is a
// program that reads what it wants out of them: a `u8` at a time, widened and
// shifted into the number it stands for. Nothing here allocates, so a host
// lending its buffer and a program reading it are one crossing and no copies —
// which is the choice `embed.c` makes beside the one that copies.
//
// Four bytes a record, least significant first, which is what a wire form says
// and not what this machine happens to do: a program that reads a number out
// of bytes says which order it is in, or it is a program that works on one
// computer.
fn recordAt(raw: [u8], at: i32) -> i32 no.alloc {
    return i32(raw[at]) |
        (i32(raw[at + 1]) << 8) |
        (i32(raw[at + 2]) << 16) |
        (i32(raw[at + 3]) << 24)
}

fn totalOf(raw: [u8]) -> i32 no.alloc {
    let sum = 0
    let at = 0
    while at + 4 <= len(raw) {
        sum += recordAt(raw, at)
        at += 4
    }
    return sum
}

// And the same crossing the other way. A program writing into a lend writes
// the host's own memory, so answering in a wire form is the program putting
// bytes where the host will read them: the same four bytes a record, the same
// order written down, and nothing copied anywhere.
fn putRecord(raw: [u8], at: i32, value: i32) no.alloc {
    raw[at] = u8(value & 255)
    raw[at + 1] = u8(value >> 8 & 255)
    raw[at + 2] = u8(value >> 16 & 255)
    raw[at + 3] = u8(value >> 24 & 255)
}

fn answerInto(raw: [u8], first: i32, second: i32) -> i32 no.alloc {
    if len(raw) < 8 {
        return 0
    }
    putRecord(raw, 0, first)
    putRecord(raw, 4, second)
    return first + second
}

// And words the same way, which is the one answer a program cannot hand back
// as a value without the host holding a pointer into the machine's heap: text
// is the machine's own memory, and what a host keeps of it is gone the moment
// the heap goes. Written into a lend it is the host's own memory instead, and
// the host reads it the way it reads anything it owns. Text is its bytes, so
// this is the same loop as a number: `len` counts them and `what[i]` is one.
fn sayInto(raw: [u8], at: i32, what: text) -> i32 no.alloc {
    let n = len(what)
    if at < 0 || at + n > len(raw) {
        return 0
    }
    for i in 0..n {
        raw[at + i] = what[i]
    }
    return n
}

// What the host says it is, asked for by the program rather than told to it.
// A host tells a program about itself the way it tells it anything: an
// `extern` like any other, declared here and bound there.
fn under() -> text {
    return Engine.name()
}

// Text the file was written with, given back as it stands. What a program
// makes goes on the heap and what a program was written with is in the build,
// and a host handed either of them has one pointer and nothing to tell it
// which — until it asks. See D563.
fn asWritten() -> text {
    return "written into the file this came from"
}

// A heap spent in one go rather than a bit at a time: everything else here
// that runs out is something growing, and a program asking for a million of
// something at once is the other way to want more than there is. What a host
// does about the two is not the same thing.
fn atOnce(many: i32) -> i32 {
    let all = array(many, 0)
    return len(all)
}

// A nought written into what the host lent. A lend is the host's memory and a
// program reads and writes it — the byte is a byte like any other in a run of
// them, whatever it would mean in a piece of text — so what this writes is
// what the host reads back out of its own array.
fn blank(raw: [u8], at: i32) -> i32 {
    raw[at] = 0
    return len(raw)
}

// A reference a host keeps between calls. A reference is a number — which slot
// and how many times that slot has been used — so one to something the program
// has dropped names a slot holding somebody else, and the count is what tells
// them apart. A host may hold one for as long as it likes and find out at the
// next call that what it named is gone.
fn born(world: store<Npc>) -> ref<Npc> {
    return add(world, Npc("kept", 5))
}

fn healthOf(world: store<Npc>, who: ref<Npc>) -> i32 {
    if let one = get(world, who) {
        return one.health
    }
    return -1
}

fn dropped(world: store<Npc>, who: ref<Npc>) -> i32 {
    remove(world, who)
    return len(world)
}

// What the first of them is, which is how a host finds out whether the program
// is reading its block or a copy of it: a lend is memory, so what the host
// wrote into it between calls is what this answers with.
fn first(raw: [u8]) -> i32 no.alloc {
    return i32(raw[0])
}

// A name the host says, counted here. What a host hands over is copied onto
// the heap before the program sees it, so this reads bytes the program owns
// rather than bytes a host may have moved on from.
fn named(what: text) -> i32 no.alloc {
    return len(what)
}

// The four things that would change how many there are. A lent run has a
// length that is the host's, so every one of them is refused where it is
// asked for rather than done to memory the program does not own.
// An array the program made, handed back to the host. What a host does with
// one is read it and hand it over again; what it may not do is end it as
// though it were a lend, because the machine is holding it and the host never
// lent anything. See D441.
fn ownArray() -> [u8] {
    let raw: [u8] = array()
    push(raw, 7)
    return raw
}

fn grew(raw: [u8]) -> i32 {
    push(raw, 1)
    return len(raw)
}

fn popped(raw: [u8]) -> i32 {
    if let last = pop(raw) {
        return i32(last)
    }
    return 0
}

fn took(raw: [u8]) -> i32 {
    return i32(remove(raw, 0))
}

fn emptied(raw: [u8]) -> i32 {
    clear(raw)
    return len(raw)
}

// What a store does with the room of something dropped, which is hand it out
// again (D014). This empties and fills one as many times as the host asks, and
// a store that kept the room would want a megabyte long before it was done.
fn churn(rounds: i32) -> i32 {
    let world: store<Npc> = store()
    let i = 0
    while i < rounds {
        for r in world {
            remove(world, r)
        }
        add(world, Npc("one of many", 1))
        i += 1
    }
    return len(world)
}

// Room for sixteen before the first frame, because a store grows by doubling
// and the frame that pays for the next eight is a frame a host cannot move.
// Saying how many there will be moves it here, where nothing is being timed.
// The other half of a name two modules wrote. `examples/twins/twin.kest`
// declares a `Twin` as well, and both are held in arrays, so both have a
// layout and a host asking for `Twin` has asked for one of two. What it has to
// write instead is the whole name, which is the one thing that tells them
// apart. See D526.
struct Twin {
    n: i32
}

fn twinned(mine: [Twin], theirs: [twin.Twin]) -> i32 no.alloc {
    let sum = 0
    for one in mine {
        sum += one.n
    }
    return sum + twin.total(theirs)
}

fn create() -> store<Npc> {
    return store(16)
}

fn spawn(world: store<Npc>, health: i32) -> i32 {
    add(world, Npc("npc", health))
    return len(world)
}

// A frame: everything alive loses a point and everything at nothing is gone.
// It walks, reads, writes and removes, and allocates nothing.
// The host decides what a step costs, and its answer may come back through
// this program: `embed.c` binds this and calls `rule` from inside it, which
// is a host calling in from inside a call it was called from (D072). The
// promise is the host's to keep, because an extern is judged by what it
// declares.
extern fn Engine.decide(health: i32) -> i32 no.alloc

// Text the other way: a host hands a piece of it over, and what comes back is
// the machine's own — a host that handed a pointer of its own would be
// promising to keep it as long as this program holds it. Which host is running
// this is the one thing a program cannot work out for itself.
extern fn Engine.name() -> text

// A crossing that hands the host a shape rather than a number. What the host
// reads is the frame the machine laid the value out in — three `f32` in three
// slots — and what says which is the layout `kest_extern_layout` gives, piece
// by piece. A host that checked only how many bytes the argument is would bind
// a function that reads the same width with the fields in another order and
// find out at the first call. See D699.
extern fn Engine.rank(p: Point) -> i32 no.alloc

// A crossing handed a value with a tag in it, which is the other end of
// `damageOf`: there the host writes the tag and what the case carries into a
// frame, here the machine writes them and the host reads them. Either way the
// slots after the tag are the tag's to explain, and what a host reading one has
// to go on is `kest_case_of` over the layout the crossing says it takes. See
// D704.
extern fn Engine.hurt(e: Event) -> i32 no.alloc

// And one answered with rather than handed over: a crossing that gives back a
// shape with a piece of text in a field. What a crossing answers with is read
// the way what a host hands in is read, one field in, because the two are one
// walk at the two ends of one call. See D719.
extern fn Engine.who() -> Npc

// And one answered with a number kept narrower than the slot it comes back in.
// A slot holds a double and an `f32` holds less, so this is the one crossing
// where a host can answer with a number the program's own arithmetic cannot
// make — and the walk that reads what came back is where it is caught. See
// D838.
extern fn Engine.weigh() -> f32 no.alloc

fn whoIs() -> i32 {
    let one = Engine.who()
    return len(one.name) + one.health
}

fn weighed() -> i32 {
    return i32(Engine.weigh() * 2.0)
}

// A shape with a piece of text in it, handed over by value. The door reads an
// argument by what it is rather than by what its first piece is, so the text
// inside this one is read the same as a piece of text handed over on its own —
// and until it was, a host filling this wrote a pointer of its own into the
// first slot and the program read it as text the machine owned. See D718.
fn greets(who: Npc) -> i32 no.alloc {
    return len(who.name) + who.health
}

// An enum whose cases carry nothing, which is a tag and nothing else: one slot,
// four bytes, and — before a tag said what it was — exactly an `i32` in a
// layout. This is the shape the argument for saying so is really about, and the
// one it did not show: a tag beside a number read the same as a number beside a
// tag, so a host with the two the other way round agreed with itself. See D713.
enum Footing {
    Still
    Rushing
    Falling
}

fn footed(how: Footing, n: i32) -> i32 no.alloc {
    return match how {
        Still -> n
        Rushing -> n * 2
        Falling -> 0 - n
    }
}

// The other thing in this language whose bytes mean something only when a flag
// beside them says so: an optional is a value and a byte after it, and an empty
// one is that byte set to nought. What is in the value then is written as well
// as the byte — the same rule a case that carries nothing is written by — so two
// empty ones are the same bytes and a host comparing them says so. See D712.
struct Mark {
    at: i32?
    n: i32
}

fn marked(marks: [Mark]) -> i32 no.alloc {
    let seen = 0
    for one in marks {
        if let at = one.at {
            seen += at
        }
    }
    return seen
}

// And one crossing a frame rather than a lend, which is where a host says what
// it is putting in each slot rather than where its own fields are: the value,
// the byte that says whether the value is there, and the number. Those three
// are what a number, a `bool` and a number are as well, and the middle one is
// the only thing telling the two apart. See D714.
fn marking(one: Mark) -> i32 no.alloc {
    if let at = one.at {
        return at + one.n
    }
    return one.n
}

// And writing them, which is where the bytes under an empty one are decided:
// the host lends memory with something in it, and what is there afterwards is
// what the program put there and nothing else.
fn mark(marks: [Mark], at: i32, n: i32) no.alloc {
    marks[at] = Mark(n, n)
}

fn unmark(marks: [Mark], at: i32) no.alloc {
    marks[at] = Mark(none, 0)
}

// A value with a tag in it inside another shape, which is the one place a tag is
// not the first slot: the number comes first here, so the tag is the second of
// four and the cases are the `Event`'s rather than this shape's. A layout says
// it holds a tag either way and the two mean different things, which is what
// reading them alike got wrong. See D707 and D709.
struct Blamed {
    cost: i32
    what: Event
}

fn blamedBy(one: Blamed) -> i32 no.alloc {
    return damageOf(one.what) + one.cost
}

// And the one direction left: a crossing that answers a value with a tag in it.
// The host writes the tag and the program reads every slot after it as whatever
// that tag says, so a tag the enum has no case for is a payload nobody wrote —
// and there is nowhere to ask about it beforehand, because the tag is decided
// inside the call. The machine reads it the moment the host answers. See D706.
extern fn Engine.blame(cost: i32) -> Event no.alloc

fn blamed(cost: i32) -> i32 no.alloc {
    return damageOf(Engine.blame(cost))
}

// The engine deciding what each event costs, over the host's own run of them:
// the array is lent, so each one crosses out of the host's own memory, through
// the machine, and back to the host a case at a time. `onEvents` answers the
// same question inside the program, and the two are held against each other.
fn hurtBy(events: [Event]) -> i32 no.alloc {
    let total = 0
    for e in events {
        total += Engine.hurt(e)
    }
    return total
}

// The program's side of it: the host is asked what a point is worth, and what
// comes back is a number like any other.
fn ranked(p: Point) -> i32 no.alloc {
    return Engine.rank(p)
}

// A run of calls deeper than a message holds. An engine's frame goes through
// its world, its regions and whatever is standing in them before it reaches
// arithmetic, and a refusal down there is one a host reads the way in to: the
// message shows what a diagnostic holds and says how many are under the last
// of them. Nothing else in this program is deep enough to ask for that, and
// what nobody has seen is what nobody knows is there. See D620.
fn tickShare(among: i32) -> i32 no.alloc {
    return 60 / among
}

fn tickCost(among: i32) -> i32 no.alloc {
    return tickShare(among)
}

fn tickMove(among: i32) -> i32 no.alloc {
    return tickCost(among)
}

fn tickStep(among: i32) -> i32 no.alloc {
    return tickMove(among)
}

fn tickTask(among: i32) -> i32 no.alloc {
    return tickStep(among)
}

fn tickAgent(among: i32) -> i32 no.alloc {
    return tickTask(among)
}

fn tickTile(among: i32) -> i32 no.alloc {
    return tickAgent(among)
}

fn tickChunk(among: i32) -> i32 no.alloc {
    return tickTile(among)
}

fn tickRegion(among: i32) -> i32 no.alloc {
    return tickChunk(among)
}

fn tickWorld(among: i32) -> i32 no.alloc {
    return tickRegion(among)
}

fn rule(health: i32) -> i32 no.alloc {
    return if health > 3 -> 2 else -> 1
}

fn step(world: store<Npc>) -> i32 no.alloc {
    let alive = 0
    for r in world {
        if let npc = get(world, r) {
            let hit = Engine.decide(npc.health)
            if npc.health <= hit {
                remove(world, r)
            } else {
                set(world, r, Npc(npc.name, npc.health - hit))
                alive += 1
            }
        }
    }
    return alive
}

// Running this file on its own does one frame of what the host beside it does
// ten of.
fn main() -> i32 {
    let world = create()
    spawn(world, 3)

    // The same shapes without a host, so this file says what it does on its
    // own as well as under `embed.c`.
    // Built inside a promise, moved, and measured: the run went into the
    // struct where it stood, so nothing here was allocated.
    if len(ownArray()) != 1 {
        return 13
    }

    // Two copies of one body, which is what makes `pick` two names a host has
    // to tell apart rather than one it can ask for.
    if pick(3, 4, true) != 3 || pick(1.5, 2.5, false) != 2.5 {
        return 12
    }
    if lengthOf(moved(Point([1.0, 2.0, 2.0]), 0.0)) != 9.0 {
        return 6
    }
    if lengthOf(moved(Point([0.0, 0.0, 0.0]), 2.0)) != 12.0 {
        return 7
    }

    let points: [Point] = array()
    push(points, Point([1.0, 2.0, 3.0]))
    push(points, Point([0.0, 9.0, 4.0]))
    if spread(points) != 9.0 {
        return 4
    }

    let events: [Event] = array()
    push(events, Event.Hit(4))
    push(events, Event.Moved(1.5, 2.5))
    push(events, Event.Idle)
    push(events, Event.Named(4))
    if onEvents(events) != 12 {
        return 1
    }
    if !silence(events, 0) || events[0] != Event.Idle {
        return 2
    }
    if onEvents(events) != 8 {
        return 3
    }

    // Whatever is running this says so, and what it said is this machine's own
    // text: it is asked for twice and both answers are still there.
    let who = Engine.name()
    let again = Engine.name()
    if len(who) == 0 || who != again {
        return 5
    }

    // The call the second proof cannot follow, made by the program itself so
    // that there is something for it to follow to: what a call through a value
    // may enter is what this file ever names as one, which here is `doubled`.
    // The host hands in `grows` and finds out from the machine. See D834.
    if apply(doubled, 2) != 4 {
        return 6
    }

    io.print("one frame under {who}, {step(world)} left standing")
    return 0
}

// A promise through a call the second proof cannot follow. Which function
// `apply` enters is not known until it runs, so what holds it is the type:
// only a value that promises `no.alloc` goes where one is wanted. A host
// filling that slot writes a number, and a number carries no promise — so the
// machine asks the chunk it is about to enter and refuses if it does not
// promise. `grows` is the one it refuses, handed in by a host that read the
// index and wrote it. See D834.
fn apply(f: fn(i32) -> i32 no.alloc, n: i32) -> i32 no.alloc {
    return f(n)
}

fn doubled(n: i32) -> i32 no.alloc {
    return n * 2
}

fn grows(n: i32) -> i32 {
    let made: [i32] = array()
    push(made, n)
    return len(made) + n
}

// A body that writes twice and runs off the end on the second pass, which is
// what a host has to have an answer for: every row's tag is stamped, then the
// weights are written up to `upto`, and an `upto` past the end stops there.
// What the host is left holding is the first pass whole and part of the
// second. See D1133.
fn halfWritten(rows: [Row], upto: i32) -> i32 no.alloc {
    for i in 0..len(rows) {
        rows[i].tag = 7
    }
    for i in 0..upto {
        rows[i].cells[0].weight = 99.0
    }
    return len(rows)
}
