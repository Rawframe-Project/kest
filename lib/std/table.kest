module std.table

// A hash table, written in Kest on a generic struct and generic functions
// (D040, D041). `hash` is the one thing the language provides, and it applies
// exactly where `==` does (D042), so a copy over a key that does not compare
// is refused where it is made.
//
// Open addressing, linear probing. The keys and the values sit next to each
// other in two arrays and `slots` says where each one is: nought for empty,
// -1 for a key that was taken out, and otherwise one more than the position.
// Probing forward means a lookup reads memory in order, which is what a frame
// budget wants and what a chain of pointers is not.
//
// A struct is a value (D006), so a table handed to a function is a copy of
// the three handles rather than of what they hold. Everything that changes is
// therefore behind one of them: `slots` is emptied and refilled rather than
// replaced, and how many pairs there are is `len(keys)` rather than a number
// beside it. A field written here would be written on the copy.

// The pairs are walked over `keys` and `values`, which are packed and in step:
// `values[i]` is what `keys[i]` is set to, and there are `count(t)` of both.
// The order is the order they went in, except where something was taken out
// and the last pair moved into the hole — so it is an order, and not one to
// rely on.
//
// A table is not made smaller when things are taken out of it. Nothing here
// frees anything (D012): making the slots smaller would make a new array and
// leave the old one where it is, so shrinking costs memory rather than giving
// it back. What a table has held, it keeps room for until the heap is thrown
// away.

const EMPTY: i32 = 0
const TAKEN: i32 = -1

// What it holds, held in step: the pair at a place is `keys[i]` beside
// `values[i]`, and `slots` says where a key's place is. A shape that holds more
// than one handle holds them in step with each other, and a program that writes
// one of them writes the shape — there is no refusal for it, because a handle
// handed out is a handle written through. See D694.
struct Table<K, V> {
    keys: [K]
    values: [V]
    slots: [i32]
    // How many of the slots are marks. It is an array of one rather than a
    // number, for the same reason everything else here is behind a handle: a
    // number written in a function would be written on that function's copy.
    marks: [i32]
}

// What a table starts as. `table.empty()` rather than `table.table()`, which
// is the same stammer `sort.sort` was.
fn empty<K, V>() -> Table<K, V> no.host {
    let keys: [K] = array()
    let values: [V] = array()
    let slots = array(8, EMPTY)
    let marks = array(1, 0)
    return Table(keys, values, slots, marks)
}

fn count<K, V>(t: Table<K, V>) -> i32 no.alloc no.host {
    return len(t.keys)
}

// The keys, copied. Walking `t.keys` is walking the table's own memory, which
// costs nothing and is what a frame does; changing it is something else. The
// pair at a place is `keys[i]` and `values[i]`, and a sort that moves one and
// not the other leaves a table that answers about a key with another key's
// value — measured, and no refusal anywhere, because a handle handed out is a
// handle written through. So a program that wants them in an order of its own
// asks for a copy and sorts that. See D693.
fn keysOf<K, V>(t: Table<K, V>) -> [K] no.host {
    let out: [K] = array()
    for key in t.keys {
        push(out, key)
    }
    return out
}

// Which slot a key is kept in, or nothing. Everything that looks for a key
// looks here: `find` wants the pair, `remove` wants the slot, and a second
// probe written for the second of those would be a second place to get the
// walk past a mark wrong.
fn slotOf<K, V>(t: Table<K, V>, key: K) -> i32? no.alloc no.host {
    let room = len(t.slots)
    let at = i32(hash(key) % u64(room))
    for step in 0..room {
        let held = t.slots[at]
        if held == EMPTY {
            return none
        }
        if held > 0 && t.keys[held - 1] == key {
            return at
        }
        at += 1
        if at == room {
            at = 0
        }
    }
    return none
}

// Where a key is, or nothing. Reads only what is already there, so a lookup
// costs no allocation whatever the table holds.
fn find<K, V>(t: Table<K, V>, key: K) -> i32? no.alloc no.host {
    if let slot = slotOf(t, key) {
        return t.slots[slot] - 1
    }
    return none
}

fn get<K, V>(t: Table<K, V>, key: K, fallback: V) -> V no.alloc no.host {
    if let at = find(t, key) {
        return t.values[at]
    }
    return fallback
}

fn has<K, V>(t: Table<K, V>, key: K) -> bool no.alloc no.host {
    return find(t, key) != none
}

// Puts a position in the first slot that will hold it, walking past whatever
// is already there. Nothing is compared: this is only used where the key is
// known to be new.
fn place<K, V>(t: Table<K, V>, key: K, where: i32) no.alloc no.host {
    let room = len(t.slots)
    let at = i32(hash(key) % u64(room))
    for step in 0..room {
        if t.slots[at] <= EMPTY {
            t.slots[at] = where + 1
            return
        }
        at += 1
        if at == room {
            at = 0
        }
    }
}

// That much room, and every key put back where its hash says it goes now. The
// same array is emptied and refilled, because replacing it would replace the
// copy's handle and leave the caller's table where it was. The marks go with
// it: what they were for is a probe that has to carry on past a hole, and
// after this there are no holes to carry on past.
fn refill<K, V>(t: Table<K, V>, room: i32) no.host {
    clear(t.slots)
    for i in 0..room {
        push(t.slots, EMPTY)
    }
    t.marks[0] = 0
    for i in 0..len(t.keys) {
        place(t, t.keys[i], i)
    }
}

// Setting a key that is there writes over it, so a key appears once.
//
// A table is refilled while more than half of it is spoken for, because
// probing past a full one is what makes a lookup slow. A mark counts as
// spoken for: it is not a pair and a probe does not stop at it, so a table
// that has had things taken out of it can be all marks and no room while
// holding almost nothing. Twice the room is for the pairs; the same room again
// is for the marks, and which of the two is asked is which of them is
// crowding it.
fn set<K, V>(t: Table<K, V>, key: K, value: V) no.host {
    if let at = find(t, key) {
        t.values[at] = value
        return
    }
    if (len(t.keys) + t.marks[0] + 1) * 2 >= len(t.slots) {
        if (len(t.keys) + 1) * 2 >= len(t.slots) {
            refill(t, len(t.slots) * 2)
        } else {
            refill(t, len(t.slots))
        }
    }
    push(t.keys, key)
    push(t.values, value)
    place(t, key, len(t.keys) - 1)
}

// The one taken out leaves a mark rather than a hole, because a hole would
// end a probe that has to carry on past it. The last pair moves into its
// place so the two arrays stay packed.
//
// Two slots change and both are found by probing for the key that is kept in
// them, which is what a hash is for. Walking every slot to find two of them is
// the whole table for one pair, and a table is walked when it is refilled and
// not when something is taken out of it.
fn remove<K, V>(t: Table<K, V>, key: K) -> bool no.alloc no.host {
    if let here = slotOf(t, key) {
        let at = t.slots[here] - 1
        let last = len(t.keys) - 1
        if at != last {
            // Where the pair that is about to move is kept, found while it is
            // still where it was and before this slot becomes a mark.
            if let there = slotOf(t, t.keys[last]) {
                t.slots[there] = at + 1
            }
            t.keys[at] = t.keys[last]
            t.values[at] = t.values[last]
        }
        remove(t.keys, last)
        remove(t.values, last)
        t.slots[here] = TAKEN
        t.marks[0] = t.marks[0] + 1
        return true
    }
    return false
}
