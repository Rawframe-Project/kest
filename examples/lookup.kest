module examples.lookup

import std.io
import std.hash

// A lookup that finds nothing is a value, not a special number and not a
// crash. `if let` is the only way to open one, so the name holding the result
// exists exactly where the result does.

// A table written down before the program runs. Values worked out where they
// are written live in the chunk, so a run of them is one copy rather than one
// instruction each, and one of them read at an index worked out while it runs
// is read out of the chunk rather than copied into slots first (D430).
const TIERS: [i32; 4] = [0, 90, 250, 1200]

// Worked out where they are written, both of them: how many are in a run of a
// size the type says, and the number standing for a value, which this language
// promises does not move. A program may have a table of hashes before it starts
// rather than building one every time it does. See D670.
const HOW_MANY: i32 = len(TIERS)
const SWORD: u64 = hash("sword")

struct Item {
    id: i32
    price: i32
}

// One number for a whole item, which `hash` does not give: what a struct hashes
// to is which of its fields decide, and that is the program's to say. What
// folds them is `std.hash`, so that two programs folding the same fields get
// the same number — the fold is the one this compiler uses for a program made
// of several files. See D666.
fn mark(item: Item) -> u64 no.alloc {
    return hash.join(hash.join(hash.start, hash(item.id)), hash(item.price))
}

// What the folder stops at, which is what makes a pair a pair: it works out
// numbers, truths, text and what this language promises about them, and a call
// is where a program starts. See D668.
fn spoken(t: text) -> text no.alloc {
    return t
}

fn find(items: [Item], id: i32) -> Item? {
    for item in items {
        if item.id == id {
            return item
        }
    }
    return none
}

fn priceOf(items: [Item], id: i32) -> i32 {
    if let item = find(items, id) {
        return item.price
    }
    return 0
}

fn main() -> i32 {
    let stock = [Item(1, 250), Item(7, 90), Item(9, 1200)]

    if priceOf(stock, 7) != 90 {
        return 1
    }
    if priceOf(stock, 3) != 0 {
        return 2
    }

    if let item = find(stock, 9) {
        if item.price != 1200 {
            return 3
        }
    } else {
        return 4
    }

    let total = 0
    for id in [1, 3, 7, 9] {
        total += priceOf(stock, id)
    }
    if total != 1540 {
        return 5
    }

    let tier = 2
    if TIERS[tier] != 250 || TIERS[tier + 1] != 1200 {
        return 6
    }
    let held: [i32; 4] = TIERS
    if held[0] != 0 || held[3] != 1200 {
        return 7
    }

    // What a fold answers is the same number everywhere and every time, which
    // is what makes it worth writing one down. See D664.
    if mark(Item(1, 90)) != 8162023171451696525 {
        return 8
    }
    if mark(Item(1, 90)) == mark(Item(1, 91)) {
        return 9
    }

    // And the two halves of each: worked out where it is written, and asked
    // while running. See D668 for why a pair is written this way.
    if HOW_MANY != len(TIERS) || HOW_MANY != 4 {
        return 10
    }
    if SWORD != hash(spoken("sword")) {
        return 11
    }

    io.print("found what was there, and said nothing about what was not")
    return 0
}
