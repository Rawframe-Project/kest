module examples.shapes

import std.io
import std.sort
import std.text
import std.vec

// One body, one copy per set of types it is called with. Nothing is boxed and
// nothing carries a tag: a `[vec.Vec2]` walked by `firstOf` is the same two
// `f32` it always was, and the copy that walks it was compiled knowing that.
//
// The cost is copies. Two types called with means two bodies, which is what
// makes them free at run time and what a program has to be aware of.

fn firstOf<T>(items: [T], fallback: T) -> T no.alloc {
    for one in items {
        return one
    }
    return fallback
}

fn count<T>(items: [T], keep: fn(T) -> bool no.alloc) -> i32 no.alloc {
    let n = 0
    for one in items {
        if keep(one) {
            n += 1
        }
    }
    return n
}

// Building reaches the heap, so this one promises nothing and says so by not
// promising. A copy is checked against its own types, so a `[vec.Vec2]` copy and a
// `[text]` copy each get their own answer.
fn kept<T>(items: [T], keep: fn(T) -> bool no.alloc) -> [T] {
    let out: [T] = array()
    for one in items {
        if keep(one) {
            push(out, one)
        }
    }
    return out
}

fn far(v: vec.Vec2) -> bool no.alloc {
    return v.x > 1.0
}

fn long(word: text) -> bool no.alloc {
    return len(word) > 4
}

fn short(word: text) -> bool no.alloc {
    return len(word) < 5
}

fn nearer(a: vec.Vec2, b: vec.Vec2) -> bool no.alloc {
    return a.x < b.x
}

fn main() -> i32 {
    let points: [vec.Vec2] = array()
    push(points, vec.Vec2(3.0, 0.0))
    push(points, vec.Vec2(0.5, 1.0))
    push(points, vec.Vec2(2.0, 2.0))

    if firstOf(points, vec.Vec2(9.0, 9.0)).x != 3.0 {
        return 1
    }
    if firstOf(kept(points, far), vec.Vec2(9.0, 9.0)).x != 3.0 {
        return 2
    }
    if count(points, far) != 2 {
        return 3
    }

    // The same three functions over text, which is one slot rather than two.
    let words: [text] = array()
    push(words, "guard")
    push(words, "cook")
    push(words, "herald")

    if firstOf(words, "none") != "guard" {
        return 4
    }
    if count(words, long) != 2 {
        return 5
    }
    if text.join(kept(words, long), ",") != "guard,herald" {
        return 6
    }

    let empty: [vec.Vec2] = array()
    if firstOf(empty, vec.Vec2(5.0, 5.0)).y != 5.0 {
        return 7
    }

    // `sort` is one body too, and it is told what comes first.
    sort.sort(points, nearer)
    if points[0].x != 0.5 {
        return 8
    }
    sort.sort(words, sort.ascending)
    if words[0] != "cook" {
        return 9
    }

    // A name bound to a function is that function, which is what lets a cost
    // be proved through it: `count` promises, and what `keep` does is known
    // because `keep` is `long`. Holding any function of a shape is the other
    // thing and is written as one, with the shape on the `let`, and then the
    // promise is read off the shape rather than off a body.
    let named = long
    if count(words, named) != 2 {
        return 10
    }
    let which: fn(text) -> bool no.alloc = long
    if count(words, which) != 2 {
        return 11
    }
    which = short
    if count(words, which) != 1 {
        return 12
    }

    io.print("{count(points, far)} of {len(points)} are far, and {words[0]} sorts first")
    return 0
}
