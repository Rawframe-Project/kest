module examples.quests

import std.io

// The object graph the predecessor research kept measuring: characters that
// point at each other, cycles, deletion, and references that outlive what they
// named. A `store<T>` hands out a `ref<T>` and can delete what it holds.
// Nothing is notified of a deletion and nothing counts references, so a cycle
// is not a problem to have. What that costs is that every read is a lookup
// which can fail, and D014 is why that trade was taken.

struct Npc {
    name: text
    escort: ref<Npc>?
    quest: ref<Quest>?
}

struct Quest {
    title: text
    // A field whose type takes a type, with a field after it: the line ends
    // at the `>`, which is what a field's line does.
    giver: ref<Npc>
    reward: i32
}

fn nameOf(world: store<Npc>, who: ref<Npc>) -> text no.alloc {
    if let npc = get(world, who) {
        return npc.name
    }
    return "gone"
}

// A frame step over the graph: it reads, it follows references, and it removes
// what it finds dead. It allocates nothing, and the compiler proves it.
fn escortOf(world: store<Npc>, who: ref<Npc>) -> text no.alloc {
    if let npc = get(world, who) {
        if let escort = npc.escort {
            return nameOf(world, escort)
        }
        return "alone"
    }
    return "gone"
}

// The frame step the object graph exists for: it walks every live character,
// reads through the references it finds, writes some back and removes the
// rest. It promises to allocate nothing and the compiler proves it, because
// walking, reading, writing and removing all touch no heap. Only `add` does.
fn decay(world: store<Npc>, amount: i32) -> i32 no.alloc {
    let removed = 0
    for r in world {
        if let npc = get(world, r) {
            if npc.name == "guard" {
                set(world, r, Npc(npc.name, npc.escort, npc.quest))
            } else {
                remove(world, r)
                removed += amount
            }
        }
    }
    return removed
}

// The half of removing inside a walk that `decay` does not ask: removing
// something the cursor has not reached, and something it has already passed.
// A walk over a store looks for the next live slot rather than counting to a
// limit, so a slot that dies ahead of the cursor is looked at, found dead and
// stepped over, and one that dies behind it changes nothing because the walk
// does not go back. Four go in and three are seen. See D504.
fn cull(world: store<Npc>, ahead: ref<Npc>, behind: ref<Npc>) -> i32 no.alloc {
    let seen = 0
    for r in world {
        seen += 1
        if seen == 2 {
            remove(world, ahead)
            remove(world, behind)
        }
    }
    return seen
}

// Spawning during a frame, which is what a walk cannot do for itself: a store
// hands out the slot it last took back, so something added inside a walk lands
// where the walk has been as often as where it has not, and whether it is
// reached this frame or the next would be a coin. What is gathered is added
// after, which is one line more and the same every time.
fn reinforce(world: store<Npc>, after: text) -> i32 {
    let wanted: [text] = array()
    for r in world {
        if let npc = get(world, r) {
            if npc.name == after {
                push(wanted, "recruit")
            }
        }
    }
    for name in wanted {
        add(world, Npc(name, none, none))
    }
    return len(wanted)
}

fn main() -> i32 {
    let world: store<Npc> = store()
    let quests: store<Quest> = store()

    let guard = add(world, Npc("guard", none, none))
    let smith = add(world, Npc("smith", none, none))

    // A cycle. Neither owns the other, so neither has to be told about it.
    set(world, guard, Npc("guard", smith, none))
    set(world, smith, Npc("smith", guard, none))

    let errand = add(quests, Quest("fetch the anvil", smith, 20))
    set(world, guard, Npc("guard", smith, errand))

    if escortOf(world, guard) != "smith" {
        return 1
    }
    if escortOf(world, smith) != "guard" {
        return 2
    }

    // The smith dies. The guard still holds a reference to a smith that is
    // not there, and the quest still names them as its giver.
    if !remove(world, smith) {
        return 3
    }
    if escortOf(world, guard) != "gone" {
        return 4
    }
    if let q = get(quests, errand) {
        if nameOf(world, q.giver) != "gone" {
            return 5
        }
        if q.reward != 20 {
            return 7
        }
    } else {
        return 6
    }

    if len(world) != 1 {
        return 7
    }

    // A guard, a cook and a smith who is already gone.
    add(world, Npc("cook", none, none))
    add(world, Npc("herald", none, none))
    if decay(world, 1) != 2 {
        return 8
    }
    if len(world) != 1 {
        return 9
    }
    // The hard half of what a reference is worth: the smith's slot is free
    // now, so the next one added takes it back. A reference is a slot and a
    // generation, so the old one still reads nothing — a slot map without the
    // second number would answer with whoever moved in.
    let cooper = add(world, Npc("cooper", none, none))
    if get(world, smith) != none {
        return 15
    }
    if nameOf(world, smith) != "gone" {
        return 16
    }
    // And writes nothing and removes nothing, which is the same question
    // asked the other two ways.
    if set(world, smith, Npc("imposter", none, none)) {
        return 17
    }
    if remove(world, smith) {
        return 18
    }
    if let real = get(world, cooper) {
        if real.name != "cooper" {
            return 19
        }
    } else {
        return 20
    }
    if !remove(world, cooper) {
        return 21
    }

    // A store with nothing left in it walks nothing, and filling it again
    // hands back the same slots with new counts — so every reference from
    // before is still stale, which is the thing that would be easiest to lose
    // by making a walk cheaper.
    let empty: store<Npc> = store()
    let first = add(empty, Npc("first", none, none))
    if !remove(empty, first) {
        return 22
    }
    let after = add(empty, Npc("after", none, none))
    if get(empty, first) != none {
        return 23
    }
    if nameOf(empty, after) != "after" {
        return 24
    }

    // One guard is left, so one recruit is gathered and added after the walk.
    if reinforce(world, "guard") != 1 {
        return 10
    }
    if len(world) != 2 {
        return 11
    }
    // And the walk that gathers sees what the last one added, because it is a
    // walk of its own.
    if reinforce(world, "recruit") != 1 {
        return 12
    }
    if len(world) != 3 {
        return 13
    }

    // Four in slot order, and the walk removes the last and the first when
    // it is on the second. The one ahead is never reached and the one behind
    // was already counted, so three are seen and two are left.
    let four: store<Npc> = store()
    let one = add(four, Npc("one", none, none))
    add(four, Npc("two", none, none))
    add(four, Npc("three", none, none))
    let last = add(four, Npc("four", none, none))
    if cull(four, last, one) != 3 {
        return 25
    }
    if len(four) != 2 {
        return 26
    }

    io.print("{len(world)} left, and the guard's escort reads \"{escortOf(world, guard)}\"")
    return 0
}
