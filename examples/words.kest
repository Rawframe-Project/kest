module examples.words

import std.io
import std.sort
import std.text

// Text is its bytes. `len` counts them, `t[i]` reads one as a `u8`, and two
// pieces compare by them. There is no character type and nothing here pretends
// to decode one: `hız` is four bytes and the program that wants three
// characters has to say what it means by a character.

fn isVowel(byte: u8) -> bool no.alloc {
    if byte == 'a' || byte == 'e' || byte == 'i' {
        return true
    }
    return byte == 'o' || byte == 'u'
}

fn vowels(word: text) -> i32 no.alloc {
    let count = 0
    for i in 0..len(word) {
        if isVowel(word[i]) {
            count += 1
        }
    }
    return count
}

fn first(words: [text]) -> text? no.alloc {
    if len(words) == 0 {
        return none
    }
    let best = words[0]
    for word in words {
        if word < best {
            best = word
        }
    }
    return best
}

// A comparison of its own, which is the whole point of being told rather
// than deciding: this one is `no.alloc` and so the sort stays one too.
fn byVowels(a: text, b: text) -> bool no.alloc {
    return vowels(a) < vowels(b)
}

// What a completion box does: the words that begin with what has been typed,
// in whatever case it was typed. `lower` builds a piece of text, so neither
// this nor what it calls promises `no.alloc`, and saying so is the promise
// doing its job rather than the library being unfinished.
fn beginning(words: [text], typed: text) -> [text] {
    let found: [text] = array()
    let wanted = text.lower(typed)
    for word in words {
        if text.starts(text.lower(word), wanted) {
            push(found, word)
        }
    }
    return found
}

fn main() -> i32 {
    let words = ["smith", "guard", "cook", "herald"]

    if vowels("guard") != 2 {
        return 1
    }
    if len("hız") != 4 {
        return 2
    }

    // And what one of those bytes is worth. `t[i]` is a `u8`, so the second
    // byte of `ı` is 177 and not what the same eight bits mean read as a
    // number with a sign: every word in this file but that one is ASCII, and
    // ASCII is where the difference does not show.
    if i32("hız"[1]) != 196 || i32("hız"[2]) != 177 {
        return 5
    }

    // And the characters those bytes spell, which is the other half of the
    // same sentence: four bytes, three characters, and the second of them is
    // two bytes on its own. What a program means by a character is its to say
    // — this one means what UTF-8 does, which is what `std.text` counts.
    if text.chars("hız") != 3 {
        return 6
    }
    if let second = text.charAt("hız", 1) {
        if second != "ı" || len(second) != 2 {
            return 7
        }
    } else {
        return 8
    }
    if let past = text.charAt("hız", 3) {
        io.print("there is no fourth character and it reads {past}")
        return 9
    }

    if let earliest = first(words) {
        if earliest != "cook" {
            return 3
        }
    } else {
        return 4
    }

    // What comes first is a function value, so the sort does not have to
    // know and the caller does not have to write one.
    sort.by(words, sort.ascending)
    if words[0] != "cook" {
        return 5
    }
    if words[3] != "smith" {
        return 6
    }

    sort.by(words, sort.descending)
    if words[0] != "smith" {
        return 7
    }

    // The same order, over numbers. `sort.ascending` takes a type: one body,
    // and a copy per type it is asked for, so the library says "the usual
    // order" once and a program that sorts lengths writes nothing.
    let lengths: [i32] = array()
    for one in words {
        push(lengths, len(one))
    }
    sort.by(lengths, sort.ascending)
    if lengths[0] != 4 || lengths[3] != 6 {
        return 18
    }

    // Insertion keeps what was already in order, so the three words with two
    // vowels stay in the order the last sort left them.
    sort.by(words, byVowels)
    if words[0] != "smith" {
        return 8
    }
    if words[3] != "cook" {
        return 9
    }

    // The three questions a program asks about a line it did not write: is it
    // in there, does it start that way, does it end that way. Each is bytes
    // compared where it stands, so none of them copies anything.
    if !text.contains("herald", "era") {
        return 10
    }
    if text.contains("herald", "ear") {
        return 11
    }
    if !text.starts("herald", "her") || text.starts("herald", "old") {
        return 12
    }
    if !text.ends("herald", "ald") || text.ends("herald", "her") {
        return 13
    }
    // A suffix longer than what it is looked for in is not there, which is a
    // different answer from reading past the end.
    if text.ends("cook", "overcook") {
        return 14
    }

    if text.lower("HeRaLd") != "herald" {
        return 15
    }
    let typed = beginning(["smith", "guard", "cook", "herald"], "CO")
    if len(typed) != 1 || typed[0] != "cook" {
        return 16
    }
    if len(beginning(words, "")) != len(words) {
        return 17
    }

    io.print("by vowels: {text.join(words, " ")}")
    return 0
}
