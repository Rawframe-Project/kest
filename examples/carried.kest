module examples.carried

// Small bodies written where they are called rather than called, which is what
// the lowering does to one of a handful of instructions that can stop nothing
// (D1156). Every check here is a shape a carried body has to come out of right:
// arguments read where the caller keeps them, in whatever order it keeps them;
// the last of them read in place and the rest handed over; a body that writes
// what it was given; a body with more than one way out; one carried body's
// answer handed to another; and a struct handed over whole. `check.sh` runs
// this with the carrying and without it and holds the two to one answer.

struct Body {
    x: f32
    y: f32
    speed: f32
}

fn sum(a: i32, b: i32) -> i32 {
    return a + b
}

fn larger(a: i32, b: i32) -> i32 {
    return if a > b -> a else -> b
}

fn smaller(a: i32, b: i32) -> i32 {
    return if a < b -> a else -> b
}

fn bumped(n: i32) -> i32 {
    n += 1
    return n * 2
}

fn band(n: i32) -> i32 {
    if n < 10 {
        return 1
    }
    if n < 100 {
        return 2
    }
    return 3
}

fn ahead(b: Body, dt: f32) -> f32 {
    return b.x + b.speed * dt
}

// The arguments are the caller's first and third slots, which are not side by
// side, and the body reads its two parameters as one run of two.
fn apart(x: i32, y: i32, z: i32) -> i32 {
    return sum(x, z) * 1000 + y
}

// The first argument is worked out and the second is read where it is.
fn halfway(x: i32, y: i32) -> i32 {
    return sum(x + 1, y)
}

fn clamped(value: i32, low: i32, high: i32) -> i32 {
    return smaller(larger(value, low), high)
}

fn main() -> i32 no.alloc no.host deterministic {
    if apart(1, 20, 300) != 301020 {
        return 1
    }
    if halfway(4, 50) != 55 {
        return 2
    }
    let kept = 6
    if bumped(kept) != 14 || kept != 6 {
        return 3
    }
    if band(5) + band(50) * 10 + band(500) * 100 != 321 {
        return 4
    }
    if clamped(0 - 7, 0, 10) != 0 ||
            clamped(70, 0, 10) != 10 ||
            clamped(7, 0, 10) != 7 {
        return 5
    }
    let one = Body(1.0, 2.0, 4.0)
    if ahead(one, 0.5) != 3.0 {
        return 6
    }
    let total = 0
    for i in 0..10 {
        total += larger(i, 5) - smaller(i, 5)
    }
    if total != 25 {
        return 7
    }
    return 0
}
