module examples.game

import std.io

// `import examples.game.npc` reads `examples/game/npc.kest`. Where the package
// directories start is settled by this file having its own name taken off its
// path: it calls itself `examples.game` and lives at `examples/game.kest`, so
// the root is the directory above `examples`. Its names live under `npc`,
// which is the last part of what that file calls itself, so where a name came
// from is written at every use of it.

import examples.game.npc

fn main() -> i32 {
    // What a full one is, counted where the shape is declared. A constant
    // crosses out of the file it is in, which is what a name with a dot in it
    // is for here as much as `npc.Npc` is. See D665.
    // A run of a size another module counts. The count is a name with a dot
    // in it, the same as the type beside it. See D681.
    let party: [npc.Npc; npc.PARTY] = [
        npc.Npc("guard", npc.FULL),
        npc.Npc("scout", 20),
        npc.Npc("cook", 10)
    ]
    if len(party) != 3 || party[2].health != 10 {
        return 4
    }

    let guard: npc.Npc = npc.Npc("guard", npc.FULL)
    let hit = npc.hurt(guard, 12)

    if hit.health != npc.FULL - 12 {
        return 1
    }
    if !npc.alive(hit) {
        return 2
    }
    if npc.alive(npc.hurt(hit, 18)) {
        return 3
    }

    // A case of an enum the module beside this one declared, made here and
    // matched here. Making one is the half that did not work: a program could
    // be handed a `Mood` and read it and could not write one down. See D1062.
    if npc.mood(guard) != npc.Mood.Calm {
        return 4
    }
    if npc.mood(hit) != npc.Mood.Calm {
        return 5
    }
    let weak = npc.hurt(guard, npc.FULL - 1)
    if npc.mood(weak) != npc.Mood.Wary {
        return 6
    }
    // And one that carries something, which is the other half: the case is
    // called rather than named, and the name in front of it is still a type.
    let over = npc.Mood.Fleeing(2)
    let said = match over {
        Calm -> 0
        Wary -> 1
        Fleeing(from) -> from
    }
    if said != 2 {
        return 7
    }
    if npc.mood(npc.hurt(guard, npc.FULL)) != npc.Mood.Fleeing(0) {
        return 8
    }

    io.print("{hit.name} is at {hit.health}, and the module said so")
    return 0
}
