// Guards against a callee left standing on the slots of whoever called it.

module test.regress.callerslots

import std.io

// A remainder keeps `twice` a call.
fn twice(n: i32) -> i32 {
    return n % 1000 * 2
}

fn main() -> i32 {
    let total = 0
    total = twice(21)
    if total != 42 {
        io.print("a call read the slots of whoever called it")
        return 1
    }
    return total - 42
}
