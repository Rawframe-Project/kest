module examples.state

import std.io

// A thing that is one of several, which a struct with a number in it is not:
// every case carries what that case carries, and a `match` that leaves one out
// is refused rather than falling through.
//
// What a case carries is written by position, the same way what a struct is
// built with is. The names are given where they are used, in the arm that
// answered that case.

enum Door {
    Shut
    Locked(i32)
    Open(f32)
}

enum Turn {
    Push
    Unlock(i32)
    Pull
}

// What a case carries is a type like any other, and every case in this file
// carried a number until now. A struct is the one worth writing down: it is
// several slots rather than one, so the case that holds it is laid out around
// it — the tag at nought and the fields after it at their own alignment — and
// the arm that answers it names the whole struct rather than its parts. See
// D539.
struct Frame {
    at: i32
    wide: i32
}

enum Seen {
    Nothing
    Once(Frame)
    Twice(Frame, Frame)
}

// The arm binds a struct, reads its fields, and builds one to give back. What
// a binding holds is the copy the case was built with, so writing to it writes
// to the copy, which is what a struct is everywhere else in this language.
fn covered(seen: Seen) -> i32 no.alloc {
    return match seen {
        Nothing -> 0
        Once(one) -> one.wide
        Twice(first, second) -> second.at + second.wide - first.at
    }
}

// Two enums answered together is one `match` rather than one inside another.
// An arm answers a case for each subject, `else` in a position answers any
// case there, and the checker asks about every combination of the two: the
// nine here are covered by five arms and nothing is left out.
fn next(door: Door, move: Turn) -> Door no.alloc {
    return match door, move {
        Shut, Push -> Door.Open(1.0)
        Locked(key), Unlock(with) -> if with == key -> Door.Shut else -> door
        Open(width), Pull -> Door.Shut
        Open(width), else -> Door.Open(width)
        else -> door
    }
}

// Prose, which is not what `"{door}"` gives. A value's own text is the source
// that builds it, so `Door.Locked(7)` is what the value is; this is what a
// person is told. The two are different questions and both are asked.
//
// Every arm gives a value, so the match is one, and it is what the function
// returns rather than three places that each return.
fn describe(door: Door) -> text {
    return match door {
        Shut -> "shut"
        Locked(key) -> "locked with {key}"
        Open(width) -> "open {width} wide"
    }
}

fn main() -> i32 {
    // Two doors are one door when they are the same case carrying the same
    // things, which is what a value of an enum is and all it is (D043).
    let door = Door.Locked(7)
    if door != Door.Locked(7) {
        return 1
    }

    door = next(door, Turn.Unlock(3))
    if door != Door.Locked(7) {
        return 2
    }

    door = next(door, Turn.Unlock(7))
    if door != Door.Shut {
        return 3
    }

    door = next(door, Turn.Push)
    if door != Door.Open(1.0) {
        return 4
    }
    if door == Door.Open(2.0) {
        return 5
    }

    door = next(door, Turn.Pull)
    if door != Door.Shut {
        return 11
    }
    if describe(door) != "shut" {
        return 12
    }

    // The value's own text, which needs no function at all.
    if "{Door.Locked(7)}" != "Door.Locked(7)" {
        return 6
    }
    if "{Door.Open(1.0)}" != "Door.Open(1.0)" {
        return 7
    }
    if "{door}" != "Door.Shut" {
        return 8
    }

    // A case that carries a struct, which is what a case carrying a number
    // does not say: two slots go in and the arm that answers gets both.
    if covered(Seen.Nothing) != 0 {
        return 13
    }
    if covered(Seen.Once(Frame(2, 5))) != 5 {
        return 14
    }
    if covered(Seen.Twice(Frame(1, 3), Frame(4, 6))) != 9 {
        return 15
    }
    // And no text of one, which is the other half of the same rule: a value
    // writes itself when everything it carries can, and a struct cannot, so
    // `"{Seen.Once(...)}"` is refused with `K0324` where `"{Door.Locked(7)}"`
    // above is not. A case carrying a struct is a case a program takes apart
    // rather than prints.

    io.print("{door} is {describe(door)}")
    return 0
}
