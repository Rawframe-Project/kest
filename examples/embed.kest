module examples.embed

import std.io
import std.text

// A world the host keeps between frames. Nothing here writes to a global,
// because there are none: the store is made once, handed back, and handed in
// again every frame. What holds it is the host.

struct Npc {
    name: text
    health: i32
}

// What the host sends in. The byte layout of an enum is what a C tagged union
// is — a four byte tag at nought and the payload after it at its own
// alignment (D026) — so the host lends an array of them and nothing is copied
// at the boundary (D016). `embed.c` beside this declares the same shape in C.
enum Event {
    Idle
    Moved(f32, f32)
    Hit(i32)
    Named(text)
}

// A struct with a run inside it, which is what a host lends when its own type
// has an array in it. `[f32; 3]` is three where it stands (D064), so this is
// twelve bytes and the host's `struct { float at[3]; }` is the same twelve.
// A run on its own cannot be lent: a lend names a type and only a declared
// one has a name, which is what this struct is for.
struct Point {
    at: [f32; 3]
}

// A run of structs inside a struct, which is the other half of the same
// shape: `struct Cell { int32_t at; float weight; }` and three of them inside
// a row. What that comes to in bytes is what D120 got wrong, and what a host
// lending one would have read as the wrong thing.
struct Cell {
    at: i32
    weight: f32
}

struct Row {
    cells: [Cell; 3]
    tag: i32
}

// The heaviest cell in any row, and which row it was in. Nothing is copied:
// the rows are the host's bytes and the cells are inside them.
fn heaviest(rows: [Row]) -> i32 no.alloc {
    let best = 0
    let seen = 0.0
    for i in 0..len(rows) {
        for c in rows[i].cells {
            if c.weight > seen {
                seen = c.weight
                best = rows[i].tag * 10 + c.at
            }
        }
    }
    return best
}

// A value crossing rather than a borrowed one: the host writes the three
// floats into the frame and the program gets a `Point`. In a frame a value is
// one slot a scalar and a float is a double, whatever it is in memory, which
// is the other half of D016's two layouts.
fn lengthOf(p: Point) -> f32 no.alloc {
    let sum = 0.0
    for one in p.at {
        sum += one * one
    }
    return sum
}

// A run of a written length is laid out where it stands (D064), so building
// one inside a promise to touch no heap is allowed: these three floats are the
// struct's own twelve bytes, and the compiler emits no instruction that could
// allocate them. The kind that can grow is the kind that reaches the heap.
fn moved(p: Point, by: f32) -> Point no.alloc {
    return Point([p.at[0] + by, p.at[1] + by, p.at[2] + by])
}

// The same name for a second thing, which the language allows when they take
// different things. A host asking for `lengthOf` is told it is more than one
// function; it walks them and asks each what it takes.
fn lengthOf(x: f32, y: f32) -> f32 no.alloc {
    return x * x + y * y
}

// Two of them by value, which is where a host has to know that the second one
// starts after the first one's scalars. It asks rather than counts.
fn between(a: Point, b: Point) -> f32 no.alloc {
    let sum = 0.0
    for i in 0..3 {
        let apart = a.at[i] - b.at[i]
        sum += apart * apart
    }
    return sum
}

fn spread(points: [Point]) -> f32 no.alloc {
    let least = points[0].at[0]
    let most = points[0].at[0]
    for i in 0..len(points) {
        for one in points[i].at {
            if one < least {
                least = one
            }
            if one > most {
                most = one
            }
        }
    }
    return most - least
}

// Reading the host's memory as what it is. Nothing here allocates, so a whole
// batch crosses once and is walked in place.
fn onEvents(events: [Event]) -> i32 no.alloc {
    let damage = 0
    for e in events {
        damage += match e {
            Idle -> 0
            Moved(x, y) -> i32(x + y)
            Hit(amount) -> amount
            Named(what) -> len(what)
        }
    }
    return damage
}

// Writing through the view writes the host's memory, because there is only
// one copy of it. A tag written here is a tag the host reads.
fn silence(events: [Event], at: i32) -> bool no.alloc {
    if at < 0 || at >= len(events) {
        return false
    }
    events[at] = Event.Idle
    return true
}

// A host with a frame budget is a host that can be told the program has spent
// it, and nothing else here comes near the megabyte `embed.c` allows. This is
// the one that does: what stops it is the machine rather than the loop, and
// what the host gets is the message and a heap it can throw away.
fn hoard() -> i32 {
    let crowd: store<Npc> = store()
    let i = 0
    while i < 1000000 {
        add(crowd, Npc("one of many", 1))
        i += 1
    }
    return i
}

// The same ceiling reached the other way. An array grows by taking a bigger
// block and copying itself into it, and a store grows by taking four; they are
// different code and the same message, and until this was written only one of
// the two had ever been run into.
fn pile() -> i32 {
    let many: [Npc] = array()
    let i = 0
    while i < 1000000 {
        push(many, Npc("one of many", 1))
        i += 1
    }
    return i
}

// Room for that many and nothing in it, which is what `array(n, v)` and
// `clear` say together: `clear` empties an array and keeps what it took, so a
// fill and a clear are the reservation the language has no third spelling for.
fn ready(rounds: i32) -> i32 {
    let xs: [i32] = array(rounds, 0)
    clear(xs)
    let i = 0
    while i < rounds {
        push(xs, i)
        i += 1
    }
    return len(xs)
}

// The same thing without asking, which pays for every doubling on the way:
// eight, sixteen, thirty-two, and each one copies what came before it.
fn filling(rounds: i32) -> i32 {
    let xs: [i32] = array()
    let i = 0
    while i < rounds {
        push(xs, i)
        i += 1
    }
    return len(xs)
}

// Text a piece at a time, written the way that copies everything each time:
// `"{t}x"` asks for the length of both and makes a new one out of them, so a
// loop that does it is a copy of everything gathered so far, every time round.
fn glued(rounds: i32) -> i32 {
    let t = ""
    let i = 0
    while i < rounds {
        t = "{t}x"
        i += 1
    }
    return len(t)
}

// And the way the reference says to write it: gather the bytes, which grow
// where they stand, and pay for the text once at the end.
fn joined(rounds: i32) -> i32 {
    let out: [u8] = array()
    let i = 0
    while i < rounds {
        push(out, u8(120))
        i += 1
    }
    return len(text(out))
}

// The library written the same way, which nothing has ever measured. `repeat`
// and `join` gather bytes and pay once; written out of `slice` they would pass
// every check in this tree and be quadratic, and the only way to tell from
// outside is to ask what two sizes cost.
fn repeated(times: i32) -> i32 {
    return len(text.repeat("xyz", times))
}

fn joinedPieces(count: i32) -> i32 {
    let pieces: [text] = array()
    for i in 0..count {
        push(pieces, "xyz")
    }
    return len(text.join(pieces, ","))
}

// A run of the host's own bytes, made into a piece of text without the host
// having said what its bytes mean. Text ends at its first nought and a run of
// bytes does not, so this is where the two meet: what comes back is text if
// every byte the host lent is one text may hold, and a refusal if one is not.
fn readable(raw: [u8]) -> i32 {
    return len(text(raw))
}

// What the host says it is, asked for by the program rather than told to it.
// A host tells a program about itself the way it tells it anything: an
// `extern` like any other, declared here and bound there.
fn under() -> text {
    return Engine.name()
}

// A heap spent in one go rather than a bit at a time: everything else here
// that runs out is something growing, and a program asking for a million of
// something at once is the other way to want more than there is. What a host
// does about the two is not the same thing.
fn atOnce(many: i32) -> i32 {
    let all = array(many, 0)
    return len(all)
}

// A name the host says, counted here. What a host hands over is copied onto
// the heap before the program sees it, so this reads bytes the program owns
// rather than bytes a host may have moved on from.
fn named(what: text) -> i32 no.alloc {
    return len(what)
}

// The four things that would change how many there are. A lent run has a
// length that is the host's, so every one of them is refused where it is
// asked for rather than done to memory the program does not own.
fn grew(raw: [u8]) -> i32 {
    push(raw, 1)
    return len(raw)
}

fn popped(raw: [u8]) -> i32 {
    if let last = pop(raw) {
        return i32(last)
    }
    return 0
}

fn took(raw: [u8]) -> i32 {
    return i32(remove(raw, 0))
}

fn emptied(raw: [u8]) -> i32 {
    clear(raw)
    return len(raw)
}

// What a store does with the room of something dropped, which is hand it out
// again (D014). This empties and fills one as many times as the host asks, and
// a store that kept the room would want a megabyte long before it was done.
fn churn(rounds: i32) -> i32 {
    let world: store<Npc> = store()
    let i = 0
    while i < rounds {
        for r in world {
            remove(world, r)
        }
        add(world, Npc("one of many", 1))
        i += 1
    }
    return len(world)
}

// Room for sixteen before the first frame, because a store grows by doubling
// and the frame that pays for the next eight is a frame a host cannot move.
// Saying how many there will be moves it here, where nothing is being timed.
fn create() -> store<Npc> {
    return store(16)
}

fn spawn(world: store<Npc>, health: i32) -> i32 {
    add(world, Npc("npc", health))
    return len(world)
}

// A frame: everything alive loses a point and everything at nothing is gone.
// It walks, reads, writes and removes, and allocates nothing.
// The host decides what a step costs, and its answer may come back through
// this program: `embed.c` binds this and calls `rule` from inside it, which
// is a host calling in from inside a call it was called from (D072). The
// promise is the host's to keep, because an extern is judged by what it
// declares.
extern fn Engine.decide(health: i32) -> i32 no.alloc

// Text the other way: a host hands a piece of it over, and what comes back is
// the machine's own — a host that handed a pointer of its own would be
// promising to keep it as long as this program holds it. Which host is running
// this is the one thing a program cannot work out for itself.
extern fn Engine.name() -> text

fn rule(health: i32) -> i32 no.alloc {
    return if health > 3 -> 2 else -> 1
}

fn step(world: store<Npc>) -> i32 no.alloc {
    let alive = 0
    for r in world {
        if let npc = get(world, r) {
            let hit = Engine.decide(npc.health)
            if npc.health <= hit {
                remove(world, r)
            } else {
                set(world, r, Npc(npc.name, npc.health - hit))
                alive += 1
            }
        }
    }
    return alive
}

// Running this file on its own does one frame of what the host beside it does
// ten of.
fn main() -> i32 {
    let world = create()
    spawn(world, 3)

    // The same shapes without a host, so this file says what it does on its
    // own as well as under `embed.c`.
    // Built inside a promise, moved, and measured: the run went into the
    // struct where it stood, so nothing here was allocated.
    if lengthOf(moved(Point([1.0, 2.0, 2.0]), 0.0)) != 9.0 {
        return 6
    }
    if lengthOf(moved(Point([0.0, 0.0, 0.0]), 2.0)) != 12.0 {
        return 7
    }

    let points: [Point] = array()
    push(points, Point([1.0, 2.0, 3.0]))
    push(points, Point([0.0, 9.0, 4.0]))
    if spread(points) != 9.0 {
        return 4
    }

    let events: [Event] = array()
    push(events, Event.Hit(4))
    push(events, Event.Moved(1.5, 2.5))
    push(events, Event.Idle)
    push(events, Event.Named("trap"))
    if onEvents(events) != 12 {
        return 1
    }
    if !silence(events, 0) || events[0] != Event.Idle {
        return 2
    }
    if onEvents(events) != 8 {
        return 3
    }

    // Whatever is running this says so, and what it said is this machine's own
    // text: it is asked for twice and both answers are still there.
    let who = Engine.name()
    let again = Engine.name()
    if len(who) == 0 || who != again {
        return 5
    }

    io.print("one frame under {who}, {step(world)} left standing")
    return 0
}
