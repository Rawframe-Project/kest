module examples.boxes

import std.io

// A shape that takes types, written and used in one file. The library has one
// and no example did, so every rule about a copy — that it is made from what
// it is built with, found again after that, and told apart from a copy over
// other types — was held by nothing that runs. See D501.

// One type parameter, used at two types. Nothing is boxed and nothing carries
// a tag: the copy over `i32` was compiled knowing it holds four bytes.
struct Box<T> {
    it: T
}

// A shape may hold a copy of itself over another type, because a copy is a
// struct like any other by the time anything sees it.
struct Pair<A, B> {
    first: A
    second: B
}

// An enum takes types the same way, and this is the shape a fallible answer
// has: the thing, or why not. `T?` says whether there is one and this says
// what happened, which is the whole difference between them. A case that
// carries none of the names -- `Trouble` here -- says nothing about which
// copy it is, so which copy comes from where the value is going. See D1048.
enum Answer<T> {
    Held(T)
    Trouble(text)
}

fn halved(n: i32) -> Answer<i32> no.alloc no.host {
    if n % 2 != 0 {
        return Answer.Trouble("odd")
    }
    return Answer.Held(n / 2)
}

// And the same shape over another type, which is another copy: what a case
// carries is this copy's and what it is called is the shape's.
fn firstWord(words: [text]) -> Answer<text> no.alloc no.host {
    for one in words {
        return Answer.Held(one)
    }
    return Answer.Trouble("none")
}

// A body that takes types and gives one back, which is where the two halves
// of this meet: the copy of the enum is made from the copy of the function.
fn orElse<T>(answer: Answer<T>, instead: T) -> T no.alloc no.host {
    return match answer {
        Held(one) -> one
        Trouble(why) -> instead
    }
}

// A function that takes types and gives back a copy of a shape that takes
// them. Which copy comes from what was passed, at the call and nowhere else.
fn wrapped<T>(a: T) -> Box<T> {
    return Box(a)
}

fn opened<T>(b: Box<T>) -> T {
    return b.it
}

// A copy's own types are what its body is checked against, so the promise
// holds here for every set of them.
fn firstOf<T>(items: [T], fallback: T) -> T no.alloc {
    for one in items {
        return one
    }
    return fallback
}

// One that takes types, handed over rather than called: which copy it is comes
// from the shape it is going into.
// A type name inside a run of a written length. `[T; 3]` says what `T` is as
// plainly as `[T]` does, and until D546 it did not: the walk that works a name
// out from what was passed had every other shape that carries one and not this,
// so a generic over a fixed run was a function nothing could call. What it said
// was that `T` could not be told from what was passed, about an argument it was
// written in.
fn middleOf<T>(run: [T; 3]) -> T no.alloc {
    return run[1]
}

// The rest of the shapes a type name can hide in, which is what D546 was found
// by walking: a store hands out a `T`, a reference names one, an optional holds
// one or nothing, and a shape that takes a type can be what an array is of. Any
// one of them missing from that walk is a function nothing can call, and
// nothing here held them.
// Each of these mentions its type name in one place and nowhere else, which is
// what makes it a question: a second parameter written `T` would say what `T`
// is on its own and the shape would never be looked into.
fn countIn<T>(s: store<T>) -> i32 no.alloc {
    return len(s)
}

fn stillThere<T>(s: store<T>, r: ref<T>) -> bool no.alloc {
    return get(s, r) != none
}

fn isThere<T>(o: T?) -> bool no.alloc {
    return o != none
}

fn howManyBoxes<T>(boxed: [Box<T>]) -> i32 no.alloc {
    return len(boxed)
}

fn ascending<T: orders>(a: T, b: T) -> bool no.alloc {
    return a < b
}

fn main() -> i32 {
    let whole: Box<i32> = Box(4)
    let part: Box<f32> = Box(0.5)
    if whole.it != 4 {
        return 1
    }
    if part.it != 0.5 {
        return 2
    }

    // A copy is found again after the first time a set of types is written,
    // so this is the same type as the one above and goes where it goes.
    let same: Box<i32> = whole
    if same.it != 4 {
        return 3
    }

    // Made from what it is built with rather than from anything written at
    // the call: `Pair(1, "a")` is a `Pair<i32, text>`.
    let named: Pair<i32, text> = Pair(1, "a")
    if named.first != 1 || len(named.second) != 1 {
        return 4
    }

    // A copy of a shape held inside a copy of the same shape.
    let nested: Box<Box<i32>> = Box(whole)
    if nested.it.it != 4 {
        return 5
    }

    if opened(wrapped(9)) != 9 {
        return 6
    }
    if len(opened(wrapped("herald"))) != 6 {
        return 7
    }

    // A copy over a shape that takes types, which is two copies asked for by
    // one call.
    let boxes: [Box<i32>] = array()
    push(boxes, Box(11))
    if firstOf(boxes, Box(0)).it != 11 {
        return 8
    }

    let words: [text] = array()
    // A store, a reference, an optional and an array of a shape that takes a
    // type, each of them saying what `T` is from where it sits.
    let held: store<Pair<i32, text>> = store()
    let where_it_is = add(held, Pair(3, "three"))
    if countIn(held) != 1 {
        return 27
    }
    if !stillThere(held, where_it_is) {
        return 28
    }
    remove(held, where_it_is)
    if stillThere(held, where_it_is) {
        return 29
    }
    let maybe: text? = "here"
    if !isThere(maybe) {
        return 30
    }
    let nothing: text? = none
    if isThere(nothing) {
        return 31
    }
    if howManyBoxes([Box(41), Box(42)]) != 2 {
        return 32
    }

    // The same body at two types, out of a run laid out where it stands.
    let threeNumbers: [i32; 3] = [4, 5, 6]
    let threeWords: [text; 3] = ["a", "bb", "ccc"]
    if middleOf(threeNumbers) != 5 {
        return 25
    }
    if middleOf(threeWords) != "bb" {
        return 26
    }

    if len(firstOf(words, "none")) != 4 {
        return 9
    }

    // The shape says which copy, and there is one that fits it.
    let before: fn(text, text) -> bool no.alloc = ascending
    if !before("a", "b") {
        return 10
    }
    let smaller: fn(i32, i32) -> bool no.alloc = ascending
    if smaller(2, 1) {
        return 11
    }

    // An answer that is the thing or why not, over two types and through a
    // body that takes one.
    if orElse(halved(8), 0 - 1) != 4 {
        return 40
    }
    if orElse(halved(7), 0 - 1) != 0 - 1 {
        return 41
    }
    let said: [text] = array()
    push(said, "alpha")
    if orElse(firstWord(said), "none") != "alpha" {
        return 42
    }
    if orElse(firstWord(words), "none") != "none" {
        return 43
    }
    // Two of one copy are equal when they are the same case carrying the
    // same thing, the way any other value laid out flat is.
    if halved(8) != halved(8) || halved(8) == halved(7) {
        return 44
    }
    match halved(6) {
        Held(one) {
            if one != 3 {
                return 45
            }
        }
        Trouble(why) {
            return 46
        }
    }

    io.print("one body, and a copy for every set of types it was called with")
    return 0
}
